{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/skills/two-model-sdd-pipeline/scripts/codex-policy\"",
            "command_windows": "py -3 \"${PLUGIN_ROOT}\\skills\\two-model-sdd-pipeline\\scripts\\codex-policy\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/skills/two-model-sdd-pipeline/scripts/codex-policy\"",
            "command_windows": "py -3 \"${PLUGIN_ROOT}\\skills\\two-model-sdd-pipeline\\scripts\\codex-policy\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
