#!/usr/bin/env bash
# Deterministic per-task driver (Script CEO thin orchestrator, ADR-0001):
# runs the route-next action for a task and hands the outcome back to the
# caller (run-pipeline, or the interactive session on manual resume).
#
# The per-task flow is autonomous once B hands over a brief:
#   route-next -> execute the action -> re-route -> print OUTCOME for B
# The gates own their dispatch calls: red-gate dispatches C on RED success
# (Item 4) then chains into coder-gate, which owns every retry round; the
# green path commits and dispatches D. The orchestrator is the sequencer -
# it never judges, it executes emitted actions.
#
# Usage: orchestrator WS TASK [TOTAL_TASKS]
#   WS          - pipeline workspace (ledger.jsonl, plan.json)
#   TASK        - task number to drive
#   TOTAL_TASKS - optional; total task count (for NEXT vs FINAL_REVIEW)
#
# Env:
#   RED_GATE_BIN   override red-gate script (default: auto-selected from
#                  the ledger's `gate.lang` - flutter-app-pipeline's for
#                  lang=flutter, this skill's generic one otherwise)
#   CODER_GATE_BIN override coder-gate (default: this skill's coder-gate).
#                  CODER_GATE is accepted as a legacy alias; the runner and
#                  this script now agree on the single CODER_GATE_BIN name.
#
# Toolchain detection is a one-time, pre-loop step: `resolve-toolchain`
# writes the `gate` ledger entry (lang, test_cmd, analyze_cmd) before task 1
# ever routes. This orchestrator only reads that entry - it never asks.
#
# Exit codes: 0 = handed control back (CORRECTIVE/ARBITRATE/REVIEW/NEXT/
#             FINAL_REVIEW) after executing the script-owned action;
#             1 = brief-scaffold failed / inconsistent state / unknown action;
#             2 = usage.
set -euo pipefail

export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: orchestrator WS TASK [TOTAL_TASKS]" >&2
  exit 2
fi

ws=$1
task=$2
total=${3:-}
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PIPELINE_BACKEND=${PIPELINE_BACKEND:-}
if [ -z "$PIPELINE_BACKEND" ]; then
  if [ -f "$ws/plan.json" ] && python3 -c 'import json,sys; raise SystemExit(0 if "spec_doc" in json.load(open(sys.argv[1],encoding="utf-8")) else 1)' "$ws/plan.json"; then
    echo "ORCHESTRATOR: canonical plan requires explicit PIPELINE_BACKEND" >&2; exit 2
  fi
  PIPELINE_BACKEND=opencode
fi
case "$PIPELINE_BACKEND" in codex|opencode) ;; *) echo "ORCHESTRATOR: unsupported backend $PIPELINE_BACKEND" >&2; exit 2 ;; esac
export PIPELINE_BACKEND

[ -f "$ws/ledger.jsonl" ] || { echo "ORCHESTRATOR: no ledger at $ws" >&2; exit 2; }

route() {
  local args=("$SCRIPT_DIR/route-next" "$ws" "$task")
  [ -n "$total" ] && args+=("$total")
  "${args[@]}"
}

action=$(route)

case "$action" in
  BRIEF*)
    # Script-owned, so the orchestrator executes it (not the caller): scaffold
    # the brief mechanically from the plan, ledger that it is ready, then
    # re-route. run-pipeline owns only the LLM branches, so this is the one
    # place brief scaffolding happens.
    n=${action#BRIEF }
    n=${n%% *}
    if "$SCRIPT_DIR/brief-scaffold" "$ws" "$n"; then
      "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" brief_ready "$n" \
        "brief scaffolded from plan" >/dev/null 2>&1 || true
      action=$(route)
    else
      echo "ORCHESTRATOR: brief-scaffold failed for task $n" >&2
      exit 1
    fi
    echo "OUTCOME: $action"
    exit 0
    ;;
  CORRECTIVE*|ARBITRATE*|NEXT*|FINAL_REVIEW*)
    # These hand control back: the caller arranges the corrective / arbitration.
    # The orchestrator just reports the outcome.
    echo "OUTCOME: $action"
    exit 0
    ;;
  RED*)
    # Execute the action: red-gate dispatches the operador on the
    # scaffolded brief, then chains into coder-gate which owns the retry
    # loop. Then re-route and report.
    #
    # Which red-gate runs is itself a script decision, not an LLM one: resolve
    # the task's exact toolchain ID, read its declared language, and pick the
    # Flutter shim only for lang=flutter. The generic gate uses the same task
    # identity when it looks up the structured command descriptor.
    if [ -z "${RED_GATE_BIN:-}" ]; then
      gate_lang=$("$SCRIPT_DIR/task-lang" "$ws" "$task")
      if [ "$gate_lang" = "flutter" ]; then
        RED_GATE_BIN="${FLUTTER_RED_GATE_BIN:-$SCRIPT_DIR/../../flutter-app-pipeline/scripts/red-gate}"
      else
        RED_GATE_BIN="$SCRIPT_DIR/red-gate"
      fi
    fi
    # rc 0 = green (the retry loop is inside), rc 2 = TEST_DEFECT (escalated,
    # route emits ARBITRATE). Any other rc is an interrupted/unexpected
    # dispatch (e.g. provider timeout rc=124): propagate it so run-pipeline
    # reports BLOCKED instead of re-routing over a silent failure (5134b05).
    rc=0
    "$RED_GATE_BIN" "$ws" "$task" || rc=$?
    case "$rc" in
      0|2) ;;
      *)
        echo "ORCHESTRATOR: red-gate exit $rc on task $task - interrupted or unexpected; not re-routing" >&2
        exit "$rc"
        ;;
    esac
    action=$(route)
    echo "OUTCOME: $action"
    exit 0
    ;;
  CODER*)
    # Normal flow never lands here: red-gate now chains straight into
    # coder-gate after round 1, which owns every retry until PASS or
    # TEST_DEFECT (the loop is unbounded - it never gives up for lack of
    # budget). Reaching CODER here means a resume after an interrupted
    # session (round N's dispatch happened, its gate check did not) - drive
    # it the same way red-gate would have.
    CODER_GATE_BIN="${CODER_GATE_BIN:-${CODER_GATE:-$SCRIPT_DIR/coder-gate}}"
    rc=0
    "$CODER_GATE_BIN" "$ws" "$task" || rc=$?
    case "$rc" in
      0|2) ;;
      *)
        echo "ORCHESTRATOR: coder-gate exit $rc on task $task - interrupted or unexpected; not re-routing" >&2
        exit "$rc"
        ;;
    esac
    action=$(route)
    echo "OUTCOME: $action"
    exit 0
    ;;
  REVIEW*)
    # A commit exists; the revisor dispatch is owned by whichever gate
    # committed (green-gate for Flutter, coder-gate's own commit step for
    # the generic engine) and already fired. The orchestrator just reports
    # the outcome - re-dispatching a second reviewer on the same diff would
    # duplicate the review seat, exactly what task_reviewer's "no
    # worker-spawned reviewer" rule exists to prevent.
    state="$ws/task-$task-review-state.json"
    if [ "$PIPELINE_BACKEND" = "codex" ]; then
      [ -n "${CODEX_RUNTIME_JSON:-}" ] || { echo "ORCHESTRATOR: CODEX_RUNTIME_JSON required for Codex review" >&2; exit 5; }
      [ -f "$state" ] || { echo "ORCHESTRATOR: candidate-bound review state missing for task $task" >&2; exit 1; }
      candidate=$(git rev-parse HEAD)
      read -r saved_base saved_candidate < <(python3 - "$state" <<'PY'
import json,sys
try:
 d=json.load(open(sys.argv[1],encoding="utf-8")); identity=d.get("identity", {})
 print(d.get("base_commit", identity.get("base_commit", "")),d.get("candidate_commit", identity.get("candidate_commit", "")))
except Exception: print("", "")
PY
)
      saved_base=${saved_base%$'\r'}
      saved_candidate=${saved_candidate%$'\r'}
      [ -n "$saved_base" ] && [ "$candidate" = "$saved_candidate" ] || { echo "ORCHESTRATOR: candidate/base binding changed; refusing Codex review" >&2; exit 1; }
      pkg="$ws/task-$task-review-package.diff"
      "$SCRIPT_DIR/review-package" "$ws" "$saved_base" "$candidate" "$pkg" "$task"
      python3 - "$state" "$ws/plan.json" "$ws/task-$task-brief.md" "$pkg" <<'PY'
import hashlib,json,os,sys,tempfile
state,plan,brief,package=sys.argv[1:]
def digest(path): return hashlib.sha256(open(path,"rb").read()).hexdigest()
d=json.load(open(state,encoding="utf-8"))
identity=d.get("identity", {})
d.setdefault("base_commit", identity.get("base_commit", ""))
d.setdefault("candidate_commit", identity.get("candidate_commit", ""))
plan_hash=digest(plan)
d["plan_hash"]=plan_hash
d["context_hash"]=hashlib.sha256((plan_hash+digest(brief)+digest(package)).encode()).hexdigest()
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(state),prefix="review-state-")
with os.fdopen(fd,"w",encoding="utf-8") as f: json.dump(d,f); f.write("\n")
os.replace(tmp,state)
PY
      request="$ws/task-$task-review-request.json"
      result="$ws/task-$task-review-result.json"
      "$SCRIPT_DIR/review-dispatch" --build-request "$ws" "$task" "$request" || { echo "ORCHESTRATOR: cannot construct strict Codex review request" >&2; exit 4; }
      if ! "$SCRIPT_DIR/review-dispatch" --request "$request" --runtime "$CODEX_RUNTIME_JSON" --output "$result"; then
        echo "ORCHESTRATOR: normalized Codex review remains pending for candidate $candidate" >&2
        exit 5
      fi
      "$SCRIPT_DIR/parse-review" --backend codex "$result" "$request" "$ws/task-$task-review.json" \
        || { echo "ORCHESTRATOR: normalized Codex review result is invalid" >&2; exit 4; }
      verdict=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["verdict"])' "$ws/task-$task-review.json")
      findings=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1],encoding="utf-8"))["findings"]))' "$ws/task-$task-review.json")
      "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" review_outcome "$task" "$verdict" "findings=$findings"
      if [ "$verdict" = "APPROVED" ]; then
        parked=$(python3 - "$ws/task-$task-review.json" <<'PY'
import json,sys
v=json.load(open(sys.argv[1],encoding="utf-8")); minors=v.get("minors",[])
rank={"Minor":1,"Important":2,"Critical":3}; best=max((rank.get(m.get("severity"),0) for m in minors if isinstance(m,dict)),default=0)
notes="; ".join(str(m.get("note") or m.get("issue") or "") for m in minors if isinstance(m,dict))
print((notes or "__NONE__")+"\t"+{0:"none",1:"Minor",2:"Important",3:"Critical"}[best])
PY
)
        IFS=$'\t' read -r notes severity <<< "$parked"
        if [ "$notes" != "__NONE__" ]; then
          "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" task_complete "$task" APPROVED "PARKED=$notes" "PARKED_SEVERITY=$severity"
        else
          "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" task_complete "$task" APPROVED "PARKED_SEVERITY=$severity"
        fi
        # Resolve any parent in a corrective family exactly once.
        python3 - "$ws/plan.json" "$task" <<'PY' | while read -r parent; do
import json,sys
plan=json.load(open(sys.argv[1],encoding="utf-8")); tasks={str(t["id"]):t for t in plan["tasks"]}; child=tasks.get(sys.argv[2]); seen=set()
while child and child.get("corrects") is not None:
 p=str(child["corrects"])
 if p in seen or p not in tasks: break
 seen.add(p); print(p); child=tasks[p]
PY
          if ! grep -E '"type": *"task_complete"' "$ws/ledger.jsonl" | grep -qE "\"task\": *\"$parent\""; then
            "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" review_outcome "$parent" APPROVED "superseded_by=corrective-$task"
            "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" task_complete "$parent" APPROVED "RECONCILED_BY=$task"
          fi
        done
      fi
      rm -f "$state"
      action=$(route)
      echo "OUTCOME: $action"
      exit 0
    fi
    if [ -f "$state" ]; then
      candidate=$(git rev-parse HEAD)
      read -r saved_base saved_candidate < <(python3 - "$state" <<'PY'
import json,sys
try:
 d=json.load(open(sys.argv[1],encoding="utf-8")); print(d.get("base_commit", ""),d.get("candidate_commit", ""))
except Exception: print("", "")
PY
)
      [ "$candidate" = "$saved_candidate" ] || { echo "ORCHESTRATOR: pending review candidate changed; refusing retry" >&2; exit 1; }
      pkg="$ws/task-$task-review-package.diff"
      [ -n "$saved_base" ] || { echo "ORCHESTRATOR: pending review base missing" >&2; exit 1; }
      "$SCRIPT_DIR/review-package" "$ws" "$saved_base" "$candidate" "$pkg" "$task"
      [ -s "$pkg" ] || { echo "ORCHESTRATOR: pending review package could not be refreshed" >&2; exit 1; }
      python3 - "$state" "$ws/plan.json" "$ws/task-$task-brief.md" "$pkg" <<'PY'
import hashlib,json,os,sys,tempfile
state,plan,brief,package=sys.argv[1:]
def digest(path):
 try: return hashlib.sha256(open(path,"rb").read()).hexdigest()
 except OSError: return None
d=json.load(open(state,encoding="utf-8"))
d["plan_hash"]=digest(plan)
d["context_hash"]=hashlib.sha256("".join(digest(p) or "" for p in (plan,brief,package)).encode()).hexdigest()
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(state),prefix="review-state-")
with os.fdopen(fd,"w",encoding="utf-8") as f: json.dump(d,f); f.write("\n")
os.replace(tmp,state)
PY
      DISPATCH_RETRY_BIN="${DISPATCH_RETRY_BIN:-$SCRIPT_DIR/dispatch-retry}"
      if "$DISPATCH_RETRY_BIN" --agent two-model-reviewer --task "$task" \
        --prompt-file "$pkg" --log "$ws/task-$task-reviewer.log"; then
        "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" review_dispatched "$task" "review resumed for candidate $candidate" candidate="$candidate"
        rm -f "$state"
      else
        echo "ORCHESTRATOR: reviewer dispatch remains pending for candidate $candidate" >&2
        exit 5
      fi
    fi
    echo "OUTCOME: $action"
    exit 0
    ;;
  *)
    echo "ORCHESTRATOR: unexpected action: $action" >&2
    exit 1
    ;;
esac
