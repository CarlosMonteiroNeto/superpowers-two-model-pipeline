#!/usr/bin/env bash
# Script-owned integration gate: fold a wave's task branches into the
# integration HEAD and gate the result. The verdict is an exit code, never LLM
# judgment.
#
# Strategy (S2). A wave of >=2 approved tasks is merged FIRST and gated ONCE:
# merging all and running the full suite a single time is the common case, where
# the per-task suites were paying for a coupling that usually is not there. If
# the batch gate (or a merge) fails, the batch is reset and the per-merge loop
# runs - that loop IS the bisect: it merges and gates one task at a time, so a
# single bad task can never poison the wave and the remaining tasks still
# integrate. A wave of one approved task takes the per-merge path directly,
# which also carries the ADR-0013 provably-equivalent suite skip.
#
# Usage: integrate WORKSPACE TASK [TASK...]
#   WORKSPACE  the integration pipeline workspace (holds ledger.jsonl + plan)
#   TASK       one or more task ids (merged in ascending numeric order)
#
# Exit codes: 0 = every task integrated, 1 = at least one integration_failed,
#             2 = usage.
#
# Resolves each task's toolchain ID from the plan and runs every selected
# descriptor. Exact structured toolchains run through the generic descriptor
# runner, including Flutter; the Flutter adapter is retained for the
# unstructured legacy gate. The batch gate deliberately runs
# WITHOUT the scope gate: each task's coder-gate already proved its own scope in
# its worktree, and a single keep-discard pass could only judge one task's
# `touches`.
#
# Entry guard (F1): integration refuses to run from a dirty checkout. A staged
# change, an unstaged tracked edit, or a non-ignored untracked file could be
# destroyed by the batch fallback's `git reset --hard`; all block with exit 1
# and an `integration_failed` dirty-worktree reason per requested task, leaving
# HEAD, the index, working-tree bytes, branches, and worktrees untouched. A
# failing `git status` blocks too (fail closed). Ignored pipeline workspaces do
# not count as dirt.
#
# A task is integrated only when its worktree shard proves the task was
# approved: the shard must contain a `task_complete`. coder-gate commits BEFORE
# the revisor runs, so a post-commit failure leaves a committed-but-unapproved
# branch; an un-approved shard is ledgered `integration_failed N not approved`
# and skipped - never merged, never released (the worktree keeps the only debug
# copy).
#
# Resource profile: dispatch none; git merges + commits on the integration
# branch; ledger writes (integration global + per-task shard merge); subprocess:
# one full gate suite per wave (batch) or one per task (fallback), plus
# ledger-merge and worktree-release per task.
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: integrate WORKSPACE TASK [TASK...]" >&2
  exit 2
fi

script_dir=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
ws=$1
ledger="$ws/ledger.jsonl"
if [ "${PIPELINE_LOCK_HELD:-}" != "1" ]; then
  branch=$(git branch --show-current)
  git_common=$(git rev-parse --git-common-dir)
  repo_id=$(python3 - "$root" "$git_common" <<'PY'
import hashlib, os, sys
root, common = sys.argv[1:]
if not os.path.isabs(common): common = os.path.join(root, common)
common = os.path.realpath(common)
if os.name == "nt": common = common.casefold()
print(hashlib.sha256(common.encode()).hexdigest()[:20])
PY
)
  lock_dir=$(python3 - "$root" "$git_common" <<'PY'
import os, sys
root, common=sys.argv[1:]
if not os.path.isabs(common): common=os.path.join(root,common)
print(os.path.join(os.path.realpath(common),"pipeline-locks"))
PY
)
  lock_run="${PIPELINE_RUN_ID:-legacy}"
  if [ -z "${PIPELINE_RUN_ID:-}" ] && [ -f "$ws/.pipeline-identity.json" ]; then
    lock_run=$(python3 - "$ws/.pipeline-identity.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1],encoding="utf-8")).get("run_id","legacy"))
PY
)
  fi
  mkdir -p "$lock_dir"
  lock="$lock_dir/$(printf '%s' "$branch" | sha256sum | cut -c1-20).lock"
  owner=$(REPO_ID="$repo_id" BRANCH="$branch" RUN_ID="$lock_run" python3 -c 'import json,os; print(json.dumps({"repository_id":os.environ["REPO_ID"],"branch":os.environ["BRANCH"],"run_id":os.environ["RUN_ID"]},separators=(",",":")))')
  REPO_ID="$repo_id" BRANCH="$branch" python3 "$script_dir/state_lock.py" --run "$lock" "$owner" -- bash "$0" "$@"
  exit $?
fi
shift

if ! python3 - "$ledger" <<'PY'
import json, os, sys
path=sys.argv[1]
if not os.path.isfile(path): raise SystemExit("missing ledger")
for number, line in enumerate(open(path,encoding="utf-8"),1):
    if not line.strip(): continue
    try: value=json.loads(line)
    except ValueError: raise SystemExit("corrupt ledger line {}".format(number))
    if not isinstance(value,dict) or not all(k in value for k in ("type","task","summary")):
        raise SystemExit("invalid ledger record at line {}".format(number))
PY
then echo "INTEGRATE: corrupt or missing ledger; refusing to change Git state" >&2; exit 1; fi

RUN_GATES_BIN="${RUN_GATES_BIN:-$script_dir/run-gates}"
GREEN_GATE_BIN="${GREEN_GATE_BIN:-$script_dir/../../flutter-app-pipeline/scripts/green-gate}"

LEGACY_LANG=$(python3 "$script_dir/toolchain_gate.py" legacy-lang "$ws" 2>/dev/null || true)

slug="${WS_SLUG:-$(basename "$ws")}"

# F1 entry guard (recovery hardening): refuse to integrate from a dirty
# checkout. Merging, and especially the batch fallback's `git reset --hard`,
# could otherwise destroy unrelated tracked or untracked work. Staged changes,
# unstaged tracked edits, and non-ignored untracked files all block; ignored
# pipeline workspaces do not. Fail closed: a status command failure also
# blocks, so empty output is never mistaken for a clean checkout.
dirty_rc=0
dirty=$(git status --porcelain 2>/dev/null) || dirty_rc=$?
if [ "$dirty_rc" -ne 0 ]; then
  echo "INTEGRATE: cannot verify a clean integration checkout (git status rc=$dirty_rc) - refusing to integrate" >&2
  for n in "$@"; do
    "$script_dir/ledger-append" "$ledger" integration_failed "$n" \
      "dirty worktree (status unavailable, rc=$dirty_rc)"
  done
  exit 1
fi
if [ -n "$dirty" ]; then
  echo "INTEGRATE: refusing to integrate from a dirty checkout:" >&2
  printf '%s\n' "$dirty" >&2
  for n in "$@"; do
    "$script_dir/ledger-append" "$ledger" integration_failed "$n" \
      "dirty worktree"
  done
  exit 1
fi

owner_of() { printf '%s/ownership/task-%s.json' "$ws" "$1"; }
worktree_of() {
  if [ -f "$(owner_of "$1")" ]; then
    python3 - "$(owner_of "$1")" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["worktree"])
PY
  else printf '%s/.superpowers/two-model/worktrees/task-%s' "$root" "$1"; fi
}
branch_of() {
  if [ -f "$(owner_of "$1")" ]; then
    python3 - "$(owner_of "$1")" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["branch"])
PY
  else printf 'task/%s' "$1"; fi
}
shard_of() { printf '%s' "$(worktree_of "$1")/.superpowers/two-model/$slug/ledger.jsonl"; }

ownership_valid() {
  local n=$1 owner wt branch top current dirty
  owner=$(owner_of "$n")
  if [ ! -f "$owner" ]; then
    [ ! -f "$ws/.pipeline-identity.json" ] && return 0
    echo "INTEGRATE: task $n has no persisted ownership record" >&2
    return 1
  fi
  wt=$(worktree_of "$n"); branch=$(branch_of "$n")
  if ! python3 - "$owner" "$root" "$ws" "$n" "$wt" "$branch" "$script_dir" <<'PY'
import importlib.util, json, os, re, sys
path, root, workspace, task, wt, branch, scripts = sys.argv[1:]
o=json.load(open(path,encoding="utf-8"))
same=lambda a,b: os.path.normcase(os.path.realpath(a)) == os.path.normcase(os.path.realpath(b))
if (not same(o.get("repository_root",""),root) or not same(o.get("workspace",""),workspace)
    or not same(o.get("worktree",""),wt) or str(o.get("task_id")) != task
    or o.get("branch") != branch or not o.get("run_id")):
    raise SystemExit(1)
identity_path=os.path.join(workspace, ".pipeline-identity.json")
if os.path.isfile(identity_path):
    record=json.load(open(identity_path,encoding="utf-8"))
    spec=importlib.util.spec_from_file_location("run_identity", os.path.join(scripts,"run_identity.py"))
    module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    expected=module.create_identity(record["repository_root"],record["plan_path"],record["run_id"])
    if any(expected[k] != record.get(k) for k in ("repository_id","identity","workspace_key","run_id","plan_path")):
        raise SystemExit(1)
    safe_run=re.sub(r"[^A-Za-z0-9._-]+", "-", expected["run_id"])
    expected_wt=os.path.join(expected["repository_root"],".superpowers","two-model","worktrees",
                             expected["workspace_key"],safe_run,"task-"+task)
    expected_branch="codex/pipeline/{}/{}/task-{}".format(expected["workspace_key"],safe_run,task)
    if (not same(record.get("repository_root",""),root)
        or o.get("run_id") != expected["run_id"]
        or not same(o.get("worktree",""),expected_wt)
        or o.get("branch") != expected_branch):
        raise SystemExit(1)
PY
  then echo "INTEGRATE: task $n ownership mismatch; refusing integration" >&2; return 1; fi
  top=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || { echo "INTEGRATE: task $n worktree is missing" >&2; return 1; }
  current=$(git -C "$wt" branch --show-current 2>/dev/null) || return 1
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null) || return 1
  if [ "$current" != "$branch" ] || [ -n "$dirty" ]; then
    echo "INTEGRATE: task $n worktree branch/state does not match persisted ownership" >&2
    return 1
  fi
  return 0
}

approved() { grep -qE '"type": *"task_complete"' "$(shard_of "$1")" 2>/dev/null; }

# alloc_base TASK - the commit the task's worktree was allocated from
# (worktree_alloc's base=), or empty when unknown.
alloc_base() {
  grep -E '"type": *"worktree_alloc"' "$ledger" 2>/dev/null \
    | grep "\"task\": *\"$1\"" | tail -1 \
    | sed -n 's/.*"base": *"\([^"]*\)".*/\1/p' || true
}

# run_gate [TASK] - a TASK id enables the Flutter scope gate (single-task path);
# no id means the batch gate, which this script's contract explains.
run_gate() {
  local rc=0 all_flutter=1 lang task_id identity selected_identity="" multiple_toolchains=0 structured_toolchains=0
  local -a selected=("$@")
  if [ "${#selected[@]}" -eq 0 ]; then
    if [ "$LEGACY_LANG" = "flutter" ]; then
      "$GREEN_GATE_BIN" --no-commit || rc=$?
    else
      PIPELINE_GATE_PHASE=integration "$RUN_GATES_BIN" "$ws" --legacy || rc=$?
    fi
    return "$rc"
  fi
  for task_id in "${selected[@]}"; do
    if ! lang=$(python3 "$script_dir/toolchain_gate.py" task-lang "$ws" "$task_id"); then
      echo "INTEGRATE: cannot resolve language for task $task_id; refusing gate fallback" >&2
      return 3
    fi
    if [ "$lang" != "flutter" ]; then all_flutter=0; fi
    if identity=$(python3 "$script_dir/toolchain_gate.py" task-toolchain "$ws" "$task_id" 2>/dev/null); then
      structured_toolchains=1
    else
      # The sole compatibility case is task-lang's validated fallback to one
      # unstructured legacy gate. Confirm that boundary before using its
      # language; structured descriptors always need the plan's exact ID.
      local legacy_lang
      if ! legacy_lang=$(python3 "$script_dir/toolchain_gate.py" legacy-lang "$ws" 2>/dev/null) \
         || [ "$legacy_lang" != "$lang" ]; then
        echo "INTEGRATE: cannot resolve exact toolchain for task $task_id; refusing gate fallback" >&2
        return 3
      fi
      identity="legacy:$lang"
    fi
    if [ -z "$selected_identity" ]; then selected_identity=$identity
    elif [ "$identity" != "$selected_identity" ]; then multiple_toolchains=1
    fi
  done
  if [ "$multiple_toolchains" -eq 1 ] || [ "$structured_toolchains" -eq 1 ]; then
    PIPELINE_GATE_PHASE=integration "$RUN_GATES_BIN" "$ws" --tasks "${selected[@]}" || rc=$?
  elif [ "$all_flutter" -eq 1 ]; then
    if [ "${#selected[@]}" -eq 1 ]; then
      "$GREEN_GATE_BIN" --no-commit -w "$ws" -t "${selected[0]}" || rc=$?
    else
      "$GREEN_GATE_BIN" --no-commit || rc=$?
    fi
  elif [ -f "$ws/plan.json" ]; then
      PIPELINE_GATE_PHASE=integration "$RUN_GATES_BIN" "$ws" --tasks "${selected[@]}" || rc=$?
  else
    PIPELINE_GATE_PHASE=integration "$RUN_GATES_BIN" "$ws" --legacy || rc=$?
  fi
  return "$rc"
}

# ledger_and_release TASK SHA - record the integration, fold the shard, release.
ledger_and_release() {
  local n=$1 sha=$2 shard rc=0
  shard="$(shard_of "$n")"
  "$script_dir/ledger-append" "$ledger" integrated "$n" "merged $sha" "commits=$sha" "sha=$sha"
  rc=0
  "$script_dir/ledger-merge" "$ws" "$shard" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "INTEGRATE: ledger-merge failed for task $n" >&2
    # Do NOT release: the worktree holds the only copy of the lost shard.
    return 1
  fi
  local wt archive manifest branch tip
  wt=$(worktree_of "$n")
  branch=$(branch_of "$n")
  tip=$(git rev-parse "refs/heads/$branch") || return 1
  if ! git merge-base --is-ancestor "$tip" HEAD; then
    echo "INTEGRATE: branch tip for task $n is not merged; preserving evidence and worktree" >&2
    return 1
  fi
  local worker_dirty
  worker_dirty=$(git -C "$wt" status --porcelain) || return 1
  if [ -n "$worker_dirty" ]; then
    echo "INTEGRATE: task $n worktree is dirty; preserving user changes" >&2
    return 1
  fi
  archive="$ws/evidence/family-$n.tar.gz"
  local archive_run="$slug"
  if [ -f "$(owner_of "$n")" ]; then
    archive_run=$(python3 - "$(owner_of "$n")" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8")).get("run_id", "legacy"))
PY
)
  fi
  local evidence_root="$wt/.superpowers"
  manifest=$(python3 - "$evidence_root" "$n" "$archive_run" "$tip" <<'PY'
import json, os, sys
root, family, run_id, tip = sys.argv[1:]
files=[]
for base, dirs, names in os.walk(root):
    dirs[:] = sorted(d for d in dirs if d not in ("__pycache__", ".git"))
    for name in sorted(names):
        path=os.path.relpath(os.path.join(base,name),root).replace(os.sep,"/")
        if not path.endswith((".tmp", ".lock")):
            files.append(path)
print(json.dumps({"run_id":run_id,"family_id":family,"files":files,"stopped":True,"strict":True,
                  "clean":True,"approved":True,"merged":True,"merged_tip":tip},separators=(",",":")))
PY
)
  mkdir -p "$(dirname "$archive")"
  if ! python3 - "$script_dir/evidence_archive.py" "$evidence_root" "$archive" "$manifest" <<'PY'
import importlib.util, json, sys
source, root, target, raw = sys.argv[1:]
spec=importlib.util.spec_from_file_location("evidence_archive",source)
module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
module.export_family(root,target,json.loads(raw))
PY
  then
    echo "INTEGRATE: evidence archive failed for task $n - retaining worktree" >&2
    return 1
  fi
  "$script_dir/ledger-append" "$ledger" evidence_archived "$n" "family evidence exported" archive="$archive" || return 1
  rc=0
  "$script_dir/worktree-release" "$ws" "$n" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "INTEGRATE: worktree-release failed for task $n" >&2
    return 1
  fi
  return 0
}

# merge_one TASK - merge, recompute gates on the candidate, commit, record.
# Isolated task gate evidence is never reused for an integrated candidate.
merge_one() {
  local n=$1 mrc task_branch
  task_branch=$(branch_of "$n")

  if ! git merge --no-commit --no-ff "$task_branch" >/dev/null 2>&1; then
    git merge --abort 2>/dev/null || true
    "$script_dir/ledger-append" "$ledger" integration_failed "$n" "conflict"
    return 1
  fi

  local grc=0
  run_gate "$n" || grc=$?
  if [ "$grc" -ne 0 ]; then
    git merge --abort 2>/dev/null || true
    "$script_dir/ledger-append" "$ledger" integration_failed "$n" "gates (rc=$grc)"
    return 1
  fi

  mrc=0
  git commit --no-edit >/dev/null 2>&1 || mrc=$?
  if [ "$mrc" -ne 0 ]; then
    git merge --abort 2>/dev/null || true
    "$script_dir/ledger-append" "$ledger" integration_failed "$n" "commit (rc=$mrc)"
    return 1
  fi
  ledger_and_release "$n" "$(git rev-parse --short HEAD)"
}

failed=0
ordered=$(printf '%s\n' "$@" | sort -n)
todo=""
noop=""
for n in $ordered; do
  if ! ownership_valid "$n"; then failed=1; continue; fi
  # Approval precheck: only a shard carrying `task_complete` proves the revisor
  # approved the task. Merging (and releasing) an un-approved branch would ship
  # unreviewed work and destroy the only debug copy.
  if ! approved "$n"; then
    "$script_dir/ledger-append" "$ledger" integration_failed "$n" "not approved"
    failed=1
    continue
  fi
  # A NO-OP task: approved, but its branch never committed (tip == the
  # allocation base). There is nothing to merge and nothing new to gate, so it
  # is integrated and released directly instead of failing on "nothing to
  # commit" (which would strand the worktree and block final-gate's
  # leftover-branch check).
  base_sha=$(alloc_base "$n")
  task_branch=$(branch_of "$n")
  tip_sha=$(git rev-parse --verify --quiet "refs/heads/$task_branch" || true)
  if [ -n "$base_sha" ] && [ -n "$tip_sha" ] && [ "$tip_sha" = "$base_sha" ]; then
    noop="$noop $n"
  else
    todo="$todo $n"
  fi
done
todo=${todo# }
noop=${noop# }

for n in $noop; do
  echo "INTEGRATE: task $n is a no-op (approved, no commits) - integrating without a merge"
  "$script_dir/ledger-append" "$ledger" integrated "$n" "no-op (no commits)"
  ledger_and_release "$n" "$(git rev-parse --short HEAD)" || failed=1
done

count=$(printf '%s\n' $todo | grep -c . || true)
[ "$count" -ge 1 ] || { [ "$failed" -eq 0 ] || exit 1; echo "INTEGRATE: wave integrated"; exit 0; }

if [ "$count" -eq 1 ]; then
  merge_one "$todo" || failed=1
else
  # Batch: merge the whole wave, gate once, and fall back to the per-merge
  # bisect only when the combined tree is bad.
  base=$(git rev-parse HEAD)
  batch_ok=1
  batch_shas=()
  for n in $todo; do
    task_branch=$(branch_of "$n")
    if ! git merge --no-ff -m "merge $task_branch" "$task_branch" >/dev/null 2>&1; then
      git merge --abort 2>/dev/null || true
      batch_ok=0
      break
    fi
    batch_shas+=("$(git rev-parse --short HEAD)")
  done

  read -ra batch_tasks <<< "$todo"
  if [ "$batch_ok" = "1" ] && run_gate "${batch_tasks[@]}"; then
    i=0
    for n in $todo; do
      ledger_and_release "$n" "${batch_shas[$i]}" || failed=1
      i=$((i + 1))
    done
  else
    # Reset the batch and bisect with the per-merge loop.
    git reset --hard "$base" >/dev/null 2>&1 || true
    echo "INTEGRATE: batch gate failed - falling back to per-merge integration"
    for n in $todo; do
      merge_one "$n" || failed=1
    done
  fi
fi

[ "$failed" -eq 0 ] || exit 1
echo "INTEGRATE: wave integrated"
exit 0
