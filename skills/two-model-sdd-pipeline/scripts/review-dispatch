#!/usr/bin/env bash
# Candidate-bound Codex reviewer dispatch. The normalized request and runtime
# envelope are supplied by the selected run; this command never starts an
# operator or changes the committed candidate.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = "--legacy" ] && [ "$#" -eq 4 ]; then
  ws=$2 task=$3 pkg=$4
  state="$ws/task-$task-review-state.json"
  [ -s "$pkg" ] || { echo "review-dispatch: candidate package missing" >&2; exit 4; }
  candidate=$(git rev-parse HEAD)
  claim=$(python3 "$SCRIPT_DIR/legacy_review_claim.py" claim "$ws" "$task" "$candidate" "$pkg") || exit 4
  if [ "$claim" = completed ]; then
    "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" review_dispatched "$task" \
      "reconciled completed review dispatch for candidate $candidate" candidate="$candidate" || true
    rm -f "$state"
    exit 0
  fi
  [ "$claim" = claimed ] || { echo "review-dispatch: candidate review requires reconciliation" >&2; exit 5; }
  if ! "$SCRIPT_DIR/dispatch-retry" --agent two-model-reviewer --task "$task" \
      --prompt-file "$pkg" --log "$ws/task-$task-reviewer.log"; then
    "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" review_pending "$task" \
      "reviewer dispatch failed; candidate $candidate remains pending" candidate="$candidate" || true
    exit 5
  fi
  python3 "$SCRIPT_DIR/legacy_review_claim.py" complete "$ws" "$task" "$candidate" || exit 5
  "$SCRIPT_DIR/ledger-append" "$ws/ledger.jsonl" review_dispatched "$task" \
    "review dispatched for candidate $candidate" candidate="$candidate" || true
  rm -f "$state"
  exit 0
fi
if [ "${1:-}" = "--build-request" ] && [ "$#" -eq 4 ]; then
  python3 - "$SCRIPT_DIR" "$2" "$3" "$4" <<'PY'
import sys
sys.path.insert(0,sys.argv[1])
import review_dispatch
try: review_dispatch.build_request(sys.argv[2],sys.argv[3],sys.argv[4])
except Exception as exc:
 print("review-dispatch: cannot build Codex request: {}".format(exc),file=sys.stderr)
 raise SystemExit(1)
PY
  exit $?
fi
if [ "$#" -ne 6 ] || [ "$1" != "--request" ] || [ "$3" != "--runtime" ] || [ "$5" != "--output" ]; then
  echo "usage: review-dispatch --build-request WORKSPACE TASK REQUEST.json | --request REQUEST.json --runtime RUNTIME.json --output RESULT.json" >&2
  exit 2
fi
python3 - "$SCRIPT_DIR" "$2" "$4" "$6" <<'PY'
import json,os,sys,tempfile
sys.path.insert(0,sys.argv[1])
import review_dispatch
request=json.load(open(sys.argv[2],encoding="utf-8"))
runtime=json.load(open(sys.argv[3],encoding="utf-8"))
request["result_path"]=sys.argv[4]
request["normalized_result_path"]=sys.argv[4]
result=review_dispatch.ensure_review(request,runtime)
target=sys.argv[4]
os.makedirs(os.path.dirname(os.path.abspath(target)),exist_ok=True)
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(target)),prefix="review-result-")
with os.fdopen(fd,"w",encoding="utf-8") as f:
 if result.get("status")=="review_pending": value=result
 else: value=json.load(open(target,encoding="utf-8"))
 json.dump(value,f,ensure_ascii=False,indent=2); f.write("\n")
os.replace(tmp,target)
if result.get("status")=="review_pending": raise SystemExit(5)
PY
