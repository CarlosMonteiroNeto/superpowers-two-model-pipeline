#!/usr/bin/env bash
# Generic-engine per-task kickoff (language-agnostic mirror of
# flutter-app-pipeline/scripts/red-gate). The brief is scaffolded from the
# plan (brief-scaffold), never hand-written. This gate verifies the scaffold
# exists, ledgers the red_check entry, dispatches Agente operador headlessly,
# and chains straight into coder-gate — which owns retries, the RED-proof
# (operador's tests must fail pre-implementation), commit, and revisor
# dispatch. Agente operador authors the RED tests; nothing is materialized
# here. TEST_CMD resolution stays available for the gates via the ledger.
#
# Usage: red-gate WORKSPACE TASK [TEST_CMD]
#   TEST_CMD  optional override; default is the ledger's gate entry
#             (test_cmd=... from resolve-toolchain, auto or manual).
#
# Exit codes: 0 = coder-gate's exit;
#             2 = usage / missing brief / missing test_cmd.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: red-gate WORKSPACE TASK [TEST_CMD]" >&2
  exit 2
fi

ws=$1
task=$2
brief="$ws/task-$task-brief.md"
ledger="$ws/ledger.jsonl"

[ -f "$brief" ] || { echo "RED-GATE: no brief: $brief" >&2; exit 2; }

test_cmd=${3:-}
if [ -z "$test_cmd" ]; then
  [ -f "$ledger" ] || { echo "RED-GATE: no TEST_CMD given and no ledger to read it from" >&2; exit 2; }
  test_cmd=$(grep -E '"type": *"gate"' "$ledger" | tail -1 | sed -n 's/.*"test_cmd": *"\([^"]*\)".*/\1/p')
  [ -n "$test_cmd" ] || { echo "RED-GATE: no test_cmd in ledger - run resolve-toolchain first" >&2; exit 2; }
fi

echo "RED-GATE: brief scaffolded, dispatching operador"

if [ -f "$ledger" ]; then
  "$SCRIPT_DIR/ledger-append" "$ledger" red_check "$task" \
    "brief scaffolded, dispatching operador" || true
fi

# Dispatch Agente operador headlessly, same as the Flutter fork: the
# scaffolded brief is sound by construction - Script CEO launches the
# operador directly, no intermediation, no LLM approval of a check the
# exit code already decided.
DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"
"$DISPATCH_BIN" --agent two-model-coder --task "$task" \
  --prompt-file "$brief" --log "$ws/task-$task-coder.log"

# Close the loop here instead of stopping at "operador was dispatched": run
# the gate, decide PASS/FAIL/TEST_DEFECT, retry with --continue as needed,
# RED-proof, commit and dispatch the revisor on green.
CODER_GATE="${CODER_GATE:-$SCRIPT_DIR/coder-gate}"
"$CODER_GATE" "$ws" "$task"
exit $?
