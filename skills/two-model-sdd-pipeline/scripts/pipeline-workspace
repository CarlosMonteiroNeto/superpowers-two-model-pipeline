#!/usr/bin/env bash
# Resolve and ensure the working-tree directory the two-model pipeline uses
# for one plan's short-lived artifacts: a working copy of the JSON plan,
# task briefs, RED test staging, review packages, reports, and the JSONL
# ledger. Print the plan directory's absolute path.
#
# The plan's permanent record lives in the tracked docs tree
# (docs/superpowers/plans/<name>-plan.json) — B writes it there. This script
# copies it into the workspace as plan.json so gates keep reading a stable
# local copy; the workspace itself stays git-ignored and disposable.
#
# One directory per plan (.superpowers/two-model/<plan-basename>/) so a
# follow-up plan in the same working tree can never read or overwrite
# another plan's artifacts. Mirrors sdd-workspace's plan-scoping rationale:
# a stale ledger misread as current progress makes orchestrators skip whole
# task sequences.
#
# The workspace lives in the working tree (not under .git/) because agent
# harnesses treat .git/ as protected and deny writes there. A self-ignoring
# .gitignore at .superpowers/two-model/ keeps every workspace out of
# `git status` without modifying any tracked file.
#
# Usage: pipeline-workspace [--refresh] PLAN_FILE
#   --refresh  validate PLAN_FILE and atomically replace the EXISTING workspace
#              snapshot, preserving ledger/partitions/briefs/sessions/reports.
#              A refresh failure exits 1 and keeps the last valid snapshot
#              (F2: the driver reloads the tracked plan after an integration).
#   Exit codes: 0 = snapshot written; 1 = --refresh validation/staging failure;
#               2 = usage / missing plan file.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
. "$SCRIPT_DIR/lib/path-normalize.sh"

refresh=0
if [ "${1:-}" = "--refresh" ]; then
  refresh=1
  shift
fi
if [ $# -ne 1 ]; then
  echo "usage: pipeline-workspace [--refresh] PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# Plans are .json (brainstorming authors plan.json); strip either extension so
# the workspace is named `foo-plan`, not `foo-plan.json` (L3).
slug=$(basename "$plan")
slug=${slug%.json}
slug=${slug%.md}
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
root=$(normalize_posix_path "$root")
root_python="$root"
if command -v cygpath >/dev/null 2>&1; then root_python=$(cygpath -w "$root"); fi
base="$root/.superpowers/two-model"
# New canonical plans are namespaced by repository and relative plan path.
# Preserve the historic basename workspace only for pre-contract legacy plans.
identity=$(python3 - "$SCRIPT_DIR" "$root_python" "$plan" <<'PY'
import importlib.util, json, os, sys
scripts, root, plan_path = sys.argv[1:]
with open(plan_path, encoding="utf-8") as f: plan = json.load(f)
if not isinstance(plan, dict) or "spec_doc" not in plan:
    print(""); raise SystemExit(0)
spec = importlib.util.spec_from_file_location("run_identity", os.path.join(scripts, "run_identity.py"))
mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
run_id = os.environ.get("PIPELINE_RUN_ID", "default")
value = mod.create_identity(root, plan_path, run_id)
print(json.dumps(value, separators=(",", ":")))
PY
)
if [ -n "$identity" ]; then
  workspace_key=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["workspace_key"])' "$identity")
  dir="$base/$workspace_key"
  export PIPELINE_IDENTITY_JSON="$identity"
else
  dir="$base/$slug"
fi

# The same validator gates first creation and every later refresh. Old plans
# without the R3 canonical contract retain the legacy reader during migration.
python3 - "$SCRIPT_DIR" "$root_python" "$plan" <<'PY'
import importlib.util, json, os, sys
scripts, root, path = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as f: plan = json.load(f)
except Exception as exc:
    print("PIPELINE-WORKSPACE: invalid plan: {}".format(exc), file=sys.stderr); raise SystemExit(1)
if isinstance(plan, dict) and "spec_doc" in plan:
    spec = importlib.util.spec_from_file_location("plan_validation", os.path.join(scripts, "plan_validation.py"))
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    try: module.validate_plan(plan, root)
    except ValueError as exc:
        print("PIPELINE-WORKSPACE: {}".format(exc), file=sys.stderr); raise SystemExit(1)
PY
[ $? -eq 0 ] || exit 1

if [ "$refresh" -eq 1 ]; then
  mkdir -p "$dir"
  # Validate the candidate BEFORE touching the live snapshot (F2): reject an
  # unreadable file, invalid JSON, a non-object root, missing/non-list/empty
  # tasks, missing required task fields, duplicate/nonpositive integer ids, and
  # empty/non-list acceptance. A failure leaves the previous snapshot intact.
  python3 - "$plan" "$root_python" "$SCRIPT_DIR" <<'PY'
import json, sys

path = sys.argv[1]
root = sys.argv[2]
scripts = sys.argv[3]


def fail(msg):
    print("PIPELINE-WORKSPACE: invalid plan: %s" % msg, file=sys.stderr)
    sys.exit(1)


try:
    with open(path, encoding="utf-8", errors="replace") as fh:
        plan = json.load(fh)
except Exception as exc:
    fail(str(exc))

if not isinstance(plan, dict):
    fail("root is not an object")
if "spec_doc" in plan:
    import importlib.util, os
    spec = importlib.util.spec_from_file_location("plan_validation", os.path.join(scripts, "plan_validation.py"))
    validator = importlib.util.module_from_spec(spec); spec.loader.exec_module(validator)
    try:
        validator.validate_plan(plan, os.getcwd())
    except ValueError as exc:
        fail(str(exc))
tasks = plan.get("tasks")
if not isinstance(tasks, list) or not tasks:
    fail("tasks must be a non-empty list")
seen = set()
for t in tasks:
    if not isinstance(t, dict):
        fail("every task must be an object")
    for key in ("id", "title", "summary", "acceptance"):
        if not t.get(key):
            fail("task %r missing %s" % (t.get("id"), key))
    tid = t.get("id")
    if isinstance(tid, bool) or not isinstance(tid, int) or tid <= 0:
        fail("task id must be a positive integer: %r" % (tid,))
    if tid in seen:
        fail("duplicate task id %r" % (tid,))
    seen.add(tid)
    acc = t.get("acceptance")
    if (not isinstance(acc, list) or not acc
            or not all(isinstance(a, str) and a.strip() for a in acc)):
        fail("task %s acceptance must be a non-empty list of strings" % tid)
PY
  # Atomic replace: stage beside the snapshot, then rename. A failed read/parse
  # can never truncate the last valid copy; a source that already is the
  # snapshot is copied aside first, so it is never overwritten in place.
  tmp="$dir/plan.json.tmp.$$"
  if ! cp -f "$plan" "$tmp"; then
    rm -f "$tmp"
    echo "PIPELINE-WORKSPACE: cannot stage the refreshed plan" >&2
    exit 1
  fi
  if ! mv -f "$tmp" "$dir/plan.json"; then
    rm -f "$tmp"
    echo "PIPELINE-WORKSPACE: cannot replace the plan snapshot" >&2
    exit 1
  fi
  if [ -n "$identity" ]; then
    printf '%s\n' "$identity" > "$dir/.pipeline-identity.json.tmp.$$"
    mv -f "$dir/.pipeline-identity.json.tmp.$$" "$dir/.pipeline-identity.json"
  fi
  cd "$dir" && pwd
  exit 0
fi

mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
# Working copy for the gates (route-next reads $dir/plan.json); the
# tracked original at $plan is the permanent record.
cp -f "$plan" "$dir/plan.json"
if [ -n "$identity" ]; then
  printf '%s\n' "$identity" > "$dir/.pipeline-identity.json.tmp.$$"
  mv -f "$dir/.pipeline-identity.json.tmp.$$" "$dir/.pipeline-identity.json"
fi
# One-time backward-compat split: mid-project upgrades may have a global
# ledger.jsonl with no per-task partitions yet. Rebuild them best-effort so
# route-next's hot path stays O(this task). Fresh workspaces have no ledger
# yet, so this is a no-op there. route-next also self-migrates on first call.
if [ -f "$dir/ledger.jsonl" ]; then
  if [ -x "$SCRIPT_DIR/ledger-migrate" ]; then
    "$SCRIPT_DIR/ledger-migrate" "$dir" >/dev/null 2>&1 || true
  fi
fi
cd "$dir" && pwd
