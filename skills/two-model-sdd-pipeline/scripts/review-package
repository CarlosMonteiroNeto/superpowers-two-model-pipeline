#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# implementation-only diff with extended context, written to a file the
# revisor reads in one call. The package never passes through the
# orchestrator's context.
#
# Using the recorded per-task BASE (not HEAD~1) keeps multi-commit and
# multi-round tasks intact. Range-named output means a re-review after
# fixes gets a distinct fresh file.
#
# When TASK is given, the task's brief (task-TASK-brief.md) is inlined ahead
# of the commit list, so the revisor receives the context the dispatch
# contract promises ("read the attached review package and the task brief")
# in the single file already delivered via --prompt-file.
#
# Usage: review-package WORKSPACE BASE HEAD [OUTFILE] [TASK]
# Default OUTFILE: <workspace>/review-<base7>..<head7>.diff
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ $# -lt 3 ] || [ $# -gt 5 ]; then
  echo "usage: review-package WORKSPACE BASE HEAD [OUTFILE] [TASK]" >&2
  exit 2
fi

ws=$1
base=$2
head=$3
task=${5:-}
[ -d "$ws" ] || { echo "no such workspace: $ws" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -ge 4 ] && [ -n "$4" ]; then
  out=$4
else
  out="$ws/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

brief="$ws/task-$task-brief.md"

{
  echo "# Review package: ${base}..${head}"
  echo
  if [ -n "$task" ]; then
    if [ -f "$brief" ]; then
      echo "## Task Brief"
      echo "(task-$task-brief.md)"
      echo
      cat "$brief"
      echo
    fi
    python3 - "$ws/plan.json" "$task" <<'PY'
import json,pathlib,sys
plan_path=pathlib.Path(sys.argv[1])
if not plan_path.is_file(): raise SystemExit(0)
root=pathlib.Path.cwd()
try: plan=json.loads(plan_path.read_text(encoding="utf-8"))
except Exception as exc: raise SystemExit("review-package: invalid plan: %s" % exc)
task=next((t for t in plan.get("tasks",[]) if str(t.get("id"))==sys.argv[2]),None)
if task is None: raise SystemExit("review-package: task not found in plan")
print("## Global Constraints\n")
for item in plan.get("global_constraints",[]):
 if isinstance(item,str): print("- "+item)
 elif isinstance(item,dict): print("- "+str(item.get("id",""))+": "+str(item.get("text",item.get("description",""))))
print("\n## Referenced Specifications\n")
for ref in task.get("spec_refs",[]):
 doc,_,anchor=ref.partition("#")
 path=root/doc
 if path.is_file():
  print("### "+ref+"\n")
  text=path.read_text(encoding="utf-8")
  if anchor:
   import re
   heading=re.compile(r"^#{1,6}\s+.*",re.M)
   headings=list(heading.finditer(text)); start=None; end=len(text)
   target=anchor.replace("-"," ").casefold()
   for i,h in enumerate(headings):
    slug=re.sub(r"[^a-z0-9 -]","",h.group(0).lstrip("# ").casefold()).replace(" ","-")
    if slug==anchor.casefold(): start=h.start(); end=headings[i+1].start() if i+1<len(headings) else len(text); break
   if start is not None: text=text[start:end]
  print(text.rstrip()+"\n")
print("## Verification and Evidence Metadata\n")
print("Resolved toolchains: "+json.dumps(plan.get("verification",{}).get("toolchains",[]),ensure_ascii=False))
print("Task verification: "+json.dumps(task.get("verification",{}),ensure_ascii=False))
ledger=plan_path.parent/"ledger.jsonl"
if ledger.is_file():
 print("\nRelevant gate and evidence ledger entries:\n")
 for raw in ledger.read_text(encoding="utf-8",errors="replace").splitlines():
  try: event=json.loads(raw)
  except Exception: continue
  if str(event.get("task"))==sys.argv[2] and event.get("type") in {"gate","toolchain","red_check","coder_round","commit","review_pending"}:
   print(json.dumps(event,ensure_ascii=False,sort_keys=True))
PY
  fi
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

# Site 4 preparation is shared by every reviewer path.  The hook only appends
# procedural guidance to the already-required package; it never owns reviewer
# dispatch, verdict parsing, routing, or ledger state.  A provider/config
# failure therefore falls back inside the hook, while a failure to construct
# the baseline package above remains a real error under `set -e`.
if [ -n "$task" ]; then
  guidance_bin="${REVIEW_GUIDANCE_BIN:-$SCRIPT_DIR/review-guidance}"
  guidance_args=("$out" --workspace "$ws" --task "$task")
  if [ -n "${JEV_POLICY_FILE:-}" ]; then
    guidance_args+=(--policy "$JEV_POLICY_FILE")
  fi
  guidance_rc=0
  if [ -x "$guidance_bin" ]; then
    "$guidance_bin" "${guidance_args[@]}" || guidance_rc=$?
  elif [ -f "$guidance_bin" ]; then
    bash "$guidance_bin" "${guidance_args[@]}" || guidance_rc=$?
  else
    guidance_rc=127
  fi
  if [ "$guidance_rc" -ne 0 ]; then
    echo "review-package: optional review guidance unavailable; using standard review" >&2
  fi
fi

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
