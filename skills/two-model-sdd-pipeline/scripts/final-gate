#!/usr/bin/env bash
# Deterministic final-review readiness gate (pre-gate before the Controller's
# holistic final review). Verdict is an exit code, never LLM judgment.
#
# Checks:
#   1. Every task 1..TOTAL has a `task_complete` ledger entry.
#   2. No task's LAST review_outcome is an unresolved SEND_BACK / ESCALATE.
#   3. No task_complete carries a blocking parked finding, judged by the
#      structured PARKED_SEVERITY field (Critical/Important), never by prose.
#   4. Every configured test and analyze suite for every task toolchain passes
#      on the closing candidate. Closing does not reuse task/integration gates.
#   5. No task's newest `integration_failed` postdates its completion
#      (`task_complete`/`integrated`): the merge is still unresolved.
#   6. Every `worktree_alloc` has a matching `worktree_release`: no wave is
#      still in flight.
#   7. No leftover `task/<N>` branch: integration never closed the task out.
#
# Runs every exact toolchain ID referenced by tasks 1..TOTAL from the plan.
# Workspaces without task identities retain the unique legacy gate record.
#
# Usage: final-gate WORKSPACE TOTAL_TASKS
# Exit codes: 0 = mechanically ready, 1 = blocker(s) listed, 2 = usage /
#             missing ledger / missing gate entry.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: final-gate WORKSPACE TOTAL_TASKS" >&2
  exit 2
fi

ws=$1
total=$2
ledger="$ws/ledger.jsonl"

[ -f "$ledger" ] || { echo "FINAL-GATE: no ledger: $ledger" >&2; exit 2; }

gate_line=$(grep -E '"type": *"gate"' "$ledger" | head -1)
if [ -z "$gate_line" ]; then
  echo "FINAL-GATE: no gate entry in ledger" >&2
  exit 2
fi

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
RUN_GATES_BIN="${RUN_GATES_BIN:-$SCRIPT_DIR/run-gates}"

blockers=0
emit() {
  echo "FINAL-GATE: $1" >&2
  blockers=$((blockers + 1))
}

for t in $(seq 1 "$total"); do
  entries=$(grep -E '"task": *"'$t'"' "$ledger" || true)

  complete=$(printf '%s' "$entries" | grep -cE '"type": *"task_complete"' || true)
  if [ "$complete" -eq 0 ]; then
    emit "task $t is not complete"
  fi

  last_review=$(printf '%s' "$entries" | grep -E '"type": *"review_outcome"' | tail -1 || true)
  verdict=$(printf '%s' "$last_review" | sed -n 's/.*"summary": *"\([^"]*\)".*/\1/p')
  case "$verdict" in
    SEND_BACK|ESCALATE) emit "task $t last review unresolved: $verdict" ;;
  esac

  # M7: blocking parked findings are a structured severity field on the last
  # task_complete, never a substring of free prose (a parked Minor reading
  # "not important, cosmetic" must not block the branch).
  parked_sev=$(printf '%s' "$entries" | grep -E '"type": *"task_complete"' | tail -1 \
    | sed -n 's/.*"PARKED_SEVERITY": *"\([^"]*\)".*/\1/p' || true)
  case "$parked_sev" in
    Critical|Important) emit "task $t has a blocking parked finding ($parked_sev)" ;;
  esac

  # 5: a newer integration_failed than the task's last close means the merge
  # is still unresolved (wave-next reopens it). Compare line positions with
  # the same tail-based ordering used above for verdicts/parked severity.
  last_close_ln=$(printf '%s' "$entries" \
    | grep -nE '"type": *"(task_complete|integrated)"' | tail -1 | cut -d: -f1 || true)
  last_fail_ln=$(printf '%s' "$entries" \
    | grep -nE '"type": *"integration_failed"' | tail -1 | cut -d: -f1 || true)
  if [ -n "$last_fail_ln" ] && [ -n "$last_close_ln" ] \
     && [ "$last_fail_ln" -gt "$last_close_ln" ]; then
    emit "task $t failed integration after completion"
  fi
done

# 6: an unmatched worktree_alloc means a wave is still in flight (the same
# condition ledger-migrate defers on) - integration never closed the task.
alloc=$(grep -cE '"type": *"worktree_alloc"' "$ledger" || true)
released=$(grep -cE '"type": *"worktree_release"' "$ledger" || true)
if [ "${alloc:-0}" -gt "${released:-0}" ]; then
  emit "a worktree is still allocated ($alloc alloc / $released release)"
fi

# 7: a leftover task/<N> branch means the task was never integrated/cleaned
# up. git branch prints nothing (and exits non-zero) outside a repo, so a
# missing repo is not a blocker here.
task_branches=$(git branch --list 'task/*' 2>/dev/null | tr -d ' *' | tr '\n' ' ' || true)
if [ -n "$task_branches" ]; then
  emit "unmerged task branch(es) remain: $task_branches"
fi

task_ids=()
for t in $(seq 1 "$total"); do task_ids+=("$t"); done
if [ -f "$ws/plan.json" ]; then
  if ! PIPELINE_GATE_PHASE=closing "$RUN_GATES_BIN" "$ws" --tasks "${task_ids[@]}"; then
    emit "one or more configured test/analyze commands failed"
    for t in "${task_ids[@]}"; do
      "$SCRIPT_DIR/ledger-append" "$ledger" integration_failed "$t" \
        "closing candidate verification failed; task reopened" || emit "could not record reopened task $t"
    done
  fi
elif ! PIPELINE_GATE_PHASE=closing "$RUN_GATES_BIN" "$ws" --legacy; then
  emit "legacy test/analyze command failed"
  for t in $(seq 1 "$total"); do
    "$SCRIPT_DIR/ledger-append" "$ledger" integration_failed "$t" \
      "closing candidate verification failed; task reopened" || emit "could not record reopened task $t"
  done
fi

if [ "$blockers" -eq 0 ]; then
  echo "FINAL-GATE: mechanically ready for holistic review"
  exit 0
fi

echo "FINAL-GATE: $blockers blocker(s) - not ready" >&2
exit 1
