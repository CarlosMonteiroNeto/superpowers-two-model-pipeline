#!/usr/bin/env bash
# Resolve validated executable toolchain descriptors and ledger them by ID.
# Flutter/Dart, pytest, and Go have tested built-in adapters. Node/Rust require
# a runtime manifest with a supported, tested RED adapter; marker detection
# alone is never treated as evidence support.
#
# Usage: resolve-toolchain [--all] [--runtime FILE] WORKSPACE [ROOT]
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
all=0
runtime="${PIPELINE_RUNTIME_MANIFEST:-}"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --all) all=1; shift ;;
    --runtime)
      [ $# -ge 2 ] || { echo "resolve-toolchain: --runtime needs a file" >&2; exit 2; }
      runtime=$2
      shift 2
      ;;
    --) shift; break ;;
    *) args+=("$1"); shift ;;
  esac
done
args+=("$@")

if [ ${#args[@]} -lt 1 ] || [ ${#args[@]} -gt 2 ]; then
  echo "usage: resolve-toolchain [--all] [--runtime FILE] WORKSPACE [ROOT]" >&2
  exit 2
fi
workspace=${args[0]}
root=${args[1]:-}
if [ -z "$root" ]; then
  root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
fi

python3 "$SCRIPT_DIR/toolchain_contract.py" --resolve-cli \
  "$all" "$workspace" "$root" "$runtime"
