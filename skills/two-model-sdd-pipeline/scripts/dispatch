#!/usr/bin/env bash
# Public dispatch seam. Existing callers retain the historical OpenCode route;
# new callers select a backend explicitly with --backend.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
backend="opencode"
if [ "${1:-}" = "--backend" ]; then backend=${2:-}; shift 2; fi
case "$backend" in
  opencode) exec "$SCRIPT_DIR/dispatch-opencode" "$@" ;;
  codex) exec "$SCRIPT_DIR/dispatch-codex" "$@" ;;
  *) echo "dispatch: unsupported backend: $backend" >&2; exit 2 ;;
esac
