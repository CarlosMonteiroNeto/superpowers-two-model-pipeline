#!/usr/bin/env bash
# Deterministic headless subagent launcher (ADR-0001): dispatches C or D via
# `opencode run --agent`, tees the JSON event stream to a workspace log
# (observability - the developer can tail it; the main session never sees it),
# and records the sessionID for `--continue --session` resume on fix/correction
# rounds (ADR-0003 context retention).
#
# Usage:
#   dispatch --agent <two-model-coder|two-model-reviewer> --task N \
#            [--continue SESSION] --prompt-file FILE --log LOG
#
#   --agent        agent definition name (must be mode: all - see spike findings)
#   --task         task number (used for the session-id record path)
#   --continue     resume an existing session (fix / correction round)
#   --prompt-file  file with the dispatch prompt / brief
#   --log          workspace log path (JSON event stream teed here)
#
# Env: OPENCODE_BIN (default opencode), OPENCODE_DIR (optional workdir).
# Exit codes: 0 = dispatched, 2 = usage / missing prompt file; otherwise
# opencode's exit code.
set -euo pipefail

OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

usage() {
  echo "usage: dispatch --agent NAME --task N [--continue SESSION] --prompt-file FILE --log LOG" >&2
  exit 2
}

agent=""
task=""
cont=""
prompt_file=""
log=""
workdir=""

while [ $# -gt 0 ]; do
  case "$1" in
    --agent) agent=${2:-}; shift 2 ;;
    --task) task=${2:-}; shift 2 ;;
    --continue) cont=${2:-}; shift 2 ;;
    --prompt-file) prompt_file=${2:-}; shift 2 ;;
    --log) log=${2:-}; shift 2 ;;
    --workdir) workdir=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done

[ -n "$agent" ] && [ -n "$task" ] && [ -n "$prompt_file" ] && [ -n "$log" ] || usage
[ -f "$prompt_file" ] || { echo "DISPATCH: no prompt file: $prompt_file" >&2; exit 2; }

mkdir -p "$(dirname "$log")"

args=(run --agent "$agent" --format json)
if [ -n "$cont" ]; then
  args+=(--continue --session "$cont")
fi

prompt="You are dispatched by Script A. Read the attached file and execute per its instructions. Report concisely."

set +e
if [ -n "$workdir" ]; then
  # The brief is passed as a positional so opencode auto-attaches it. --file
  # is deliberately NOT used: this opencode version treats the positional
  # message as a file path whenever --file is present, which breaks every run.
  (cd "$workdir" && "$OPENCODE_BIN" "${args[@]}" "$prompt_file" "$prompt" > "$log" 2>&1)
else
  "$OPENCODE_BIN" "${args[@]}" "$prompt_file" "$prompt" > "$log" 2>&1
fi
rc=$?
set -e

# Refuse a silent fallback: if the requested agent is mode: subagent, opencode
# warns and runs the default agent instead. Dispatching the wrong agent breaks
# the two-tier contract, so fail loudly rather than continue wrongly.
if grep -qE 'is a subagent, not a primary agent|Falling back to default agent' "$log" 2>/dev/null; then
  echo "DISPATCH: agent \"$agent\" is not a primary agent (mode: all required). Refusing to continue with the wrong agent." >&2
  exit 3
fi

# Record the session id for resume (fix / correction rounds).
sid=$(sed -n 's/.*"sessionID":"\([^"]*\)".*/\1/p' "$log" | head -1)
if [ -n "$sid" ]; then
  sid_dir=$(dirname "$log")
  # Generic record (last writer, read by B) + per-agent record so
  # session-clean can delete both the Coder and Reviewer sessions.
  printf '%s\n' "$sid" > "$sid_dir/task-$task-session.txt"
  printf '%s\n' "$sid" > "$sid_dir/task-$task-$agent-session.txt"
fi

exit "$rc"