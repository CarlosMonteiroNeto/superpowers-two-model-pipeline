#!/usr/bin/env bash
# Deterministic headless subagent launcher (ADR-0001): dispatches C or D via
# `opencode run --agent`, tees the JSON event stream to a workspace log
# (observability - the developer can tail it; the main session never sees it),
# prints a live progress digest to stdout (short lines - the calling session
# watches the agent work without opening the log), and records the sessionID
# for `--continue --session` resume on fix/correction rounds (ADR-0003
# context retention).
#
# Usage:
#   dispatch --agent <two-model-coder|two-model-reviewer> --task N \
#            [--continue SESSION] --prompt-file FILE --log LOG
#
#   --agent        agent definition name (must be mode: all - see spike findings)
#   --task         task number (used for the session-id record path)
#   --continue     resume an existing session (fix / correction round)
#   --prompt-file  file with the dispatch prompt / brief
#   --log          workspace log path (JSON event stream teed here)
#
# Env: OPENCODE_BIN (default opencode), OPENCODE_DIR (optional workdir).
# Exit codes: 0 = dispatched, 2 = usage / missing prompt file; otherwise
# opencode's exit code.
set -euo pipefail

OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

usage() {
  echo "usage: dispatch --agent NAME --task N [--continue SESSION] --prompt-file FILE --log LOG" >&2
  exit 2
}

agent=""
task=""
cont=""
prompt_file=""
log=""
workdir=""

while [ $# -gt 0 ]; do
  case "$1" in
    --agent) agent=${2:-}; shift 2 ;;
    --task) task=${2:-}; shift 2 ;;
    --continue) cont=${2:-}; shift 2 ;;
    --prompt-file) prompt_file=${2:-}; shift 2 ;;
    --log) log=${2:-}; shift 2 ;;
    --workdir) workdir=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done

[ -n "$agent" ] && [ -n "$task" ] && [ -n "$prompt_file" ] && [ -n "$log" ] || usage
[ -f "$prompt_file" ] || { echo "DISPATCH: no prompt file: $prompt_file" >&2; exit 2; }

mkdir -p "$(dirname "$log")"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# Session resume handle. Written by the digest filter (which already parses the
# JSON stream) instead of a whitespace-sensitive sed, and per-agent only: the
# generic task-N-session.txt pointed at whoever dispatched last (a trap when
# the reviewer dispatched after the operador).
sid_dir=$(dirname "$log")
sid_file="$sid_dir/task-$task-$agent-session.txt"

args=(run --agent "$agent" --format json)
if [ -n "$cont" ]; then
  args+=(--continue --session "$cont")
fi

if [ -n "$cont" ]; then
  prompt="You are dispatched by Script CEO on a CORRECTIVE round. The attached brief may have CHANGED since your last round. Re-read it FULLY and apply its requirements; do NOT assume prior work is complete. Report concisely."
else
  prompt="You are dispatched by Script CEO. Read the attached file and execute per its instructions. Report concisely."
fi

set +e
# Live digest filter (python program via -c so stdin stays on the pipe;
# a heredoc would steal stdin and leave tee readerless -> SIGPIPE).
# Prints short progress lines to stdout; full stream still lands in $log
# via tee. Never fails the dispatch: all errors swallowed, exit 0 always.
DIGEST_FILTER='import json, sys
agent, task, sid_file = sys.argv[1], sys.argv[2], sys.argv[3]
printed = 0
session = None
try:
    for raw in sys.stdin:
        line = raw.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if not isinstance(ev, dict):
            continue
        if session is None:
            sid = ev.get("sessionID")
            if sid:
                session = sid
                if sid_file:
                    try:
                        with open(sid_file, "w", encoding="utf-8") as fh:
                            fh.write(sid + "\n")
                    except Exception:
                        pass
                print("[%s:%s] session %s" % (agent, task, sid), flush=True)
        if ev.get("type") != "text":
            continue
        part = ev.get("part", {})
        text = part.get("text", "") if isinstance(part, dict) else ""
        if not isinstance(text, str) or len(text) <= printed:
            continue
        printed = len(text)
        tail = text.splitlines()[-1][-160:] if text.splitlines() else ""
        if tail.strip():
            print("[%s:%s] %s" % (agent, task, tail.strip()), flush=True)
except Exception:
    pass
sys.exit(0)'
stream_run() {
  # Verdict is opencode's (PIPESTATUS[0]); the filter always exits 0.
  "$OPENCODE_BIN" "${args[@]}" "$prompt_file" "$prompt" 2>&1 \
    | tee "$log" \
    | python3 -c "$DIGEST_FILTER" "$agent" "$task" "$sid_file"
  return "${PIPESTATUS[0]}"
}
if [ -n "$workdir" ]; then
  # The brief is passed as a positional so opencode auto-attaches it. --file
  # is deliberately NOT used: this opencode version treats the positional
  # message as a file path whenever --file is present, which breaks every run
  # (ADR-0009).
  (cd "$workdir" && stream_run)
else
  stream_run
fi
rc=$?
set -e

# Refuse a silent fallback: if the requested agent is mode: subagent, opencode
# warns and runs the default agent instead. Dispatching the wrong agent breaks
# the two-tier contract, so fail loudly rather than continue wrongly.
# Position is the wrong discriminator (stderr/stdout interleave under
# buffering): scan the lines that fail json.loads - the banner is never valid
# JSON, while file content embedded in a tool event always is, so this kills
# both the false negative and the false positive.
if python3 - "$log" <<'PY'
import json, re, sys
pat = re.compile(r'is a subagent, not a primary agent|Falling back to default agent')
try:
    with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                json.loads(line)
                continue
            except Exception:
                pass
            if pat.search(line):
                sys.exit(0)
except OSError:
    pass
sys.exit(1)
PY
then
  echo "DISPATCH: agent \"$agent\" is not a primary agent (mode: all required). Refusing to continue with the wrong agent." >&2
  rm -f "$sid_file"
  exit 3
fi

# The digest filter wrote the per-agent session id for resume. When none was
# recorded, ledger the regression: without it every retry pays full prompt cost
# instead of a cache-billed prefix (ADR-0003), and nothing would show it.
sid=""
[ -f "$sid_file" ] && sid=$(cat "$sid_file" 2>/dev/null || true)
if [ -z "$sid" ]; then
  "$SCRIPT_DIR/ledger-append" "$sid_dir/ledger.jsonl" session_lost "$task" \
    "no session id recorded by dispatch" >/dev/null 2>&1 || true
fi

exit "$rc"