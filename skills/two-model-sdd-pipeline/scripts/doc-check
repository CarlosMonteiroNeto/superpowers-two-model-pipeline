#!/usr/bin/env bash
# Deterministic post-commit gate: if pipeline files changed, README.md must
# also be updated. Prevents the end-of-session rule from being skipped.
# README.md is the single canonical operational and architectural reference;
# later rounds must not recreate retired documents or require duplicate
# README updates.
#
# Usage: doc-check [REPO [BASE [HEAD]]]    (defaults to cwd / HEAD~1..HEAD)
# Exit codes: 0 = OK (no violation), 1 = pipeline changed but README.md not
#             updated, 2 = usage / not a repo.
set -euo pipefail

repo=${1:-.}
base=${2:-}
head=${3:-HEAD}
cd "$repo" || { echo "DOC-CHECK: no such repo: $repo" >&2; exit 2; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "DOC-CHECK: not a git work tree" >&2; exit 2; }

# Keep legacy one-commit behavior, while Codex passes its recorded run range.
if [ -z "$base" ]; then
  if ! git rev-parse HEAD~1 >/dev/null 2>&1; then
    echo "DOC-CHECK: initial commit - no check needed"
    exit 0
  fi
  base=HEAD~1
fi
git rev-parse --verify "$base^{commit}" >/dev/null 2>&1 || { echo "DOC-CHECK: invalid base commit: $base" >&2; exit 2; }
git rev-parse --verify "$head^{commit}" >/dev/null 2>&1 || { echo "DOC-CHECK: invalid head commit: $head" >&2; exit 2; }
changed=$(git diff --name-only "$base..$head" || true)
runtime_changed=$(printf '%s\n' "$changed" | grep -E '^skills/.*/(scripts/|SKILL\.md|references/)' || true)

if [ -z "$runtime_changed" ]; then
  echo "DOC-CHECK: no runtime contracts changed - OK"
  exit 0
fi

readme_changed=$(printf '%s\n' "$changed" | grep -Fx 'README.md' || true)

if [ -z "$readme_changed" ]; then
  echo "DOC-CHECK: pipeline files changed but README.md not updated" >&2
  echo "DOC-CHECK: update README.md then amend or commit" >&2
  exit 1
fi

echo "DOC-CHECK: pipeline files and README.md both updated - OK"
exit 0
