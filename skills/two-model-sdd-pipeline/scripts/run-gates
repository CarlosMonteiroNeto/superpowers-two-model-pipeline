#!/usr/bin/env bash
# Execute ledgered toolchain commands through cmd, preserving argv/cwd/env.
#
# Usage:
#   run-gates WORKSPACE TEST_CMD ANALYZE_CMD   (legacy-compatible)
#   run-gates WORKSPACE --toolchains ID [ID...]
#   run-gates WORKSPACE --tasks TASK [TASK...]
# Exit codes: 0 = configured gates passed, 1 = tests failed, 2 = analysis
# failed, 3 = usage or descriptor/preflight error.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
if [ $# -lt 2 ]; then
  echo "usage: run-gates WORKSPACE TEST_CMD ANALYZE_CMD | --toolchains ID... | --tasks TASK..." >&2
  exit 3
fi

ws=$1
shift
if [ $# -eq 2 ] && [ -f "$ws/ledger.jsonl" ]; then
  # Read a structured descriptor directly from the ledger. Do not pass its
  # JSON argv summary through the Windows Bash command-line parser.
  exec python3 "$SCRIPT_DIR/toolchain_gate.py" run "$ws" --ledger
fi
exec python3 "$SCRIPT_DIR/toolchain_gate.py" run "$ws" "$@"
