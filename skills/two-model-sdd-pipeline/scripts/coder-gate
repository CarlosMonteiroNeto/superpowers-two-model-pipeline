#!/usr/bin/env bash
# Approves the coder's green: runs the gate after EVERY Agente operador
# attempt, decides PASS/FAIL/TEST_DEFECT by exit code and log content alone,
# and drives the retry loop itself — ledgering coder_round, redispatching the
# operador with --continue, or committing + dispatching the revisor on green.
# Zero LLM involvement between "operador just finished" and "task is
# committed and revisor dispatched" or "TEST_DEFECT, Agente diretor rules".
#
# Coder-owned RED (ADR-0007): the operador authors the RED tests, RUNS them
# itself, confirms the expected failure, and saves that failing output to
# <ws>/task-N-red.txt. Before approving green, this script verifies that the
# evidence exists and contains the task's `expected_red`. The old
# stash-and-rerun RED-proof is gone (it broke greenfield: stashing a new
# implementation yields a compile error, not the expected behavior failure).
# The RED check here is an artifact check, not a re-run — the operador owns
# the RED/GREEN execution.
#
# The loop is UNBOUNDED: the operador keeps iterating (fix prompt + resume)
# until the gate passes. There is no round budget and no hand-back for help.
#
# Chained by red-gate immediately after the first dispatch. Safe to call
# again standalone on manual resume (e.g. after a crashed session).
#
# Requires a `gate` ledger entry (resolve-toolchain) with lang/test_cmd/
# analyze_cmd, a brief at WORKSPACE/task-N-brief.md, and — for the RED-evidence
# check — task metadata (expected_red) in WORKSPACE/plan.json.
#
# Usage: coder-gate WORKSPACE TASK
# Exit codes: 0 = green, RED-evidence verified, committed, revisor dispatched;
#             1 = internal error (commit/reviewer setup failed - nothing on
#                 doubt is claimed green); 2 = TEST_DEFECT reported (escalated
#                 ledgered - route-next will emit ARBITRATE);
#             3 = usage / missing gate or brief.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
FLUTTER_GATE="$SCRIPT_DIR/../../flutter-app-pipeline/scripts/green-gate"

if [ $# -ne 2 ]; then
  echo "usage: coder-gate WORKSPACE TASK" >&2
  exit 3
fi

ws=$1
task=$2
ledger="$ws/ledger.jsonl"
brief="$ws/task-$task-brief.md"

[ -f "$ledger" ] || { echo "CODER-GATE: no ledger: $ledger" >&2; exit 3; }
[ -f "$brief" ] || { echo "CODER-GATE: no brief: $brief" >&2; exit 3; }

gate_entry=$(grep -E '"type":"gate"|"type": *"gate"' "$ledger" | tail -1)
[ -n "$gate_entry" ] || { echo "CODER-GATE: no gate entry - run resolve-toolchain first" >&2; exit 3; }
lang=$(printf '%s' "$gate_entry" | sed -n 's/.*"lang": *"\([^"]*\)".*/\1/p')
test_cmd=$(printf '%s' "$gate_entry" | sed -n 's/.*"test_cmd": *"\([^"]*\)".*/\1/p')
analyze_cmd=$(printf '%s' "$gate_entry" | sed -n 's/.*"analyze_cmd": *"\([^"]*\)".*/\1/p')

base=$(git rev-parse HEAD)

# Fixed workspace paths, overwritten every iteration: no round counting, no
# failure tally. The loop just runs until the gate passes - each retry
# reuses the same files, and dispatch overwrites the coder log, so the
# TEST_DEFECT check below always reads the latest round.
log="$ws/task-$task-coder.log"
report="$ws/task-$task-gate.txt"
diff_file="$ws/task-$task-diff.txt"
fix_prompt="$ws/task-$task-fix.md"
red_evidence="$ws/task-$task-red.txt"

# The task's expected failure reason (from the plan). Empty when the plan or
# task carries no metadata - the RED-evidence check is then skipped (legacy
# layouts), matching the old RED-proof skip behaviour.
expected_red() {
  python3 - "$ws/plan.json" "$task" <<'PY'
import json, os, sys
path = sys.argv[1]
if not os.path.isfile(path):
    print("")
    raise SystemExit(0)
try:
    with open(path, encoding="utf-8") as fh:
        plan = json.load(fh)
except Exception:
    print("")
    raise SystemExit(0)
for entry in plan.get("tasks", []):
    if str(entry.get("id")) == sys.argv[2]:
        print(str(entry.get("expected_red") or ""))
        raise SystemExit(0)
print("")
PY
}

# Coder-owned RED: the saved evidence must exist and contain expected_red.
# Returns 0 (ok / no metadata to check) or 1 (missing or wrong reason).
red_evidence_ok() {
  local expected
  expected=$(expected_red)
  [ -n "$expected" ] || return 0
  [ -f "$red_evidence" ] || return 1
  grep -Fq -- "$expected" "$red_evidence"
}

while true; do
  if [ -f "$log" ]; then
    # Scoped TEST_DEFECT detection: only the operador's final status line counts.
    # A whole-log grep would false-positive on the fix prompt text this script
    # itself writes into the round-N log (it contains the word TEST_DEFECT as
    # instruction) - the same whole-log-grep class dispatch guards against.
    # The operador's report contract ends with `Status: DONE | ... | TEST_DEFECT`,
    # so parse the JSONL text events and check the LAST one's tail.
    coder_status=$(python3 - "$log" <<'PY'
import json, re, sys
statuses = ("DONE", "DONE_WITH_CONCERNS", "BLOCKED", "TEST_DEFECT")
last = None
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if ev.get("type") != "text":
                continue
            part = ev.get("part", {})
            t = part.get("text", "")
            if isinstance(t, str):
                last = t
except Exception:
    last = None
if last is not None:
    m = re.findall(r"Status:\s*(" + "|".join(statuses) + ")", last)
    if m:
        print(m[-1])
PY
)
    if [ "$coder_status" = "TEST_DEFECT" ]; then
      "$SCRIPT_DIR/ledger-append" "$ledger" escalated "$task" \
        "TEST_DEFECT reported by operador"
      echo "CODER-GATE: TEST_DEFECT - escalated, no further retries; Agente diretor arbitrates" >&2
      exit 2
    fi
  fi

  passed=0
  evidence_failed=0

  # RED-evidence check first: the green gate commits, so the evidence must be
  # valid before we let it run. A missing/wrong evidence is its own failure
  # with a dedicated fix prompt.
  if ! red_evidence_ok; then
    evidence_failed=1
    {
      echo "RED evidence is missing or does not contain the expected failure."
      echo "Required file: $red_evidence"
      echo "Expected failure substring: $(expected_red)"
      echo "Run your RED tests BEFORE implementing and save the failing output"
      echo "there; if you already implemented, revert it, run the tests, save"
      echo "the failure, then re-implement."
      if [ -f "$red_evidence" ]; then
        echo "--- current evidence ---"
        cat "$red_evidence"
      fi
    } > "$report"
  elif [ "$lang" = "flutter" ]; then
    if GREEN_GATE_REPORT="$report" "$FLUTTER_GATE" \
        -w "$ws" -t "$task" -b "$base" -l "$ledger" \
        -m "task $task green"; then
      passed=1
    fi
  else
    RUN_GATES_BIN="${RUN_GATES_BIN:-$SCRIPT_DIR/run-gates}"
    if "$RUN_GATES_BIN" "$ws" "$test_cmd" "$analyze_cmd"; then
      passed=1
    fi
  fi

  if [ "$passed" -eq 1 ]; then
    "$SCRIPT_DIR/ledger-append" "$ledger" coder_round "$task" \
      "Coder passed the gate" status=PASS

    if [ "$lang" != "flutter" ]; then
      # Flutter's green-gate owns the commit + revisor dispatch above. The
      # generic engine's run-gates deliberately never commits (it is a
      # check-only mirror) - Script CEO (this script) owns that step here.
      git add -A
      if git commit -m "task $task green" >/dev/null 2>&1; then
        sha=$(git rev-parse --short HEAD)
        "$SCRIPT_DIR/ledger-append" "$ledger" commit "$task" "green $sha" commits="$sha"
        pkg="$ws/task-$task-review-package.diff"
        "$SCRIPT_DIR/review-package" "$ws" "$base" HEAD "$pkg" "$task" || true
        DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"
        "$DISPATCH_BIN" --agent two-model-reviewer --task "$task" \
          --prompt-file "$pkg" --log "$ws/task-$task-reviewer.log" || true
      else
        echo "CODER-GATE: gate green but nothing to commit" >&2
      fi
    fi
    exit 0
  fi

  if [ "$evidence_failed" -eq 1 ]; then
    "$SCRIPT_DIR/ledger-append" "$ledger" coder_round "$task" \
      "Coder failed the gate (RED evidence)" status=FAIL
  else
    "$SCRIPT_DIR/ledger-append" "$ledger" coder_round "$task" \
      "Coder failed the gate" status=FAIL
  fi

  # No budget and no counting: loop until the gate passes. The only way out
  # besides green is TEST_DEFECT (checked at the top of the next iteration).

  # Build the fix prompt: purely mechanical (file paths + the static
  # coder-prompt.md retry framing) - no LLM needed to construct it.
  git diff > "$diff_file"
  cat > "$fix_prompt" << FIXEOF
# Fix — Task $task

A previous coder attempt did not satisfy the gate. Read these first:

- Prior diff (your uncommitted changes so far): $diff_file
- Gate failure output: $report
- Your original brief remains the authority: $brief

Fix the failure. You decide fresh what to keep from the prior diff; the
brief and acceptance criteria are unchanged and still binding. You own the
RED/GREEN loop: the RED failure you observed must be saved to
$red_evidence and contain the expected failure text. Do not weaken any test
file to make it pass — if the failure says your tests prove nothing or the
RED evidence is missing, strengthen them / re-run the RED tests; if the
acceptance itself is unsatisfiable, report TEST_DEFECT instead of changing it.

Report using the same status contract as before.
FIXEOF

  session=""
  [ -f "$ws/task-$task-session.txt" ] && session=$(cat "$ws/task-$task-session.txt")
  DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"

  if [ -n "$session" ]; then
    "$DISPATCH_BIN" --agent two-model-coder --task "$task" \
      --continue "$session" --prompt-file "$fix_prompt" --log "$log"
  else
    echo "CODER-GATE: no session recorded - dispatching fresh (context reset)" >&2
    "$DISPATCH_BIN" --agent two-model-coder --task "$task" \
      --prompt-file "$fix_prompt" --log "$log"
  fi
  # loop: re-check the gate on the resumed session's output.
done
