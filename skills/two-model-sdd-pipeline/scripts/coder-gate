#!/usr/bin/env bash
# Closes the gap between round-1 dispatch (red-gate) and completion: runs
# the gate check after EVERY Coder round, decides PASS/FAIL/TEST_DEFECT by
# exit code and log content alone, and drives the whole retry loop itself -
# ledgering coder_round, redispatching C with --continue, or handing off to
# commit + Reviewer dispatch on green. Zero LLM involvement between "C just
# finished a round" and "task is committed and D is dispatched" or
# "TEST_DEFECT, hand to B for ARBITRATE".
#
# The loop is UNBOUNDED: the Coder keeps iterating (fix prompt + resume)
# until the gate passes. There is no round budget and no hand-back to the
# main agent for help - Script A only stops on green (commit + Reviewer
# dispatch) or on TEST_DEFECT (the test itself is wrong, which only B can
# rule on).
#
# Chained by red-gate immediately after the first dispatch. Safe to call
# again standalone on manual resume (e.g. after a crashed session).
#
# Requires a `gate` ledger entry (resolve-toolchain) with lang/test_cmd/
# analyze_cmd, and a brief at WORKSPACE/task-N-brief.md.
#
# Usage: coder-gate WORKSPACE TASK
# Exit codes: 0 = green, committed, Reviewer dispatched;
#             2 = TEST_DEFECT reported (escalated ledgered - route-next will emit
#                 ARBITRATE); 3 = usage / missing gate or brief.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
FLUTTER_GATE="$SCRIPT_DIR/../../flutter-app-pipeline/scripts/green-gate"

if [ $# -ne 2 ]; then
  echo "usage: coder-gate WORKSPACE TASK" >&2
  exit 3
fi

ws=$1
task=$2
ledger="$ws/ledger.jsonl"
brief="$ws/task-$task-brief.md"

[ -f "$ledger" ] || { echo "CODER-GATE: no ledger: $ledger" >&2; exit 3; }
[ -f "$brief" ] || { echo "CODER-GATE: no brief: $brief" >&2; exit 3; }

gate_entry=$(grep -E '"type":"gate"|"type": *"gate"' "$ledger" | tail -1)
[ -n "$gate_entry" ] || { echo "CODER-GATE: no gate entry - run resolve-toolchain first" >&2; exit 3; }
lang=$(printf '%s' "$gate_entry" | sed -n 's/.*"lang": *"\([^"]*\)".*/\1/p')
test_cmd=$(printf '%s' "$gate_entry" | sed -n 's/.*"test_cmd": *"\([^"]*\)".*/\1/p')
analyze_cmd=$(printf '%s' "$gate_entry" | sed -n 's/.*"analyze_cmd": *"\([^"]*\)".*/\1/p')

base=$(git rev-parse HEAD)

# Fixed workspace paths, overwritten every iteration: no round counting, no
# failure tally. The loop just runs until the gate passes - each retry
# reuses the same files, and dispatch overwrites the coder log, so the
# TEST_DEFECT check below always reads the latest round.
log="$ws/task-$task-coder.log"
report="$ws/task-$task-gate.txt"
diff_file="$ws/task-$task-diff.txt"
fix_prompt="$ws/task-$task-fix.md"

while true; do
  if [ -f "$log" ]; then
    # Scoped TEST_DEFECT detection: only the Coder's final status line counts.
    # A whole-log grep would false-positive on the fix prompt text this script
    # itself writes into the round-N log (it contains the word TEST_DEFECT as
    # instruction) - the same whole-log-grep class dispatch guards against.
    # The Coder's report contract ends with `Status: DONE | ... | TEST_DEFECT`,
    # so parse the JSONL text events and check the LAST one's tail.
    coder_status=$(python3 - "$log" <<'PY'
import json, re, sys
statuses = ("DONE", "DONE_WITH_CONCERNS", "BLOCKED", "TEST_DEFECT")
last = None
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if ev.get("type") != "text":
                continue
            part = ev.get("part", {})
            t = part.get("text", "")
            if isinstance(t, str):
                last = t
except Exception:
    last = None
if last is not None:
    m = re.findall(r"Status:\s*(" + "|".join(statuses) + ")", last)
    if m:
        print(m[-1])
PY
)
      if [ "$coder_status" = "TEST_DEFECT" ]; then
        "$SCRIPT_DIR/ledger-append" "$ledger" escalated "$task" \
          "TEST_DEFECT reported by Coder"
        echo "CODER-GATE: TEST_DEFECT - escalated, no further retries; B arbitrates" >&2
        exit 2
      fi
  fi

  passed=0
  if [ "$lang" = "flutter" ]; then
    if GREEN_GATE_REPORT="$report" "$FLUTTER_GATE" \
        -w "$ws" -t "$task" -b "$base" -l "$ledger" \
        -m "task $task green"; then
      passed=1
    fi
  else
    RUN_GATES_BIN="${RUN_GATES_BIN:-$SCRIPT_DIR/run-gates}"
    if "$RUN_GATES_BIN" "$ws" "$test_cmd" "$analyze_cmd"; then
      passed=1
    fi
  fi

  if [ "$passed" -eq 1 ]; then
    "$SCRIPT_DIR/ledger-append" "$ledger" coder_round "$task" \
      "Coder passed the gate" status=PASS

    if [ "$lang" != "flutter" ]; then
      # Flutter's green-gate owns the commit + Reviewer dispatch above. The
      # generic engine's run-gates deliberately never commits (it is a
      # check-only mirror) - Script A (this script) owns that step here.
      git add -A
      if git commit -m "task $task green" >/dev/null 2>&1; then
        sha=$(git rev-parse --short HEAD)
        "$SCRIPT_DIR/ledger-append" "$ledger" commit "$task" "green $sha" commits="$sha"
        pkg="$ws/task-$task-review-package.diff"
        "$SCRIPT_DIR/review-package" "$ws" "$base" HEAD "$pkg" "$task" || true
        DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"
        "$DISPATCH_BIN" --agent two-model-reviewer --task "$task" \
          --prompt-file "$pkg" --log "$ws/task-$task-reviewer.log" || true
      else
        echo "CODER-GATE: gate green but nothing to commit" >&2
      fi
    fi
    exit 0
  fi

  "$SCRIPT_DIR/ledger-append" "$ledger" coder_round "$task" \
    "Coder failed the gate" status=FAIL

  # No budget and no counting: loop until the gate passes. The only way out
  # besides green is TEST_DEFECT (checked at the top of the next iteration).

  # Build the fix prompt: purely mechanical (file paths + the static
  # coder-prompt.md retry framing) - no LLM needed to construct it.
  git diff > "$diff_file"
  cat > "$fix_prompt" << FIXEOF
# Fix — Task $task

A previous coder attempt did not satisfy the gate. Read these first:

- Prior diff (your uncommitted changes so far): $diff_file
- Gate failure output: $report
- Your original brief remains the authority: $brief

Fix the failure. You decide fresh what to keep from the prior diff; the
brief and RED tests are unchanged and still binding. Do not edit any test
file — if the failure indicates the test itself is wrong, report
TEST_DEFECT instead of changing it.

Report using the same status contract as before.
FIXEOF

  session=""
  [ -f "$ws/task-$task-session.txt" ] && session=$(cat "$ws/task-$task-session.txt")
  DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"

  if [ -n "$session" ]; then
    "$DISPATCH_BIN" --agent two-model-coder --task "$task" \
      --continue "$session" --prompt-file "$fix_prompt" --log "$log"
  else
    echo "CODER-GATE: no session recorded - dispatching fresh (context reset)" >&2
    "$DISPATCH_BIN" --agent two-model-coder --task "$task" \
      --prompt-file "$fix_prompt" --log "$log"
  fi
  # loop: re-check the gate on the resumed session's output.
done
