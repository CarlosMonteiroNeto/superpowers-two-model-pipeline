#!/usr/bin/env bash
# Append one structured entry to the pipeline's JSONL ledger.
#
# The ledger is written by the script from structured fields - never as
# free prose by an LLM. One JSON object per line; entries are append-only
# so recovery after compaction can trust the file's tail.
#
# Values are escaped for JSON (quotes, backslashes, control chars); keys
# must be bare identifiers. TASK is a task number, or '-' for branch-level
# entries (gate, final_review, merge).
#
# Usage: ledger-append [--task N] LEDGER_FILE TYPE TASK "SUMMARY" [KEY=VALUE ...]
# Example:
#   ledger-append ledger.jsonl review_outcome 3 "SEND_BACK" findings=2 severity=Critical
#   ledger-append --task 3 ledger.jsonl review_outcome 3 "SEND_BACK" findings=2
#
# Partitioning (route-next perf fix): when the entry belongs to a numeric
# task, the same JSON line is appended to BOTH the global LEDGER_FILE (kept
# for cross-task consumers: final-gate, holistic review) AND the per-task
# partition <ws>/ledger-task-<N>.jsonl (bounded hot path for route-next).
# Entries with TASK '-' (branch-level: gate, final_review, merge) go only to
# the global file. The --task flag overrides the partition key explicitly;
# otherwise the positional TASK is used when numeric. No schema change.
set -euo pipefail

partition_task=""
if [ "${1:-}" = "--task" ]; then
  [ $# -ge 6 ] || { echo "usage: ledger-append [--task N] LEDGER_FILE TYPE TASK \"SUMMARY\" [KEY=VALUE ...]" >&2; exit 2; }
  partition_task=$2
  shift 2
fi

if [ $# -lt 4 ]; then
  echo "usage: ledger-append [--task N] LEDGER_FILE TYPE TASK \"SUMMARY\" [KEY=VALUE ...]" >&2
  exit 2
fi

file=$1
type=$2
task=$3
summary=$4

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

extras=""
if [ $# -gt 4 ]; then
  for kv in "${@:5}"; do
    case "$kv" in
      *=*) ;;
      *) echo "not KEY=VALUE: $kv" >&2; exit 2 ;;
    esac
    k=${kv%%=*}
    v=${kv#*=}
    extras+=",\"$(json_escape "$k")\":\"$(json_escape "$v")\""
  done
fi

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
line=$(printf '{"ts":"%s","type":"%s","task":"%s","summary":"%s"%s}' \
  "$ts" \
  "$(json_escape "$type")" \
  "$(json_escape "$task")" \
  "$(json_escape "$summary")" \
  "$extras")
printf '%s\n' "$line" >> "$file"

# Per-task partition mirror. Explicit --task wins; otherwise mirror when the
# positional TASK is numeric. All existing call sites (red-gate, coder-gate,
# green-gate, orchestrator, resolve-toolchain) already pass the task number
# positionally, so they get the partition with no call-site change.
if [ -z "$partition_task" ]; then
  case "$task" in
    ''|*[!0-9]*) ;;
    *) partition_task=$task ;;
  esac
fi
case "$partition_task" in
  ''|*[!0-9]*|-) ;;
  *)
    task_file="$(dirname "$file")/ledger-task-${partition_task}.jsonl"
    printf '%s\n' "$line" >> "$task_file"
    ;;
esac

echo "ledgered: $type task=$task $summary"
