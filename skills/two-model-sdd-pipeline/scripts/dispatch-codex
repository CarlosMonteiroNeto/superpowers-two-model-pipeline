#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
if [ "$#" -ne 2 ] || [ "$1" != "--request" ] || [ ! -f "$2" ]; then
  echo "usage: dispatch-codex --request REQUEST.json" >&2; exit 2
fi
request=$2
runtime=${CODEX_RUNTIME_JSON:-}
if [ -z "$runtime" ] || [ ! -f "$runtime" ]; then echo "dispatch-codex: CODEX_RUNTIME_JSON must point to validated runtime envelope" >&2; exit 4; fi
PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$request" "$runtime" <<'PY'
import json, sys
import codex_dispatch
try:
    with open(sys.argv[1], encoding="utf-8") as f: request=json.load(f)
    with open(sys.argv[2], encoding="utf-8") as f: runtime=json.load(f)
    codex_dispatch.run_dispatch(request, runtime)
except Exception as exc:
    print("dispatch-codex: " + str(exc), file=sys.stderr)
    raise SystemExit(6)
PY
