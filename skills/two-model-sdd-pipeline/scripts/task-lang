#!/usr/bin/env bash
# Resolve the language declared by the exact task-selected toolchain gate.
# task-toolchain exposes the distinct toolchain_id when a caller needs it.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-lang WORKSPACE TASK [ROOT]" >&2
  exit 2
fi

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
exec python3 "$SCRIPT_DIR/toolchain_gate.py" task-lang "$1" "$2"
