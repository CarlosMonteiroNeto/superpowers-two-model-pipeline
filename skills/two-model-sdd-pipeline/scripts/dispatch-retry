#!/usr/bin/env bash
# Bounded retry wrapper for the headless dispatch launcher (ADR-0001/D11).
# Only an adapter-confirmed pre-start failure is retried. OpenCode confirms it
# with a wrapper-owned marker; raw worker exit code 5 is ambiguous. A provider
# timeout or dropped connection after a worker might have started remains
# ambiguous and must be reconciled instead of silently replayed.
#
# retryable = exit code 5, positively classified before worker start:
#   0  dispatched                - success, do not retry
#   2  usage / missing prompt    - caller bug, retrying would fail identically
#   3  wrong-agent refusal       - a mode: subagent definition; permanent
#   everything else              - ambiguous or terminal; preserve the result
#
# Usage: dispatch-retry <dispatch args...>
#   All arguments are forwarded verbatim to DISPATCH_BIN, so the wrapper is
#   a drop-in at every dispatch call site.
#
# Env:
#   DISPATCH_BIN             command to retry (default: this dir's dispatch)
#   DISPATCH_MAX_TRIES       total attempts before giving up (default: 3)
#   DISPATCH_RETRY_BACKOFF   seconds between attempts (default: 0)
#
# Exit codes: same as DISPATCH_BIN - the first permanent code, or the last
#             attempt's code when the retries are exhausted.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"
MAX_TRIES="${DISPATCH_MAX_TRIES:-3}"
BACKOFF="${DISPATCH_RETRY_BACKOFF:-0}"

# Codex retries only a failure positively classified before execution began.
# Codes 6 and all semantic/usage/interruption failures are ambiguous or final.
backend="opencode"
if [ "${1:-}" = "--backend" ]; then backend=${2:-}; fi
if [ "$backend" = "codex" ]; then MAX_TRIES=3; fi

args=("$@")

# --task/--log locate the ledger for the dispatch_retry records. The forwarded
# argument list is copied first and never modified.
task=""
log=""
agent=""
prompt=""
resume_session="-"
i=0
while [ $i -lt ${#args[@]} ]; do
  case "${args[$i]}" in
    --task) task=${args[$((i + 1))]:-}; i=$((i + 2)) ;;
    --log) log=${args[$((i + 1))]:-}; i=$((i + 2)) ;;
    --agent) agent=${args[$((i + 1))]:-}; i=$((i + 2)) ;;
    --prompt-file) prompt=${args[$((i + 1))]:-}; i=$((i + 2)) ;;
    --continue) resume_session=${args[$((i + 1))]:-}; i=$((i + 2)) ;;
    *) i=$((i + 1)) ;;
  esac
done

# One reservation covers this external operator invocation and any transport
# retries performed by this wrapper. Reviewers and directors never spend it.
if [ "$backend" = opencode ] && [[ "$agent" == two-model-coder* ]] && [ -n "$task" ] && [ -n "$log" ]; then
  budget_ws=$(dirname "$log")
fi

attempt=0
rc=1
while [ "$attempt" -lt "$MAX_TRIES" ]; do
  attempt=$((attempt + 1))
  if [ "$backend" = opencode ] && [[ "$agent" == two-model-coder* ]] && [ -n "$task" ] && [ -n "$log" ] && [ -f "$budget_ws/.pipeline-identity.json" ]; then
    python3 "$SCRIPT_DIR/dispatch_budget.py" reserve-opencode "$budget_ws" "$task" "$prompt" "$resume_session" \
      || { echo "DISPATCH-RETRY: coder dispatch budget requires director assessment" >&2; exit 7; }
  fi
  set +e
  marker=$(mktemp)
  rm -f "$marker"
  DISPATCH_PRESTART_MARKER="$marker" "$DISPATCH_BIN" "${args[@]}"
  rc=$?
  set -e
  prestart_confirmed=0
  if [ "$backend" = opencode ] && [ "$rc" -eq 5 ] && [ -f "$marker" ]; then prestart_confirmed=1; fi
  rm -f "$marker"
  if [ "$backend" = opencode ] && [[ "$agent" == two-model-coder* ]] && [ -n "$task" ] && [ -n "$log" ] && [ -f "$budget_ws/.pipeline-identity.json" ] && [ "$prestart_confirmed" -eq 1 ]; then
    python3 "$SCRIPT_DIR/dispatch_budget.py" release-opencode "$budget_ws" "$task" "$prompt" "$resume_session"
  fi
  if [ "$backend" = "codex" ]; then
    [ "$rc" -eq 5 ] || break
  else
    [ "$prestart_confirmed" -eq 1 ] || break
  fi
  [ "$attempt" -lt "$MAX_TRIES" ] || break
  # Ledger the failed attempt (best effort, like the rest of the retry): a
  # run that had to retry is observable state, not a silent in-memory decision.
  if [ -n "$task" ] && [ -n "$log" ]; then
    ledger_dir=$(dirname "$log")
    mkdir -p "$ledger_dir"
    "$SCRIPT_DIR/ledger-append" "$ledger_dir/ledger.jsonl" dispatch_retry "$task" \
      "dispatch attempt $attempt failed rc=$rc" >/dev/null 2>&1 || true
  fi
  if [ "$backend" = "codex" ]; then
    if [ "$attempt" -eq 1 ]; then sleep 1; else sleep 3; fi
  elif [ "$BACKOFF" -gt 0 ] 2>/dev/null; then
    sleep "$BACKOFF"
  fi
  echo "DISPATCH-RETRY: attempt $attempt failed (rc=$rc) - retrying (max $MAX_TRIES)" >&2
done

exit "$rc"
