#!/usr/bin/env python3
"""Deterministic RED-form classifier for the two-model pipeline.

Reads the Agente operador's saved machine-readable RED evidence
(<workspace>/task-<task>-red.txt) and decides whether it is a valid red:
the suite loaded, at least one test executed, and the run failed as an
assertion or a runtime error. A compile/load red with no executed test is
invalid. This is the script-side replacement for the expected_red grep: a
verdict by exit code, never an LLM judgment.

Per-language machine formats (spec §4):
  flutter/dart  `flutter test --machine` JSONL: a `testDone` with
                result=failure (assertion) or result=error (runtime) after a
                `testStart`. A suite-level error with no executed test is a
                compile/load red.
  python        `pytest --json-report` object: at least one test outcome
                failed/error. An empty tests list (collection error) is a
                compile/load red.
  go            `go test -json` JSONL: a per-test `run` action and a per-test
                `fail` action. A build failure (`build-fail`, no test) is a
                compile/load red.

Usage: red-form-check WORKSPACE TASK LANG
Exit codes: 0 = valid red; 1 = invalid red or missing evidence;
            2 = unsupported language or bad usage.
No LLM call: only file reads and pure JSON/string classification.
"""
import json
import os
import sys
from red_evidence import validate_evidence

SUPPORTED_LANGS = ("flutter", "dart", "python", "unittest", "go")


def iter_json_lines(text):
    """Yield the JSON objects of a JSONL document, skipping blank/malformed
    lines (runner streams may interleave non-JSON noise)."""
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict):
            yield event


def classify_flutter(text):
    """Valid red when a test loaded and a testDone reported failure/error."""
    test_started = False
    test_failed = False
    for event in iter_json_lines(text):
        kind = event.get("type")
        if kind == "testStart":
            test_started = True
        elif kind == "testDone" and event.get("result") in ("failure", "error"):
            test_failed = True
    return test_started and test_failed


def classify_python(text):
    """Valid red when the json-report carries at least one executed test that
    failed (assertion) or errored (runtime). A collection error has an empty
    tests list and is not a valid red."""
    try:
        report = json.loads(text)
    except ValueError:
        return False
    if not isinstance(report, dict):
        return False
    tests = report.get("tests")
    if not isinstance(tests, list) or not tests:
        return False
    return any(
        isinstance(test, dict) and test.get("outcome") in ("failed", "error")
        for test in tests
    )


def classify_unittest(text):
    """Accept a real unittest run only when an executed case failed/errored."""
    try:
        evidence = json.loads(text)
    except ValueError:
        return False
    if not isinstance(evidence, dict):
        return False
    tests = evidence.get("tests")
    if not isinstance(tests, list):
        return False
    tests_run = evidence.get("tests_run", len(tests))
    if not isinstance(tests_run, int) or tests_run < 1 or not tests:
        return False
    failures = evidence.get("failures") or []
    errors = evidence.get("errors") or []
    if not isinstance(failures, list) or not isinstance(errors, list):
        return False
    failed_ids = {str(item) for item in failures + errors}
    executed_ids = set()
    for test in tests:
        if not isinstance(test, dict):
            continue
        test_id = test.get("id") or test.get("test")
        if not test_id:
            continue
        outcome = str(test.get("outcome", "")).lower()
        if outcome in ("failure", "failed", "error"):
            failed_ids.add(str(test_id))
        if (outcome in ("passed", "success", "failure", "failed", "error")
                and "_FailedTest" not in str(test_id)):
            executed_ids.add(str(test_id))
    if not executed_ids:
        return False
    if failed_ids.intersection(executed_ids):
        return True
    return False


def classify_go(text):
    """Valid red when a named test ran and that test's action failed. Build
    failures carry no Test field and are ignored here."""
    test_started = False
    test_failed = False
    for event in iter_json_lines(text):
        if not event.get("Test"):
            continue
        action = event.get("Action")
        if action == "run":
            test_started = True
        elif action == "fail":
            test_failed = True
    return test_started and test_failed


CLASSIFIERS = {
    "flutter": classify_flutter,
    "dart": classify_flutter,
    "python": classify_python,
    "unittest": classify_unittest,
    "go": classify_go,
}


def main(argv):
    if len(argv) != 3:
        print("usage: red-form-check WORKSPACE TASK LANG", file=sys.stderr)
        return 2
    workspace, task, lang = argv
    classify = CLASSIFIERS.get(lang.lower())
    if classify is None:
        print(
            "RED-FORM-CHECK: unsupported language: %s (supported: %s)"
            % (lang, ", ".join(SUPPORTED_LANGS)),
            file=sys.stderr,
        )
        return 2
    evidence = os.path.join(workspace.rstrip("/\\"), "task-%s-red.txt" % task)
    if not os.path.isfile(evidence):
        print("RED-FORM-CHECK: missing evidence: %s" % evidence, file=sys.stderr)
        return 1
    try:
        with open(evidence, encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    except OSError as exc:
        print("RED-FORM-CHECK: cannot read evidence: %s" % exc, file=sys.stderr)
        return 1
    try:
        envelope = json.loads(text)
    except ValueError:
        envelope = None
    attempt_path = os.path.join(workspace.rstrip("/\\"), "task-%s-attempt.json" % task)
    identity_fields = ("task_id", "attempt_id", "toolchain_id", "runner", "command", "source_snapshot")
    if not os.path.isfile(attempt_path):
        print("RED-FORM-CHECK: missing current attempt identity: %s" % attempt_path,
              file=sys.stderr)
        return 1
    if not isinstance(envelope, dict) or not all(key in envelope for key in identity_fields):
        print("RED-FORM-CHECK: evidence is not bound to the current attempt", file=sys.stderr)
        return 1
    try:
        with open(attempt_path, encoding="utf-8") as handle:
            expected = json.load(handle)
    except (OSError, ValueError) as exc:
        print("RED-FORM-CHECK: invalid current attempt identity: %s" % exc, file=sys.stderr)
        return 1
    expected_adapters = {
        "flutter": {"flutter_machine", "flutter"},
        "dart": {"flutter_machine", "flutter"},
        "python": {"pytest_json_report", "pytest", "python"},
        "unittest": {"unittest"},
        "go": {"go_test_json", "go"},
    }
    if envelope.get("adapter") not in expected_adapters.get(lang.lower(), set()):
        print("RED-FORM-CHECK: evidence adapter does not match task language", file=sys.stderr)
        return 1
    result = validate_evidence(evidence, expected)
    if not result.get("valid_red"):
        print("RED-FORM-CHECK: invalid or stale RED evidence: %s" % result.get("error", "unknown"),
              file=sys.stderr)
        return 1
    print("RED-FORM-CHECK: valid red - executed test failed (%s)" % lang)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
