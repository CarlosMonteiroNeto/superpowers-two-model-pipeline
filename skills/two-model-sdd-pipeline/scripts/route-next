#!/usr/bin/env bash
# Deterministic next-action router for the two-model pipeline.
#
# Reads the ledger and emits the NEXT ACTION for a task - the review-to-next
# transition (and every earlier transition) becomes script judgment, never an
# LLM decision. The Orchestrator executes the emitted action; it never decides
# "APPROVED -> next task" or "SEND_BACK -> fix round" by reasoning.
#
# Usage: route-next WORKSPACE TASK [TOTAL_TASKS]
#   WORKSPACE   - the pipeline workspace (holds ledger.jsonl,
#                 ledger-task-<N>.jsonl partitions, plan.json)
#   TASK        - the task number to route
#   TOTAL_TASKS - optional; defaults to the task count in WORKSPACE/plan.json
#
# Reads only the per-task partition ledger-task-<TASK>.jsonl (O(this task)),
# falling back to the global ledger.jsonl with a one-time ledger-migrate
# split for pre-partition workspaces. FINAL_REVIEW stays a local
# task>=total check; project-wide aggregation stays on final-gate's global
# ledger read.
#
# Emits one line on stdout: ACTION [TASK] [ARGS...]
#   BRIEF N        -> B writes a JIT brief (+ RED tests)
#   RED N          -> dispatch operador + run red-gate chain
#   CODER N        -> (re)run coder-gate for the task: it retries until green
#   REVIEW N       -> build review package + dispatch the Reviewer
#   CORRECTIVE N   -> review SEND_BACK: B writes a corrective brief, C re-runs
#   ARBITRATE N    -> review ESCALATE or TEST_DEFECT escalation: B validates
#                     brief/test viability
#   NEXT N         -> task N-1 complete (APPROVED / task_complete)
#   FINAL_REVIEW   -> all tasks complete; whole-branch review (fresh /new session)
#
# Exit codes: 0 = routed, 1 = inconsistent state, 2 = usage / no ledger.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: route-next WORKSPACE TASK [TOTAL_TASKS]" >&2
  exit 2
fi

ws=$1
task=$2
ledger="$ws/ledger.jsonl"
task_ledger="$ws/ledger-task-$task.jsonl"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# Per-task partition hot path (O(this task), not O(project history)).
# Backward compat: on first call after upgrade the per-task file may not
# exist yet while the global ledger does - run the one-time split keyed by
# each entry's "task" field, best-effort. If migration is unavailable or
# yields nothing, fall back to grepping the global file so old workspaces
# keep routing identically.
if [ ! -f "$task_ledger" ] && [ -f "$ledger" ]; then
  if [ -x "$SCRIPT_DIR/ledger-migrate" ]; then
    "$SCRIPT_DIR/ledger-migrate" "$ws" >/dev/null 2>&1 || true
  fi
fi

if [ -f "$task_ledger" ]; then
  ledger_source="$task_ledger"
elif [ -f "$ledger" ]; then
  ledger_source="$ledger"
else
  echo "ROUTE-NEXT: no ledger: $ledger" >&2
  exit 2
fi

# TOTAL_TASKS: explicit arg, else plan.json task count.
total=${3:-}
if [ -z "$total" ]; then
  plan="$ws/plan.json"
  if [ -f "$plan" ]; then
    total=$(grep -c '"id"' "$plan" || true)
  fi
fi

# Gather this task's ledger entries, oldest first. From the per-task
# partition the file already holds only this task, so a straight read is
# O(this task). From the global fallback, filter by task id (tolerates the
# optional spaces of any JSON pretty-printer).
if [ "$ledger_source" = "$task_ledger" ]; then
  task_entries=$(cat "$task_ledger" || true)
else
  task_entries=$(grep -E '"task": *"'$task'"' "$ledger_source" || true)
fi

has_brief=$(printf '%s\n' "$task_entries" | grep -cE '"type": *"brief_ready"' || true)
has_red=$(printf '%s\n' "$task_entries" | grep -cE '"type": *"red_check"' || true)
has_commit=$(printf '%s\n' "$task_entries" | grep -cE '"type": *"commit"' || true)
has_escalated=$(printf '%s\n' "$task_entries" | grep -cE '"type": *"escalated"' || true)
has_complete=$(printf '%s\n' "$task_entries" | grep -cE '"type": *"task_complete"' || true)

# Last review outcome verdict, if any.
last_review=$(printf '%s\n' "$task_entries" | grep -E '"type": *"review_outcome"' | tail -1 || true)
review_verdict=$(printf '%s' "$last_review" | sed -n 's/.*"summary": *"\([^"]*\)".*/\1/p')

next_task=$((task + 1))

# NEXT vs FINAL_REVIEW needs the total task count. Require it at decision
# time, not earlier - BRIEF/RED/CODER/REVIEW/FIX never need it.
need_total() {
  [ -n "$total" ] || { echo "ROUTE-NEXT: TOTAL_TASKS (or plan.json) required to decide NEXT vs FINAL_REVIEW" >&2; exit 2; }
}

# Decision table (deterministic, ordered by state maturity).
if [ "$has_complete" -ge 1 ]; then
  need_total
  if [ "$task" -ge "$total" ]; then echo "FINAL_REVIEW"; else echo "NEXT $next_task"; fi
  exit 0
fi

if [ -n "$review_verdict" ]; then
  case "$review_verdict" in
    APPROVED)
      need_total
      if [ "$task" -ge "$total" ]; then echo "FINAL_REVIEW"; else echo "NEXT $next_task"; fi
      exit 0 ;;
    SEND_BACK)
      echo "CORRECTIVE $task"
      exit 0 ;;
    ESCALATE)
      echo "ARBITRATE $task"
      exit 0 ;;
    *)
      echo "ROUTE-NEXT: unknown review verdict: $review_verdict" >&2
      exit 1 ;;
  esac
fi

if [ "$has_escalated" -ge 1 ] && [ "$has_commit" -eq 0 ]; then
  echo "ARBITRATE $task"
  exit 0
fi

if [ "$has_commit" -ge 1 ]; then
  echo "REVIEW $task"
  exit 0
fi

# The operador loop is unbounded and uncounted: coder-gate retries until green,
# so any RED-verified task without a commit still routes to CODER. The only
# exits besides green are TEST_DEFECT (escalated, handled above) and review
# verdicts (handled above).
if [ "$has_red" -ge 1 ]; then
  echo "CODER $task"
  exit 0
fi

if [ "$has_brief" -ge 1 ]; then
  echo "RED $task"
  exit 0
fi

echo "BRIEF $task"
exit 0