#!/usr/bin/env python3
"""Mechanically scaffold a task brief from the plan (Script CEO, no LLM).

Reads task TASK from <WORKSPACE>/plan.json and writes
<WORKSPACE>/task-N-brief.md: statement, acceptance, spec refs, touches,
out-of-scope fence, and the RED-authorship order for Agente operador.
The order tells the operador to save the RED run in the runner's
machine-readable format and then implement (spec §4). expected_red is no longer read: a legacy
task that still carries it scaffolds unchanged. Overwrites an existing
brief for the same task (scaffolds are derived, never hand-edited).

Usage: brief-scaffold WORKSPACE TASK
Exit codes: 0 = scaffold written; 1 = plan unreadable;
            2 = usage / missing plan / task without required fields
               (title, summary, acceptance[]).
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pathclass import is_test_path  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
# The scoped runner the operador must use for its own test runs: it compresses
# the runner output (RTK) and writes the RED evidence where red-form-check
# reads it. Emitted as an absolute path so the operador's bash allowlist can
# permit this one path instead of the generic `cmd`.
RTK_RUN = os.path.normpath(
    os.path.join(HERE, "..", "..", "flutter-app-pipeline", "scripts", "rtk-run")
).replace("\\", "/")


def main(argv):
    if len(argv) != 2:
        print("usage: brief-scaffold WORKSPACE TASK", file=sys.stderr)
        return 2
    ws, task = argv
    # Forward slashes: the brief is pasted into a git-bash command line.
    ws_sh = ws.rstrip("/\\").replace("\\", "/")
    plan_path = ws.rstrip("/\\") + "/plan.json"
    try:
        with open(plan_path, encoding="utf-8", errors="replace") as fh:
            plan = json.load(fh)
    except (OSError, ValueError) as exc:
        print("BRIEF-SCAFFOLD: cannot read plan: %s" % exc, file=sys.stderr)
        return 1
    wanted = str(task)
    match = None
    for entry in plan.get("tasks", []):
        if str(entry.get("id")) == wanted:
            match = entry
            break
    if match is None:
        print("BRIEF-SCAFFOLD: no task %s in plan" % wanted, file=sys.stderr)
        return 2
    missing = [
        key for key in ("title", "summary", "acceptance")
        if not match.get(key)
    ]
    if missing:
        print(
            "BRIEF-SCAFFOLD: task %s lacks required fields: %s"
            % (wanted, ", ".join(missing)),
            file=sys.stderr,
        )
        return 2
    touches = match.get("touches", []) or []
    depends = match.get("depends_on", []) or []
    spec_refs = match.get("spec_refs", []) or []
    # B4 guard: RED-proof defines test files as `changed - touches`, so a
    # test path inside `touches` empties the set and fails every round.
    # Fail loudly here instead of looping downstream.
    bad_touches = [t for t in touches if is_test_path(t)]
    if bad_touches:
        print(
            "BRIEF-SCAFFOLD: task %s touches look like test files: %s "
            "(keep touches to implementation paths; RED tests are "
            "changed - touches)" % (wanted, ", ".join(bad_touches)),
            file=sys.stderr,
        )
        return 2
    lines = [
        "# Task %s Brief — %s (scaffolded from plan; transient)" % (wanted, match["title"]),
        "",
        "## Statement",
        "",
        match["summary"],
        "",
        "## Spec refs",
        "",
        *(("- `%s`" % ref) for ref in spec_refs),
        "",
        "## Touches",
        "",
        *(("- `%s`" % path) for path in touches),
        "",
        "## Depends on",
        "",
        *(("- task %s" % dep) for dep in depends),
        "",
        "## Acceptance",
        "",
        *(("- %s" % item) for item in match["acceptance"]),
        "",
        "## Out of scope",
        "",
        "Anything not listed under Acceptance (YAGNI fence).",
        "",
        "## RED order (you own the RED/GREEN loop)",
        "",
        "1. Write BLACK-BOX tests encoding Acceptance "
        "(skills/test-driven-development/writing-good-tests.md).",
        "2. RUN those tests yourself and save the RED evidence - the runner's "
        "machine-readable output - to `%s/task-%s-red.txt`; red-form-check "
        "reads it: the suite must load, at least one test must execute, and it "
        "must fail as an assertion or runtime error." % (ws_sh, wanted),
        "",
        "   OPTIONAL: the scoped runner does both for you (it compresses the "
        "output and writes that file):",
        "",
        "     %s --ws %s --task %s red <test-file...>" % (RTK_RUN, ws_sh, wanted),
        "",
        "   Or run the project's runner directly and redirect its "
        "machine-readable output to that path - your choice; neither is "
        "required over the other.",
        "3. Implement until YOUR tests pass. Running "
        "them through the scoped runner keeps their output compressed:",
        "",
        "     %s --ws %s --task %s test <test-file...>" % (RTK_RUN, ws_sh, wanted),
        "",
        "   Analysis, if you need it: `%s analyze`." % RTK_RUN,
        "4. coder-gate runs the authoritative full suite + analyze immediately "
        "after you report DONE, so you do not need to run the full suite "
        "yourself; run it only if you believe your change has cross-cutting "
        "impact beyond this task's files.",
        "",
    ]
    out_path = "%s/task-%s-brief.md" % (ws.rstrip("/\\"), wanted)
    try:
        with open(out_path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
    except OSError as exc:
        print("BRIEF-SCAFFOLD: cannot write brief: %s" % exc, file=sys.stderr)
        return 1
    print("BRIEF-SCAFFOLD: wrote %s" % out_path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
