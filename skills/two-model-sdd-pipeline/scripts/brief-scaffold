#!/usr/bin/env python3
"""Mechanically scaffold a task brief from the plan (Script CEO, no LLM).

Reads task TASK from <WORKSPACE>/plan.json and writes
<WORKSPACE>/task-N-brief.md: statement, acceptance, spec refs, touches,
out-of-scope fence, and the RED-authorship order for Agente operador.
The order tells the operador to save the RED run in the runner's
machine-readable format and then implement (spec §4). expected_red is no longer read: a legacy
task that still carries it scaffolds unchanged. Overwrites an existing
brief for the same task (scaffolds are derived, never hand-edited).

Usage: brief-scaffold WORKSPACE TASK
Exit codes: 0 = scaffold written; 1 = plan unreadable;
            2 = usage / missing plan / task without required fields
               (title, summary, acceptance[]).
"""
import json
import os
import pathlib
import re
import shlex
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pathclass import is_test_path  # noqa: E402
from graph_context import load_task_context  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
SCOPED_RUN = os.path.join(HERE, "scoped-run").replace("\\", "/")
GRAPH_CONTEXT_MAX_LINES = 100
GRAPH_CONTEXT_MAX_BYTES = 12_000
SAFE_REPO_PATH = re.compile(r"^[^\\\x00]+$")


def graph_context_lines(workspace, task):
    """Render only this task's validated, script-derived graph slice."""
    try:
        context = load_task_context(pathlib.Path(workspace), task)
    except Exception as exc:  # A brief remains deterministic and usable on fallback.
        context = {"complete": False, "requires_full_suite": True,
                   "diagnostics": ["task graph context unavailable: " + str(exc)]}

    def safe_paths(key):
        values = context.get(key, [])
        if not isinstance(values, list):
            return []
        accepted = []
        for value in values:
            if (isinstance(value, str) and value and SAFE_REPO_PATH.fullmatch(value)
                    and not value.startswith("/")
                    and not re.match(r"^[A-Za-z]:", value)
                    and all(part not in ("", ".", "..") for part in value.split("/"))):
                accepted.append(value)
        return sorted(set(accepted))

    complete = context.get("complete") is True and context.get("requires_full_suite") is not True
    lines = ["## Graph context (script-derived)", "",
             "Status: complete" if complete else "Status: unavailable; use the configured full suite"]
    for title, key in (("Dependencies", "dependencies"),
                       ("Consumers", "consumers"), ("Relevant tests", "tests")):
        lines.extend(["", "### " + title])
        values = safe_paths(key) if complete else []
        lines.extend(("- `%s`" % value) for value in values)
        if not values:
            lines.append("- (none)")
    diagnostics = context.get("diagnostics", [])
    if not complete and isinstance(diagnostics, list) and diagnostics:
        lines.extend(["", "Diagnostics: " + "; ".join(str(item) for item in diagnostics[:3])])

    # Keep both hard limits even when one individual path is unusually long.
    output = []
    byte_count = 0
    truncated = False
    for line in lines:
        encoded_size = len(line.encode("utf-8")) + (1 if output else 0)
        if len(output) >= GRAPH_CONTEXT_MAX_LINES - 1 or byte_count + encoded_size > GRAPH_CONTEXT_MAX_BYTES - 32:
            truncated = True
            break
        output.append(line)
        byte_count += encoded_size
    if truncated:
        marker = "[Graph context truncated to the configured brief limit.]"
        if len(output) >= GRAPH_CONTEXT_MAX_LINES:
            output = output[:GRAPH_CONTEXT_MAX_LINES - 1]
        output.append(marker)
    return output


def main(argv):
    if len(argv) != 2:
        print("usage: brief-scaffold WORKSPACE TASK", file=sys.stderr)
        return 2
    ws, task = argv
    # Prefer a path relative to the worker checkout when the workspace is
    # inside it. Besides being shorter, this keeps Windows sandbox writes
    # anchored beneath the active worktree when the brief is run verbatim.
    ws_raw = ws.rstrip("/\\")
    ws_sh = (ws_raw if os.path.isabs(ws_raw) else os.path.abspath(ws_raw)).replace("\\", "/")
    # Normalize 8.3 aliases (common in Git Bash -> native Python handoffs) on
    # both sides before comparing; otherwise an in-worktree path appears to
    # escape the checkout and falls back to a long absolute path.
    cwd = os.path.realpath(os.getcwd())
    canonical_ws = os.path.realpath(ws_sh)
    relative_ws = os.path.relpath(canonical_ws, cwd).replace("\\", "/")
    if relative_ws != ".." and not relative_ws.startswith("../") and not os.path.isabs(relative_ws):
        ws_command = relative_ws
    else:
        ws_command = ws_sh
    ws_arg = shlex.quote(ws_command)
    runner_arg = "bash " + shlex.quote(SCOPED_RUN)
    plan_path = ws.rstrip("/\\") + "/plan.json"
    try:
        with open(plan_path, encoding="utf-8", errors="replace") as fh:
            plan = json.load(fh)
    except (OSError, ValueError) as exc:
        print("BRIEF-SCAFFOLD: cannot read plan: %s" % exc, file=sys.stderr)
        return 1
    wanted = str(task)
    match = None
    for entry in plan.get("tasks", []):
        if str(entry.get("id")) == wanted:
            match = entry
            break
    if match is None:
        print("BRIEF-SCAFFOLD: no task %s in plan" % wanted, file=sys.stderr)
        return 2
    missing = [
        key for key in ("title", "summary", "acceptance")
        if not match.get(key)
    ]
    if missing:
        print(
            "BRIEF-SCAFFOLD: task %s lacks required fields: %s"
            % (wanted, ", ".join(missing)),
            file=sys.stderr,
        )
        return 2
    touches = match.get("touches", []) or []
    depends = match.get("depends_on", []) or []
    spec_refs = match.get("spec_refs", []) or []
    test_paths = (match.get("verification", {}) or {}).get("new_test_files", []) or []
    if not isinstance(test_paths, list) or not all(isinstance(path, str) for path in test_paths):
        print("BRIEF-SCAFFOLD: task %s verification.new_test_files must be a list of paths" % wanted,
              file=sys.stderr)
        return 2
    test_args = " ".join(shlex.quote(path.replace("\\", "/")) for path in test_paths)
    if not test_args:
        test_args = "<test-file...>"
    # B4 guard: RED-proof defines test files as `changed - touches`, so a
    # test path inside `touches` empties the set and fails every round.
    # Fail loudly here instead of looping downstream.
    bad_touches = [t for t in touches if is_test_path(t)]
    if bad_touches:
        print(
            "BRIEF-SCAFFOLD: task %s touches look like test files: %s "
            "(keep touches to implementation paths; RED tests are "
            "changed - touches)" % (wanted, ", ".join(bad_touches)),
            file=sys.stderr,
        )
        return 2
    lines = [
        "# Task %s Brief — %s (scaffolded from plan; transient)" % (wanted, match["title"]),
        "",
        "## Statement",
        "",
        match["summary"],
        "",
        "## Spec refs",
        "",
        *(("- `%s`" % ref) for ref in spec_refs),
        "",
        "## Touches",
        "",
        *(("- `%s`" % path) for path in touches),
        "",
        "## Depends on",
        "",
        *(("- task %s" % dep) for dep in depends),
        "",
        "## Acceptance",
        "",
        *(("- %s" % item) for item in match["acceptance"]),
        "",
        "## Out of scope",
        "",
        "Anything not listed under Acceptance (YAGNI fence).",
        "",
        *graph_context_lines(ws, match),
        "",
        "## RED order (you own the RED/GREEN loop)",
        "",
        "1. Write BLACK-BOX tests encoding Acceptance "
        "(skills/test-driven-development/writing-good-tests.md).",
        "2. RUN those tests yourself with the shared scoped command and save "
        "its machine-readable RED evidence to `%s/task-%s-red.txt`." % (ws_command, wanted),
        "   red-form-check accepts only a loaded suite with an executed test "
        "that fails as an assertion or runtime error.",
        "",
        "   OPTIONAL command shape: `red <test-file...>` captures full output, "
        "writes that evidence file, and renders a compact view.",
        "   Invoke the `scoped-run` entrypoint:",
        "",
        "     %s %s %s red %s" % (runner_arg, ws_arg, wanted, test_args),
        "",
        "3. Implement until YOUR tests pass. Run them through the same "
        "scoped command:",
        "",
        "     %s %s %s test %s" % (runner_arg, ws_arg, wanted, test_args),
        "",
        "   Analysis, if you need it: `%s %s %s analyze`." % (runner_arg, ws_arg, wanted),
        "4. coder-gate runs the authoritative full suite + analyze immediately "
        "after you report DONE, so you do not need to run the full suite "
        "yourself; run it only if you believe your change has cross-cutting "
        "impact beyond this task's files.",
        "",
    ]
    out_path = "%s/task-%s-brief.md" % (ws.rstrip("/\\"), wanted)
    try:
        with open(out_path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
    except OSError as exc:
        print("BRIEF-SCAFFOLD: cannot write brief: %s" % exc, file=sys.stderr)
        return 1
    print("BRIEF-SCAFFOLD: wrote %s" % out_path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
