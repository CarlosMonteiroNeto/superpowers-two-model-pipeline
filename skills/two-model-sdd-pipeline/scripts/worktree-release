#!/usr/bin/env bash
# Release a task worktree after its branch is merged into the integration HEAD.
# Never removes on failure (debugging parity with session-clean, write-script §7).
#
# Usage: worktree-release WORKSPACE TASK
# Exit codes: 0 = released, 1 = not merged / not found, 2 = usage.
#
# "Merged" requires the branch tip to be an ancestor of HEAD. A branch whose
# tip equals its allocation base recorded by worktree-alloc never committed:
# that is released only when the task's shard proves approval (an approved
# no-op task); an unapproved never-worked branch is kept as the debug copy.
# The branch tip is also released when it differs from the base and is an
# ancestor of HEAD (the ordinary merged case).
#
# Resource profile: dispatch none; stdout not LLM-facing; ledger I/O writes the
# integration global ledger; subprocess: git worktree remove/prune + branch -d +
# one ledger-append; wall-clock trivial; git removes a worktree and a branch.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: worktree-release WORKSPACE TASK" >&2
  exit 2
fi
ws=$1
task=$2
script_dir=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
owner_file="$ws/ownership/task-$task.json"
if [ -f "$owner_file" ]; then
  IFS=$'\t' read -r wt branch owner_run owner_base < <(python3 - "$owner_file" <<'PY'
import json, sys
o=json.load(open(sys.argv[1], encoding="utf-8"))
print("\t".join(str(o.get(k, "")) for k in ("worktree", "branch", "run_id", "base")))
PY
)
  wt=${wt//$'\r'/}; branch=${branch//$'\r'/}; owner_run=${owner_run//$'\r'/}; owner_base=${owner_base//$'\r'/}
  if ! python3 - "$owner_file" "$root" "$ws" "$task" "$script_dir" <<'PY'
import importlib.util, json, os, re, sys
owner_path, root, workspace, task, scripts = sys.argv[1:]
o=json.load(open(owner_path, encoding="utf-8"))
same=lambda a,b: os.path.normcase(os.path.realpath(a)) == os.path.normcase(os.path.realpath(b))
if (not same(o.get("repository_root", ""), root)
    or not same(o.get("workspace", ""), workspace)
    or str(o.get("task_id")) != task
    or not o.get("run_id") or not o.get("branch")):
    raise SystemExit(1)
identity_path=os.path.join(workspace, ".pipeline-identity.json")
if os.path.isfile(identity_path):
    record=json.load(open(identity_path, encoding="utf-8"))
    spec=importlib.util.spec_from_file_location("run_identity", os.path.join(scripts, "run_identity.py"))
    module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    expected=module.create_identity(record["repository_root"], record["plan_path"], record["run_id"])
    if any(expected[k] != record.get(k) for k in ("repository_id", "identity", "workspace_key", "run_id", "plan_path")):
        raise SystemExit(1)
    safe_run=re.sub(r"[^A-Za-z0-9._-]+", "-", expected["run_id"])
    expected_worktree=os.path.join(root, ".superpowers", "two-model", "worktrees",
                                   expected["workspace_key"], safe_run, "task-" + task)
    expected_branch="codex/pipeline/{}/{}/task-{}".format(expected["workspace_key"], safe_run, task)
    if (not same(record.get("repository_root", ""), root)
        or o.get("run_id") != expected["run_id"]
        or not same(o.get("worktree", ""), expected_worktree)
        or o.get("branch") != expected_branch):
        raise SystemExit(1)
PY
  then echo "WORKTREE-RELEASE: persisted worktree ownership does not match this run" >&2; exit 1; fi
  root_for_python="$root"
  if command -v cygpath >/dev/null 2>&1; then root_for_python=$(cygpath -w "$root"); fi
  if ! python3 - "$wt" "$root_for_python" <<'PY'
import os, sys
root=os.path.realpath(os.path.join(sys.argv[2], ".superpowers", "two-model", "worktrees"))
target=os.path.realpath(sys.argv[1])
try: valid=os.path.commonpath((root,target)) == root and target != root
except ValueError: valid=False
raise SystemExit(0 if valid else 1)
PY
  then echo "WORKTREE-RELEASE: persisted path is outside owned worktree root" >&2; exit 1; fi
else
  if [ -f "$ws/.pipeline-identity.json" ]; then
    echo "WORKTREE-RELEASE: canonical run has no persisted task ownership" >&2
    exit 1
  fi
  wt="$root/.superpowers/two-model/worktrees/task-$task"
  branch="task/$task"
  owner_run="legacy"
  owner_base=""
fi

wt_git="$wt"
if command -v cygpath >/dev/null 2>&1; then wt_git=$(cygpath -m "$wt"); fi
tip=$(git rev-parse --verify --quiet "refs/heads/$branch") || true
if [ -z "$tip" ]; then
  echo "WORKTREE-RELEASE: $branch not found - keeping worktree" >&2
  exit 1
fi

base=$(grep '"type": *"worktree_alloc"' "$ws/ledger.jsonl" 2>/dev/null \
  | grep "\"task\": *\"$task\"" | tail -1 \
  | sed -n 's/.*"base": *"\([^"]*\)".*/\1/p' || true)

if [ -z "$base" ] || ! git merge-base --is-ancestor "$tip" HEAD; then
  echo "WORKTREE-RELEASE: $branch is not merged into HEAD - keeping worktree" >&2
  exit 1
fi
if [ -n "$owner_base" ] && [ "$base" != "$owner_base" ]; then
  echo "WORKTREE-RELEASE: persisted allocation base does not match ledger - keeping worktree" >&2
  exit 1
fi

# A branch whose tip equals its allocation base never committed. That is fine
# ONLY for an approved no-op task (its shard holds `task_complete`); an
# unapproved never-worked branch is kept as the only debug copy.
if [ "$tip" = "$base" ]; then
  slug="${WS_SLUG:-$(basename "$ws")}"
  if [ -f "$owner_file" ]; then
    shard="$wt/.superpowers/two-model/$slug/ledger.jsonl"
  else
    shard="$root/.superpowers/two-model/worktrees/task-$task/.superpowers/two-model/$slug/ledger.jsonl"
  fi
  if ! grep -qE '"type": *"task_complete"' "$shard" 2>/dev/null; then
    echo "WORKTREE-RELEASE: $branch never committed and is not approved - keeping worktree" >&2
    exit 1
  fi
  noop_shard_rel=".superpowers/two-model/$slug/ledger.jsonl"
fi

registered_root=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null || true)
wt_real=$(cd "$wt" 2>/dev/null && pwd -P || true)
registered_real=$(cd "$registered_root" 2>/dev/null && pwd -P || true)
if [ -n "$wt_real" ] && [ "$wt_real" = "$registered_real" ]; then
  if [ -n "${noop_shard_rel:-}" ]; then
    git -C "$wt" diff --quiet && git -C "$wt" diff --cached --quiet || { echo "WORKTREE-RELEASE: dirty tracked worktree - keeping user changes" >&2; exit 1; }
    dirty=$(git -C "$wt" status --porcelain --untracked-files=all -- . ":(exclude)$noop_shard_rel") || { echo "WORKTREE-RELEASE: cannot verify worktree state" >&2; exit 1; }
  else
    dirty=$(git -C "$wt" status --porcelain) || { echo "WORKTREE-RELEASE: cannot verify worktree state" >&2; exit 1; }
  fi
  if [ -n "$dirty" ]; then
    echo "WORKTREE-RELEASE: dirty worktree - keeping user changes" >&2
    exit 1
  fi
  if [ -n "${noop_shard_rel:-}" ] && [ -f "$wt/$noop_shard_rel" ]; then
    rm -- "$wt/$noop_shard_rel"
    rmdir --ignore-fail-on-non-empty "$wt/.superpowers/two-model/$slug" \
      "$wt/.superpowers/two-model" "$wt/.superpowers" 2>/dev/null || true
  fi
  git worktree remove "$wt"
else
  echo "WORKTREE-RELEASE: owned worktree is missing - keeping branch and state" >&2
  exit 1
fi
git worktree prune
# Never swallow a failed delete: a false "released" hides a live branch.
if ! git branch -d "$branch"; then
  echo "WORKTREE-RELEASE: failed to delete $branch - not ledgering release" >&2
  exit 1
fi

"$script_dir/ledger-append" "$ws/ledger.jsonl" worktree_release "$task" \
  "released $branch" branch="$branch" run_id="$owner_run"
