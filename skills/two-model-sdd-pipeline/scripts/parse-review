#!/usr/bin/env bash
# Parse the Reviewer's verdict from an opencode JSONL event log.
#
# Usage: parse-review LOGFILE OUTFILE
#   LOGFILE   path to the reviewer's tee'd event log (task-N-reviewer.log)
#   OUTFILE   path to write the extracted verdict as pretty JSON
#
# Exit codes:
#   0  verdict extracted and written to OUTFILE
#   1  no verdict found (OUTFILE is NOT created)
#   2  usage error (missing arguments)
#
# This is a thin bash wrapper around parse_review.py.  The Python module
# contains the actual parsing logic and is importable for testing.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ $# -ne 2 ]; then
  echo "usage: parse-review LOGFILE OUTFILE" >&2
  exit 2
fi

python3 "$SCRIPT_DIR/parse_review.py" "$@"
