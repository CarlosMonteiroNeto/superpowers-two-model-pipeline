#!/usr/bin/env bash
# Read a gate ledger entry by exact toolchain identity.
#
# Usage: gate-entry-for WORKSPACE TOOLCHAIN_ID
# A missing, unknown, malformed, or duplicate identity is an infrastructure
# error. Never select the first/last language record as a fallback.
set -euo pipefail

if [ $# -ne 2 ] || [ -z "$2" ]; then
  echo "usage: gate-entry-for WORKSPACE TOOLCHAIN_ID" >&2
  exit 2
fi

python3 - "$1" "$2" <<'PY'
import json
import os
import sys

workspace, requested = sys.argv[1:]
ledger = os.path.join(workspace, "ledger.jsonl")
try:
    with open(ledger, encoding="utf-8") as stream:
        entries = [line.strip() for line in stream if line.strip()]
except OSError as exc:
    print("GATE-ENTRY-FOR: cannot read ledger: %s" % exc, file=sys.stderr)
    sys.exit(1)

matches = []
for line in entries:
    try:
        entry = json.loads(line)
    except ValueError:
        continue
    if (isinstance(entry, dict) and entry.get("type") == "gate"
            and entry.get("toolchain_id") == requested):
        matches.append(line)

if len(matches) != 1:
    reason = "no" if not matches else "multiple"
    print("GATE-ENTRY-FOR: %s gate entries for toolchain_id %s" %
          (reason, requested), file=sys.stderr)
    sys.exit(1)
print(matches[0])
PY
