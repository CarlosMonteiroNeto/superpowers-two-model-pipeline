#!/usr/bin/env bash
# Deterministic command runner with RTK-compressed LLM-facing stdout.
#
# Runs a command, writes its FULL output to --full-file (gates, escalation
# packages and round-2 context read the file - never the compressed view),
# prints the RTK-compressed output to stdout (what an LLM sees), and returns
# the command's TRUE exit code (RTK never decides a verdict).
#
# This is the generic wrapper the pipeline uses for every LLM-invoked
# command line, so no raw command output ever reaches an LLM context window
# uncompressed. Deterministic gates keep reading full files, so nothing they
# depend on (red-gate's EXPECTED-RED substring, escalation packages,
# red-integrity byte-compare) is ever compressed.
#
# Usage: cmd --full-file FILE -- COMMAND [ARGS...]
#   --full-file FILE   path to write the FULL unfiltered output
#   COMMAND [ARGS...]  the command to run
#
# Env:
#   RTK_ENABLED  set to "0" to disable RTK compression (plain passthrough)
#   RTK_BIN      override the rtk binary path (default: rtk)
#
# Exit codes: the command's own exit code; 2 = usage error.
set -euo pipefail

full_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --full-file)
      full_file="${2:-}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "cmd: unexpected argument: $1 (expected --full-file FILE -- CMD...)" >&2
      exit 2
      ;;
  esac
done

if [ -z "$full_file" ]; then
  echo "cmd: --full-file FILE is required" >&2
  exit 2
fi
if [ $# -eq 0 ]; then
  echo "cmd: no command given" >&2
  exit 2
fi

mkdir -p "$(dirname "$full_file")"

RTK_BIN="${RTK_BIN:-rtk}"
RTK_ENABLED="${RTK_ENABLED:-1}"

# Infer an RTK pipe filter for commands RTK compresses reliably. "" = no
# filter -> pass the full output through unchanged (nothing is ever lost).
# Commands are matched by basename so both PATH executables (`flutter`) and
# FLUTTER_BIN-style absolute paths to stubs/binaries behave identically.
cmd_base=$(basename "${1:-}")
filter=""
case "$cmd_base" in
  git)
    case "${2:-}" in
      status) filter="git-status" ;;
      diff)   filter="git-diff" ;;
      log)    filter="git-log" ;;
    esac
    ;;
  grep)   filter="grep" ;;
  rg)     filter="rg" ;;
  find)   filter="find" ;;
  pytest) filter="pytest" ;;
  go)     [ "${2:-}" = "test" ] && filter="go-test" ;;
esac

# RTK wrapper mode: Flutter commands have no pipe filter (verified: RTK rejects
# "flutter-test"). Instead RTK's command wrappers compress the output shape:
#   flutter test    -> rtk test  (show only failures)
#   flutter analyze -> rtk err   (show only errors/warnings)
# The wrapper cannot run the raw command itself without masking its exit code
# (verified: rtk test/err exit 0 even for a failing child), so `cmd` runs the
# raw command ONCE for the verdict + full file, then derives the compressed
# LLM-facing view from the FILE via the wrapper. This keeps the contract:
# verdict = raw command's exit code; full output always on disk; RTK failure
# can never turn a green command red (it only degrades the stdout view).
wrapper=""
case "$cmd_base" in
  flutter)
    case "${2:-}" in
      test)    wrapper="test" ;;
      analyze) wrapper="err" ;;
    esac
    ;;
esac

use_rtk=0
if [ "$RTK_ENABLED" != "0" ] \
    && command -v "$RTK_BIN" >/dev/null 2>&1; then
  use_rtk=1
fi

# Run once: full output teed to the file; the LLM-facing view is the RTK
# compressed derivation (or passthrough when RTK does not apply).
set +e
if [ "$use_rtk" = "1" ] && [ -n "$wrapper" ]; then
  "$@" > "$full_file" 2>&1
  rc=$?
  "$RTK_BIN" "$wrapper" -- cat "$full_file" 2>/dev/null || cat "$full_file"
elif [ "$use_rtk" = "1" ] && [ -n "$filter" ]; then
  "$@" 2>&1 | tee "$full_file" | "$RTK_BIN" pipe -f "$filter"
  rc=${PIPESTATUS[0]}
else
  "$@" 2>&1 | tee "$full_file"
  rc=${PIPESTATUS[0]}
fi
set -e

exit "$rc"
