#!/usr/bin/env bash
# Top-level Script CEO driver: invokable anywhere with a tracked plan file.
# Scaffolds the toolchain gate, then drives the plan either serially
# (--max-parallel 1) or in plan-derived waves (--max-parallel N>1, default 2).
# Serial: loop task-run (the per-task lifecycle, which itself loops the single
#   dispatch table orchestrator and owns the LLM-owned REVIEW/CORRECTIVE/
#   ARBITRATE branches) -> route-next advances the task until FINAL_REVIEW.
# Wave:   wave-next emits the next ready, touches-disjoint wave -> each task is
#   isolated by worktree-alloc and run by task-run inside its worktree ->
#   integrate folds the wave's branches into HEAD (per-merge full suite, per
#   task ledger shard). Integrate only merges an approved task (its shard
#   holds `task_complete`); an un-approved sibling is skipped and left for the
#   recovery. A failed integration gets ONE bounded re-integrate attempt in
#   the task's existing worktree - meaningful for an un-approved task (its
#   gate chain can still approve it), a no-op for a conflict/gate failure on
#   an approved one - then a second failure blocks for a human (never an
#   unbounded re-emit loop).
# Both paths converge on closing -> push+PR.
# No Agente estratégico in the loop: briefs are scaffolded, tasks come from
# Agente diretor, gates decide, revisor judges. Resumable: re-running on the
# same plan continues from the ledger (route-next/wave-next read state, never
# memory).
#
# Usage: run-pipeline PLAN_FILE [TOTAL] [--no-push] [--max-parallel N]
#   PLAN_FILE     tracked plan (docs/superpowers/plans/<name>-plan.json)
#   TOTAL         optional total task count (default: plan task count, live -
#                 corrective tasks appended mid-run are counted automatically)
#   --no-push     stop after the closing assessment (no push/PR) - also for tests
#   --max-parallel N  max tasks per wave (integer >= 1; default 2). N == 1 is
#                 the serial path (behavior-preserving: advances via
#                 route-next instead of first_incomplete, ledger sequence
#                 asserted by a regression test; no worktrees, no integrate).
#
# Env:
#   TASK_RUN_BIN  override the per-task loop (default: this dir's task-run)
#
# Exit codes: 0 = branch closed (pushed unless --no-push);
#             1 = blocked (blocker printed; fix + re-run continues);
#             2 = usage.
set -euo pipefail

# B6: force UTF-8 pipes so a latin-1 byte never poisons the ledger/logs.
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PLAN=""
TOTAL_ARG=""
NO_PUSH=0
MAX_PARALLEL=2
while [ $# -gt 0 ]; do
  case "$1" in
    --no-push) NO_PUSH=1; shift ;;
    --max-parallel)
      [ $# -ge 2 ] || { echo "usage: run-pipeline PLAN_FILE [TOTAL] [--no-push] [--max-parallel N]" >&2; exit 2; }
      MAX_PARALLEL=$2; shift 2 ;;
    --max-parallel=*) MAX_PARALLEL=${1#--max-parallel=}; shift ;;
    *)
      if [ -z "$PLAN" ]; then PLAN=$1; else TOTAL_ARG=$1; fi
      shift ;;
  esac
done
[ -n "$PLAN" ] || { echo "usage: run-pipeline PLAN_FILE [TOTAL] [--no-push] [--max-parallel N]" >&2; exit 2; }
[ -f "$PLAN" ] || { echo "RUN-PIPELINE: no plan file: $PLAN" >&2; exit 2; }
case "$TOTAL_ARG" in
  ""|*[!0-9]*) [ -z "$TOTAL_ARG" ] || { echo "RUN-PIPELINE: TOTAL must be numeric" >&2; exit 2; } ;;
esac
case "$MAX_PARALLEL" in
  ""|*[!0-9]*) echo "RUN-PIPELINE: --max-parallel must be an integer >= 1" >&2; exit 2 ;;
esac
[ "$MAX_PARALLEL" -ge 1 ] || { echo "RUN-PIPELINE: --max-parallel must be an integer >= 1" >&2; exit 2; }

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "RUN-PIPELINE: not in a git repo" >&2; exit 2; }
# Absolutize the plan BEFORE cd-ing: gates run git in the repo root, and a
# relative PLAN would dangle afterwards.
PLAN=$(python3 -c "import os,sys; print(os.path.abspath(sys.argv[1]))" "$PLAN")
cd "$ROOT" || { echo "RUN-PIPELINE: cannot cd to $ROOT" >&2; exit 2; }
# The tracked plan relative to the integration root. The wave path hands
# task-run the WORKTREE's copy of this tracked plan (see wave_plan), so a
# diretor corrective/arbitration edit lands in a tracked file instead of the
# worktree's gitignored workspace plan.json. `realpath` resolves both sides to
# the same spelling first: git prints `C:/Users/...` while native Python may
# print an 8.3 short name (`C:\Users\CARLOS~1\...`), and a raw prefix strip
# would silently miss.
PLAN_REL=$(python3 -c "import os,sys; print(os.path.relpath(os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2])))" "$PLAN" "$ROOT" 2>/dev/null || true)
PLAN_REL=${PLAN_REL//\\//}
case "$PLAN_REL" in
  ""|..*|/*) PLAN_REL="" ;;
esac
WS=$("$SCRIPT_DIR/pipeline-workspace" "$PLAN") || exit 2
# pipeline-workspace prints pwd in POSIX form (/c/...) on Git Bash, which
# native Windows Python cannot open - normalize once, here, for every
# python3 call below (bash itself accepts either form).
if command -v cygpath >/dev/null 2>&1; then
  WS=$(cygpath -w "$WS")
fi
LEDGER="$WS/ledger.jsonl"
DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"
# CODER_GATE is a legacy alias; the orchestrator and this script now share the
# single CODER_GATE_BIN name.
CODER_GATE_BIN="${CODER_GATE_BIN:-${CODER_GATE:-$SCRIPT_DIR/coder-gate}}"
FINAL_GATE_BIN="${FINAL_GATE_BIN:-$SCRIPT_DIR/final-gate}"
INTEGRATE_BIN="${INTEGRATE_BIN:-$SCRIPT_DIR/integrate}"
# RED_GATE_BIN is resolved by the orchestrator (env override wins, else
# lang-based from the ledger's `gate.lang`). Never initialize it empty here.

say() { echo "RUN-PIPELINE: $1"; }
block() { echo "RUN-PIPELINE: BLOCKED - $1" >&2; exit 1; }

ledger() { "$SCRIPT_DIR/ledger-append" "$LEDGER" "$@" || true; }

plan_json() {
  python3 - "$WS/plan.json" <<'PY'
import json, sys
print(json.dumps(json.load(open(sys.argv[1], encoding="utf-8", errors="replace"))))
PY
}

task_ids() {
  plan_json | python3 -c "import json,sys; [print(t.get('id')) for t in json.load(sys.stdin).get('tasks', [])]"
}

total_now() {
  if [ -n "$TOTAL_ARG" ]; then printf '%s' "$TOTAL_ARG"; return; fi
  task_ids | grep -c . || true
}

first_incomplete() {
  # NOTE: -c (not heredoc): inside a pipe, a heredoc would steal stdin and
  # this reader would parse its own program instead of plan_json's output.
  plan_json | python3 -c "
import json, sys
ledger = sys.argv[1]
plan = json.load(sys.stdin)
done = set()
try:
    fh = open(ledger, encoding='utf-8', errors='replace')
except OSError:
    fh = None
if fh is not None:
    with fh:
        for line in fh:
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get('type') == 'task_complete':
                done.add(str(e.get('task')))
ids = [t.get('id') for t in plan.get('tasks', [])]
for i in ids:
    if str(i) not in done:
        print(i)
        break
else:
    print(ids[-1] if ids else 1)
" "$LEDGER"
}

dispatch_task_generator() {
  # dispatch_task_generator PROMPT_FILE LOG_FILE ; always fresh. The
  # task-generator is punctual: one dispatch per corrective/arbitrate
  # episode and one for closing. No cross-task (or cross-branch) session is
  # ever resumed.
  "$DISPATCH_BIN" --agent two-model-task-generator --task 0 \
    --prompt-file "$1" --log "$2"
}

tasks_usable() {
  plan_json | python3 -c "
import json, sys
tasks = json.load(sys.stdin).get('tasks', [])
ok = bool(tasks) and all(t.get('acceptance') for t in tasks)
sys.exit(0 if ok else 1)
"
}

failed_ids() {
  # Emit (ascending) every task whose newest `integration_failed` postdates
  # its newest completion (`task_complete`/`integrated`), or that has a
  # failure and no completion at all. These are exactly the tasks the bounded
  # recovery must re-open after a non-zero integrate.
  # NOTE: `python3 -c` (not a heredoc): this never feeds a pipe, but the
  # codebase rule for git-bash Windows is to avoid stdin-owning heredocs.
  python3 -c "
import json, sys
ledger_path, plan_path = sys.argv[1], sys.argv[2]
try:
    with open(plan_path, encoding='utf-8', errors='replace') as fh:
        order = [str(t.get('id')) for t in json.load(fh).get('tasks', [])]
except Exception:
    order = []
last_close, last_fail = {}, {}
try:
    with open(ledger_path, encoding='utf-8', errors='replace') as fh:
        for i, line in enumerate(fh):
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except Exception:
                continue
            t = str(e.get('task'))
            ty = e.get('type')
            if ty in ('task_complete', 'integrated'):
                last_close[t] = i
            elif ty == 'integration_failed':
                last_fail[t] = i
except OSError:
    pass
failed = [t for t in order
          if t in last_fail and last_fail[t] > last_close.get(t, -1)]
failed += [t for t in last_fail if t not in order]
seen, out = set(), []
for t in failed:
    if t not in seen:
        seen.add(t)
        out.append(t)
def key(x):
    return (int(x) if x.lstrip('-').isdigit() else 0, x)
out.sort(key=key)
for t in out:
    print(t)
" "$LEDGER" "$WS/plan.json" | tr -d '\r'
}

wave_plan() {
  # wave_plan WORKTREE ; print the worktree-resident tracked plan path. The
  # diretor edits the plan path it is given, so a corrective/arbitration must
  # be pointed at the WORKTREE's tracked copy (committed by that task's gate
  # chain) rather than the worktree's gitignored workspace plan.json, whose
  # edits are lost. Falls back to $PLAN when it is not under the root.
  if [ -n "$PLAN_REL" ]; then
    printf '%s/%s' "$1" "$PLAN_REL"
  else
    printf '%s' "$PLAN"
  fi
}

# --- toolchain gate entry (once per branch) ---
if ! grep -qE '"type": *"gate"' "$LEDGER" 2>/dev/null; then
  say "no gate entry - resolving toolchain"
  "$SCRIPT_DIR/resolve-toolchain" "$WS" "$ROOT" \
    || block "resolve-toolchain needs a human (ambiguous/unknown toolchain)"
fi

# --- plan completeness (no EXPAND: brainstorming owns task authoring) ---
tasks_usable || block "plan has no usable tasks (every task needs acceptance) - complete it before running"

# --- main loop ---
# The per-task lifecycle (orchestrator + REVIEW/CORRECTIVE/ARBITRATE) lives in
# task-run, shared by the serial runner and the wave path (the H2 lesson:
# never two copies of the routing logic). This driver owns only task advance.
# Serial (MAX_PARALLEL == 1): after a task completes, route-next reads the
# ledger (never memory) and decides NEXT vs FINAL_REVIEW, so a re-run on the
# same plan resumes correctly; no worktrees, no integrate.
# Wave (MAX_PARALLEL > 1): wave-next computes the next ready, touches-disjoint
# wave from plan + ledger; each task runs in its own worktree in parallel;
# integrate merges the wave and the loop re-derives. Integrate skips a task
# whose shard lacks `task_complete` (`integration_failed not approved`), so a
# committed-but-unapproved sibling never lands. A non-zero integrate gets ONE
# bounded re-integrate attempt per failed task in that task's existing
# worktree, then re-integrates it alone; a second failure is a human blocker.
# The attempt is meaningful for the un-approved case (its gate chain can still
# approve it); for a conflict/gate failure on an approved task, task-run
# no-ops (the worktree ledger already holds task_complete), so the blocker is
# the outcome - a re-emitted failed task cannot self-heal.
if [ "$MAX_PARALLEL" -eq 1 ]; then
  task=$(first_incomplete)
  while true; do
    total=$(total_now)
    rc=0
    task_run_bin="${TASK_RUN_BIN:-$SCRIPT_DIR/task-run}"
    PLAN="$PLAN" "$task_run_bin" "$WS" "$task" "$total" || rc=$?
    case "$rc" in
      0) ;;
      1) block "task $task blocked (inspect task-$task logs)";;
      *) block "task-run exit $rc on task $task";;
    esac
    action=$("$SCRIPT_DIR/route-next" "$WS" "$task" "$total") \
      || block "route-next inconsistent after task $task"
    say "$action"
    case "$action" in
      NEXT\ *) task=${action#NEXT } ;;
      FINAL_REVIEW*) break ;;
      *) block "unexpected action after completed task $task: $action" ;;
    esac
  done
else
  while true; do
    rc=0
    wave=$("$SCRIPT_DIR/wave-next" "$WS" "$MAX_PARALLEL") || rc=$?
    if [ "$rc" -ne 0 ]; then
      [ "$rc" -eq 1 ] && block "wave-next: nothing runnable (WAVE_EMPTY)"
      block "wave-next exit $rc"
    fi
    case "$wave" in
      FINAL_REVIEW*) break ;;
    esac
    ids=$(printf '%s\n' "$wave" | sed -n 's/^RUN //p')
    [ -n "$ids" ] || block "wave-next emitted neither RUN ids nor FINAL_REVIEW"
    say "wave: RUN $ids"
    declare -A wt_of=()
    declare -A wsws_of=()
    for n in $ids; do
      rc=0
      out=$("$SCRIPT_DIR/worktree-alloc" "$WS" "$n") || rc=$?
      # A failed alloc (1 = already allocated, 2 = usage) is a blocker, never a
      # half-launched task: do not background a task whose worktree is absent.
      [ "$rc" -eq 0 ] || block "worktree-alloc task $n (rc=$rc)"
      wt_of[$n]=$(printf '%s\n' "$out" | sed -n 's/^WORKTREE=//p')
      wsws_of[$n]=$(printf '%s\n' "$out" | sed -n 's/^WS=//p')
      [ -n "${wt_of[$n]}" ] && [ -n "${wsws_of[$n]}" ] \
        || block "worktree-alloc task $n printed no WORKTREE=/WS="
    done
    for n in $ids; do
      total=$(total_now)
      plan_task=$(wave_plan "${wt_of[$n]}")
      # Capture each background task-run's exit code: a bare `wait` returns 0
      # even when a background job failed, so without this a committed-but-
      # unapproved task is invisible until integrate skips it. The rc is only
      # reported; integrate (and the bounded recovery below) owns the verdict.
      (
        rc=0
        cd "${wt_of[$n]}" || rc=$?
        if [ "$rc" -eq 0 ]; then
          PLAN="$plan_task" "$SCRIPT_DIR/task-run" "${wsws_of[$n]}" "$n" "$total" \
            >"$WS/task-$n-run.log" 2>&1 || rc=$?
        fi
        printf '%s\n' "$rc" >"$WS/task-$n-run.rc"
      ) &
    done
    wait
    for n in $ids; do
      rc=$(cat "$WS/task-$n-run.rc" 2>/dev/null || true)
      rc=$(printf '%s' "$rc" | tr -cd '0-9')
      [ -n "$rc" ] || rc=0
      [ "$rc" -eq 0 ] || say "task $n task-run exited rc=$rc"
    done
    int_rc=0
    "$INTEGRATE_BIN" "$WS" $ids || int_rc=$?
    if [ "$int_rc" -ne 0 ]; then
      # Bounded integration-failure recovery: a single re-integrate attempt per
      # failed task in its existing worktree. It is meaningful for an
      # un-approved task (its gate chain can still approve it and then the
      # re-merge can land); for a conflict/gate failure on an approved task
      # task-run no-ops (route-next's has_complete wins), so a second failure
      # is a bounded human blocker - never an unbounded loop.
      failed=$(failed_ids) || true
      [ -n "$failed" ] \
        || block "integrate rc=$int_rc but no task has an integration_failed entry"
      say "integration failed for: $failed - one re-integrate attempt each"
      for n in $failed; do
        rc=0
        out=$("$SCRIPT_DIR/worktree-alloc" "$WS" "$n") || rc=$?
        # 0 = fresh, 1 = reuse the worktree integrate kept (it never releases
        # on failure); anything else is a real blocker.
        if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
          block "worktree-alloc task $n (rc=$rc) during recovery"
        fi
        wt=$(printf '%s\n' "$out" | sed -n 's/^WORKTREE=//p')
        wt_ws=$(printf '%s\n' "$out" | sed -n 's/^WS=//p')
        [ -n "$wt" ] && [ -n "$wt_ws" ] \
          || block "worktree-alloc task $n printed no WORKTREE=/WS= (recovery)"
        # No episode is injected (controller ruling): route-next's has_complete
        # rule fires before its SEND_BACK rule, so an injected SEND_BACK would
        # be inert - and after a successful re-integrate it would be folded
        # into the global ledger and poison final-gate ("last review
        # unresolved: SEND_BACK"). The task's real history stays untouched.
        total=$(total_now)
        plan_task=$(wave_plan "$wt")
        rc=0
        ( cd "$wt" && PLAN="$plan_task" "$SCRIPT_DIR/task-run" "$wt_ws" "$n" "$total" ) \
          >"$WS/task-$n-recovery.log" 2>&1 || rc=$?
        [ "$rc" -eq 0 ] || block "task $n recovery task-run exit $rc"
        rc=0
        "$INTEGRATE_BIN" "$WS" "$n" || rc=$?
        [ "$rc" -eq 0 ] \
          || block "task $n still fails integration after one corrective"
        say "task $n recovered and integrated"
      done
    fi
  done
fi

# --- closing ---
total=$(total_now)
"$FINAL_GATE_BIN" "$WS" "$total" || block "final-gate lists blockers above"
cd "$ROOT" || block "cannot cd to $ROOT"
base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-list --max-parents=0 HEAD)
"$SCRIPT_DIR/review-package" "$WS" "$base" HEAD "$WS/closing-review.diff" \
  || block "review-package failed"
spec_doc=$(plan_json | python3 -c "import json,sys; print(json.load(sys.stdin).get('spec_doc',''))")
{
  echo "Mode: CLOSING. Diff: $WS/closing-review.diff. Ledger: $LEDGER."
  echo "Plan: $PLAN."
  echo "Spec: ${spec_doc:-none (skip coverage, note it)}."
  echo "Assess: open risks, parked minors triage, follow-ups. Reply with the assessment."
} > "$WS/diretor-closing.md"
dispatch_task_generator "$WS/diretor-closing.md" "$WS/task-generator-closing.log" \
  || block "diretor dispatch failed"
ledger final_review "-" "diretor closing complete"
"$SCRIPT_DIR/doc-check" "$ROOT" || block "update README.txt and README-LLM.md, then re-run"

if [ "$NO_PUSH" -eq 1 ]; then
  say "closing complete (--no-push): package $WS/closing-review.diff, assessment $WS/task-generator-closing.log"
  exit 0
fi
branch=$(git branch --show-current) || block "cannot determine branch"
[ -n "$branch" ] || block "detached HEAD - push manually"
git push -u origin "$branch" || block "push rejected - investigate, force-push only on explicit request"
if command -v gh >/dev/null 2>&1; then
  gh pr create --fill --base main 2>/dev/null \
    || say "push done; gh pr create failed - create the PR manually"
else
  say "push done; gh not installed - create the PR manually"
fi
say "branch closed"
exit 0
