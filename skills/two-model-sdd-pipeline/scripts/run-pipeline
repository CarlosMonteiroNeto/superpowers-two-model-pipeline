#!/usr/bin/env bash
# Top-level Script CEO driver: invokable anywhere with a tracked plan file.
# Scaffolds the toolchain gate, then loops task-run (the per-task lifecycle,
# which itself loops the single dispatch table orchestrator and owns the
# LLM-owned REVIEW/CORRECTIVE/ARBITRATE branches) -> route-next advances the
# task until FINAL_REVIEW -> closing -> push+PR.
# No Agente estratégico in the loop: briefs are scaffolded, tasks come from
# Agente diretor, gates decide, revisor judges. Resumable: re-running on the
# same plan continues from the ledger (route-next reads state, never memory).
#
# Usage: run-pipeline PLAN_FILE [TOTAL] [--no-push]
#   PLAN_FILE  tracked plan (docs/superpowers/plans/<name>-plan.json)
#   TOTAL      optional total task count (default: plan task count, live -
#              corrective tasks appended mid-run are counted automatically)
#   --no-push  stop after the closing assessment (no push/PR) - also for tests
#
# Env:
#   TASK_RUN_BIN  override the per-task loop (default: this dir's task-run)
#
# Exit codes: 0 = branch closed (pushed unless --no-push);
#             1 = blocked (blocker printed; fix + re-run continues);
#             2 = usage.
set -euo pipefail

# B6: force UTF-8 pipes so a latin-1 byte never poisons the ledger/logs.
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PLAN=""
TOTAL_ARG=""
NO_PUSH=0
for arg in "$@"; do
  case "$arg" in
    --no-push) NO_PUSH=1 ;;
    *)
      if [ -z "$PLAN" ]; then PLAN=$arg; else TOTAL_ARG=$arg; fi
      ;;
  esac
done
[ -n "$PLAN" ] || { echo "usage: run-pipeline PLAN_FILE [TOTAL] [--no-push]" >&2; exit 2; }
[ -f "$PLAN" ] || { echo "RUN-PIPELINE: no plan file: $PLAN" >&2; exit 2; }
case "$TOTAL_ARG" in
  ""|*[!0-9]*) [ -z "$TOTAL_ARG" ] || { echo "RUN-PIPELINE: TOTAL must be numeric" >&2; exit 2; } ;;
esac

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "RUN-PIPELINE: not in a git repo" >&2; exit 2; }
# Absolutize the plan BEFORE cd-ing: gates run git in the repo root, and a
# relative PLAN would dangle afterwards.
PLAN=$(python3 -c "import os,sys; print(os.path.abspath(sys.argv[1]))" "$PLAN")
cd "$ROOT" || { echo "RUN-PIPELINE: cannot cd to $ROOT" >&2; exit 2; }
WS=$("$SCRIPT_DIR/pipeline-workspace" "$PLAN") || exit 2
# pipeline-workspace prints pwd in POSIX form (/c/...) on Git Bash, which
# native Windows Python cannot open - normalize once, here, for every
# python3 call below (bash itself accepts either form).
if command -v cygpath >/dev/null 2>&1; then
  WS=$(cygpath -w "$WS")
fi
LEDGER="$WS/ledger.jsonl"
DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/dispatch}"
# CODER_GATE is a legacy alias; the orchestrator and this script now share the
# single CODER_GATE_BIN name.
CODER_GATE_BIN="${CODER_GATE_BIN:-${CODER_GATE:-$SCRIPT_DIR/coder-gate}}"
FINAL_GATE_BIN="${FINAL_GATE_BIN:-$SCRIPT_DIR/final-gate}"
# RED_GATE_BIN is resolved by the orchestrator (env override wins, else
# lang-based from the ledger's `gate.lang`). Never initialize it empty here.

say() { echo "RUN-PIPELINE: $1"; }
block() { echo "RUN-PIPELINE: BLOCKED - $1" >&2; exit 1; }

ledger() { "$SCRIPT_DIR/ledger-append" "$LEDGER" "$@" || true; }

plan_json() {
  python3 - "$WS/plan.json" <<'PY'
import json, sys
print(json.dumps(json.load(open(sys.argv[1], encoding="utf-8", errors="replace"))))
PY
}

task_ids() {
  plan_json | python3 -c "import json,sys; [print(t.get('id')) for t in json.load(sys.stdin).get('tasks', [])]"
}

total_now() {
  if [ -n "$TOTAL_ARG" ]; then printf '%s' "$TOTAL_ARG"; return; fi
  task_ids | grep -c . || true
}

first_incomplete() {
  # NOTE: -c (not heredoc): inside a pipe, a heredoc would steal stdin and
  # this reader would parse its own program instead of plan_json's output.
  plan_json | python3 -c "
import json, sys
ledger = sys.argv[1]
plan = json.load(sys.stdin)
done = set()
try:
    fh = open(ledger, encoding='utf-8', errors='replace')
except OSError:
    fh = None
if fh is not None:
    with fh:
        for line in fh:
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get('type') == 'task_complete':
                done.add(str(e.get('task')))
ids = [t.get('id') for t in plan.get('tasks', [])]
for i in ids:
    if str(i) not in done:
        print(i)
        break
else:
    print(ids[-1] if ids else 1)
" "$LEDGER"
}

dispatch_task_generator() {
  # dispatch_task_generator PROMPT_FILE LOG_FILE ; always fresh. The
  # task-generator is punctual: one dispatch per corrective/arbitrate
  # episode and one for closing. No cross-task (or cross-branch) session is
  # ever resumed.
  "$DISPATCH_BIN" --agent two-model-task-generator --task 0 \
    --prompt-file "$1" --log "$2"
}

tasks_usable() {
  plan_json | python3 -c "
import json, sys
tasks = json.load(sys.stdin).get('tasks', [])
ok = bool(tasks) and all(t.get('acceptance') for t in tasks)
sys.exit(0 if ok else 1)
"
}

# --- toolchain gate entry (once per branch) ---
if ! grep -qE '"type": *"gate"' "$LEDGER" 2>/dev/null; then
  say "no gate entry - resolving toolchain"
  "$SCRIPT_DIR/resolve-toolchain" "$WS" "$ROOT" \
    || block "resolve-toolchain needs a human (ambiguous/unknown toolchain)"
fi

# --- plan completeness (no EXPAND: brainstorming owns task authoring) ---
tasks_usable || block "plan has no usable tasks (every task needs acceptance) - complete it before running"

# --- main loop ---
# The per-task lifecycle (orchestrator + REVIEW/CORRECTIVE/ARBITRATE) lives in
# task-run, shared by the serial runner and the wave path (the H2 lesson:
# never two copies of the routing logic). This driver owns only task advance:
# after a task completes, route-next reads the ledger (never memory) and
# decides NEXT vs FINAL_REVIEW, so a re-run on the same plan resumes correctly.
task=$(first_incomplete)
while true; do
  total=$(total_now)
  rc=0
  task_run_bin="${TASK_RUN_BIN:-$SCRIPT_DIR/task-run}"
  PLAN="$PLAN" "$task_run_bin" "$WS" "$task" "$total" || rc=$?
  case "$rc" in
    0) ;;
    1) block "task $task blocked (inspect task-$task logs)";;
    *) block "task-run exit $rc on task $task";;
  esac
  action=$("$SCRIPT_DIR/route-next" "$WS" "$task" "$total") \
    || block "route-next inconsistent after task $task"
  say "$action"
  case "$action" in
    NEXT\ *) task=${action#NEXT } ;;
    FINAL_REVIEW*) break ;;
    *) block "unexpected action after completed task $task: $action" ;;
  esac
done

# --- closing ---
total=$(total_now)
"$FINAL_GATE_BIN" "$WS" "$total" || block "final-gate lists blockers above"
cd "$ROOT" || block "cannot cd to $ROOT"
base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-list --max-parents=0 HEAD)
"$SCRIPT_DIR/review-package" "$WS" "$base" HEAD "$WS/closing-review.diff" \
  || block "review-package failed"
spec_doc=$(plan_json | python3 -c "import json,sys; print(json.load(sys.stdin).get('spec_doc',''))")
{
  echo "Mode: CLOSING. Diff: $WS/closing-review.diff. Ledger: $LEDGER."
  echo "Plan: $PLAN."
  echo "Spec: ${spec_doc:-none (skip coverage, note it)}."
  echo "Assess: open risks, parked minors triage, follow-ups. Reply with the assessment."
} > "$WS/diretor-closing.md"
dispatch_task_generator "$WS/diretor-closing.md" "$WS/task-generator-closing.log" \
  || block "diretor dispatch failed"
ledger final_review "-" "diretor closing complete"
"$SCRIPT_DIR/doc-check" "$ROOT" || block "update README.txt and README-LLM.md, then re-run"

if [ "$NO_PUSH" -eq 1 ]; then
  say "closing complete (--no-push): package $WS/closing-review.diff, assessment $WS/task-generator-closing.log"
  exit 0
fi
branch=$(git branch --show-current) || block "cannot determine branch"
[ -n "$branch" ] || block "detached HEAD - push manually"
git push -u origin "$branch" || block "push rejected - investigate, force-push only on explicit request"
if command -v gh >/dev/null 2>&1; then
  gh pr create --fill --base main 2>/dev/null \
    || say "push done; gh pr create failed - create the PR manually"
else
  say "push done; gh not installed - create the PR manually"
fi
say "branch closed"
exit 0
