#!/usr/bin/env bash
# Deterministic session cleanup for completed tasks: deletes the opencode
# sessions recorded by `dispatch` so headless subagent runs never pollute the
# interactive session history. Best-effort by design - a session that is
# already gone is not an error, and the record files are removed regardless.
#
# Usage: session-clean WORKSPACE TASK|all
#   WORKSPACE  - pipeline workspace (holds task-N-*-session.txt records)
#   TASK       - task number to clean, or 'all' (every task record in the ws)
#
# Env: OPENCODE_BIN (default opencode)
# Exit codes: 0 = done (best-effort); 2 = usage / no workspace.
set -u

if [ $# -lt 2 ] || [ $# -gt 4 ]; then
  echo "usage: session-clean WORKSPACE TASK|all [--backend codex]" >&2
  exit 2
fi

ws=$1
task=$2
if [ "${3:-}" = "--backend" ] && [ "${4:-}" = "codex" ]; then
  retention="${CODEX_RETENTION_DAYS:-30}"
  case "$retention" in *[!0-9]*|'') echo "SESSION-CLEAN: invalid CODEX_RETENTION_DAYS" >&2; exit 2 ;; esac
  python3 - "$ws" "$task" "$retention" <<'PY'
import datetime, json, pathlib, shutil, sys
root=pathlib.Path(sys.argv[1]).resolve(); task=sys.argv[2]; days=int(sys.argv[3])
records=root/".superpowers"/"sessions"
if not records.exists(): raise SystemExit(0)
cutoff=datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(days=days)
for path in records.glob("*.json"):
    try: item=json.loads(path.read_text(encoding="utf-8"))
    except Exception: continue
    ident=item.get("identity", {})
    if task != "all" and str(ident.get("task_id")) != task: continue
    if item.get("status") != "completed": continue
    stamp=item.get("completed_at")
    try: completed=datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except Exception: continue
    if completed > cutoff: continue
    evidence=item.get("evidence_dir")
    if evidence:
        target=pathlib.Path(evidence).resolve()
        try: target.relative_to(root)
        except ValueError:
            print("SESSION-CLEAN: refusing evidence outside workspace", file=sys.stderr); continue
        if target.is_dir(): shutil.rmtree(target)
    path.unlink()
    print("SESSION-CLEAN: expired local Codex record/evidence; provider session deletion is unsupported")
PY
  exit $?
fi
if [ $# -ne 2 ]; then echo "SESSION-CLEAN: invalid backend selection" >&2; exit 2; fi
OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

[ -d "$ws" ] || { echo "SESSION-CLEAN: no workspace: $ws" >&2; exit 2; }

# task-N-*session.txt matches both the generic record (task-N-session.txt,
# last writer, read by B for resume) and the per-agent records
# (task-N-<agent>-session.txt) written by dispatch.
if [ "$task" = "all" ]; then
  pattern='task-*session.txt'
else
  pattern="task-${task}-*session.txt"
fi

while IFS= read -r -d '' f; do
  sid=$(cat "$f" 2>/dev/null || true)
  if [ -n "$sid" ]; then
    "$OPENCODE_BIN" session delete "$sid" >/dev/null 2>&1 || true
  fi
  rm -f "$f"
done < <(find "$ws" -maxdepth 1 -type f -name "$pattern" -print0 2>/dev/null)

exit 0
