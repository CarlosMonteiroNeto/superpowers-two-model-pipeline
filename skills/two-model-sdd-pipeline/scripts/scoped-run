#!/usr/bin/env bash
# The only worker entrypoint for RED/test/analyze/format. It accepts declared
# modes and test paths, never an arbitrary command string.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PYTHON_BIN="${PYTHON_BIN:-python3}"
exec "$PYTHON_BIN" "$SCRIPT_DIR/scoped_runner.py" "$@"
