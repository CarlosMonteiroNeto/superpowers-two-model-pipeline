#!/usr/bin/env python3
"""Plan-derived wave scheduler (no LLM).

Reads plan.json + the merged ledger and emits the next wave: the ready tasks
(all depends_on done, not done, no open episode) whose declared `touches` are
pairwise disjoint, capped at MAX_PARALLEL. Corrective/pending-episode tasks are
emitted alone. In-flight episodes are only visible once `integrate` folds their
shard into the global ledger - during a wave the review_outcome lives in the
task's worktree shard, so the "runs alone" rule applies to episodes from
previous waves (task-run owns its own episode inside the worktree).

Usage: wave-next WORKSPACE [MAX_PARALLEL]
Exit codes: 0 = wave emitted (one `RUN <id>` per line) or FINAL_REVIEW,
            1 = nothing runnable while tasks remain (WAVE_EMPTY), 2 = usage.

Resource profile: dispatch none; stdout is Script-CEO-facing (RUN lines) plus
stderr deferral reasons; ledger I/O reads the global ledger once into a
per-task index; one Python pass, no subprocess; git none.
"""

import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def load_ledger(path):
    entries = []
    if os.path.isfile(path):
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    entries.append(json.loads(line))
                except ValueError:
                    pass
    return entries


def task_of(entry):
    return entry.get("task")


def touches_of(task):
    return set(task.get("touches") or [])


def conflicts(selected, candidate):
    """Declared-touches overlap between a candidate and the chosen wave.

    A local set intersection (the same contract as the standalone
    `touches-overlap` CLI, which stays the single definition of the rule and
    keeps its exit-code contract for other callers).
    """
    claimed = set()
    for t in selected:
        claimed |= touches_of(t)
    return sorted(claimed & touches_of(candidate))


def main():
    if len(sys.argv) not in (2, 3):
        print("usage: wave-next WORKSPACE [MAX_PARALLEL]", file=sys.stderr)
        return 2
    ws = sys.argv[1]
    try:
        cap = int(sys.argv[2]) if len(sys.argv) == 3 else 2
    except ValueError:
        return 2
    plan_path = os.path.join(ws, "plan.json")
    if not os.path.isfile(plan_path) or cap < 1:
        return 2
    with open(plan_path, encoding="utf-8", errors="replace") as fh:
        tasks = json.load(fh).get("tasks", [])
    ledger = load_ledger(os.path.join(ws, "ledger.jsonl"))

    # One pass over the ledger into per-task event lists (the previous shape
    # walked the whole ledger once per task - O(tasks x lines)).
    by_task = {}
    for e in ledger:
        by_task.setdefault(str(task_of(e)), []).append(e)

    done_events = ("task_complete", "integrated")
    state = {}      # id -> "done" | "failed" | None
    episode = {}    # id -> True if newest review_outcome is SEND_BACK/ESCALATE
    for t in tasks:
        tid = str(t.get("id"))
        last = None
        for e in by_task.get(tid, ()):
            if e.get("type") in done_events or e.get("type") == "integration_failed":
                last = e.get("type")
            if e.get("type") == "review_outcome":
                verdict = e.get("summary")
                episode[tid] = verdict in ("SEND_BACK", "ESCALATE")
                if verdict == "APPROVED":
                    episode[tid] = False
            if e.get("type") == "arbitrate_resolved":
                episode[tid] = False
        state[tid] = "done" if last in done_events else ("failed" if last else None)

    if all(state.get(str(t.get("id"))) == "done" for t in tasks) and tasks:
        print("FINAL_REVIEW")
        return 0

    ready = []
    for t in tasks:
        tid = str(t.get("id"))
        if state.get(tid) == "done":
            continue
        deps = [str(d) for d in (t.get("depends_on") or [])]
        if any(state.get(d) != "done" for d in deps):
            continue
        ready.append(t)

    if not ready:
        print("WAVE_EMPTY: nothing runnable (blocked)", file=sys.stderr)
        return 1

    # Corrective work and open episodes run alone, lowest id first.
    special = [t for t in ready if t.get("corrects") or episode.get(str(t.get("id")))]
    if special:
        print("RUN {}".format(min(int(t["id"]) for t in special)))
        return 0

    # Fewest-touches-first: a wide-touching low-id task selected first becomes a
    # wall for every later candidate that shares any file with it. The
    # disjointness check is inlined (a set intersection); touches-overlap stays
    # the standalone CLI so its exit-code contract and tests are intact.
    selected = []
    for t in sorted(ready, key=lambda x: (len(touches_of(x)), int(x["id"]))):
        if len(selected) >= cap:
            break
        clash = conflicts(selected, t)
        if clash:
            print(
                "WAVE-DEFER: task {} deferred - shares {} with the wave".format(
                    t["id"], ", ".join(clash)),
                file=sys.stderr,
            )
            continue
        selected.append(t)
    for t in selected:
        print("RUN {}".format(t["id"]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
