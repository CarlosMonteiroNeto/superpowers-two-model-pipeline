#!/usr/bin/env python3
"""Deterministic KEEP/DISCARD gate for partial work (scope gate).

Decides the fate of the Coder's partial work with exit codes, reserving
approach-soundness judgment for Agente diretor when the gate says DISCARD.

Mechanical DISCARD triggers (first match wins):
  1. No partial work since HEAD (empty diff, nothing staged, no untracked).
  2. Any changed file outside this task's `touches` (plan.json), EXCEPT:
     - a test file that is newly authored (not present in HEAD); a modified
       committed test file is tampering and stays a violation;
     - a code-generated file (`.freezed.dart`, `.g.dart`, `.gr.dart`,
       `.gen.dart`, `.mocks.dart`): build output, not authored scope, and a
       whole-project generator run rewrites every drifted generated file;
     - the tracked plan (`docs/superpowers/plans/*.json`): pipeline state the
       diretor edits during arbitration, never a task's authored scope.

The test exemption shares `is_test_path` with brief-scaffold: tests are
defined as `changed - touches`, so every honest task writes files outside
`touches`. Without the exemption the gate would DISCARD every task (H3).
The generated/plan exemptions share `is_generated_path` with the same module
(C3).

Usage: keep-discard WORKSPACE TASK     (run from the repository root)
Exit codes: 0 = KEEP, 1 = DISCARD (out of scope / tampered), 2 = usage /
            missing artifacts, 3 = DISCARD (no partial work since HEAD).
"""

import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pathclass import is_generated_path, is_test_path  # noqa: E402


def is_plan_path(path):
    """The tracked plan file(s): pipeline state, not task scope."""
    return path.startswith("docs/superpowers/plans/") and path.endswith(".json")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout


def in_head(path):
    """True when `path` is tracked in HEAD (a modified committed file)."""
    rc = subprocess.run(
        ["git", "cat-file", "-e", "HEAD:" + path],
        capture_output=True,
    ).returncode
    return rc == 0


def main():
    if len(sys.argv) != 3:
        print("usage: keep-discard WORKSPACE TASK", file=sys.stderr)
        return 2
    ws, task = sys.argv[1], sys.argv[2]
    brief = os.path.join(ws, "task-{}-brief.md".format(task))
    plan = os.path.join(ws, "plan.json")
    if not os.path.isfile(brief):
        print("KEEP-DISCARD: no brief at {}".format(brief), file=sys.stderr)
        return 2
    if not os.path.isfile(plan):
        print("KEEP-DISCARD: no plan.json at {}".format(plan), file=sys.stderr)
        return 2
    if not git("rev-parse", "--is-inside-work-tree").strip() == "true":
        print("KEEP-DISCARD: not a git work tree (run from the repo root)", file=sys.stderr)
        return 2

    with open(plan, "r", encoding="utf-8", errors="replace") as fh:
        plan_data = json.load(fh)
    touches = set()
    for t in plan_data.get("tasks", []):
        if str(t.get("id")) == str(task):
            touches = set(t.get("touches", []))
            break

    changed = set()
    changed |= set(git("diff", "--name-only", "HEAD").splitlines())
    changed |= set(git("diff", "--cached", "--name-only").splitlines())
    changed |= set(git("ls-files", "--others", "--exclude-standard").splitlines())
    changed = {c for c in changed if c}

    if not changed:
        print("KEEP-DISCARD: DISCARD - no partial work since HEAD", file=sys.stderr)
        return 3

    out_of_scope = []
    for c in sorted(changed):
        if c in touches:
            continue
        # A newly authored test file is expected (tests are changed - touches);
        # a modified committed test file is tampering, not authoring.
        if is_test_path(c) and not in_head(c):
            continue
        # Build output (codegen): derived, not authored scope (C3).
        if is_generated_path(c):
            continue
        # The tracked plan: pipeline state the diretor edits (C3).
        if is_plan_path(c):
            continue
        out_of_scope.append(c)
    if out_of_scope:
        print(
            "KEEP-DISCARD: DISCARD - out of scope: {}".format(", ".join(out_of_scope)),
            file=sys.stderr,
        )
        return 1

    print("KEEP-DISCARD: KEEP - partial work is in scope")
    return 0


if __name__ == "__main__":
    sys.exit(main())
