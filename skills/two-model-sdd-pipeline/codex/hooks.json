{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CODEX_SKILL_ROOT}/scripts/codex-policy\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CODEX_SKILL_ROOT}/scripts/codex-policy\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
