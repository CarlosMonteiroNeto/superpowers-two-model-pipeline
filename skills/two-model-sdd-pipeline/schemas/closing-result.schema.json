{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Director closing result",
  "type": "object",
  "required": ["verdict", "summary", "findings", "parked_minors", "proposed_tasks"],
  "properties": {
    "verdict": {"enum": ["APPROVED", "REOPEN", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array"},
    "parked_minors": {"type": "array"},
    "proposed_tasks": {"type": "array"}
  },
  "additionalProperties": false
}
