{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/asset.schema.json",
  "title": "Reusable asset evidence record",
  "type": "object",
  "required": ["ecosystem", "name", "version", "source", "license", "evidence_hash", "compatibility", "evidence"],
  "properties": {
    "ecosystem": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "license": { "$ref": "#/$defs/license" },
    "evidence_hash": { "type": "string", "minLength": 1 },
    "compatibility": { "type": "object" },
    "evidence": { "type": "object" },
    "derived": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "license": {
      "type": "object",
      "required": ["status", "value"],
      "properties": {
        "status": { "enum": ["known", "unknown"] },
        "value": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
