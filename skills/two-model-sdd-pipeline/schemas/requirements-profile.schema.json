{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/requirements-profile.schema.json",
  "title": "Applicable product requirement profile",
  "type": "object",
  "required": ["profile_id", "version", "applicability", "requirements"],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "applicability": { "type": "object", "additionalProperties": { "oneOf": [ { "type": ["string", "number", "boolean", "null"] }, { "type": "object", "properties": { "equals": {}, "in": { "type": "array" } }, "minProperties": 1, "additionalProperties": false } ] } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
  },
  "additionalProperties": false,
  "$defs": { "requirement": { "type": "object", "required": ["id", "description", "checks", "dependencies"], "properties": { "id": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } }
}
