{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit candidate-bound baseline failure waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["approved_by", "approval_record", "candidate_commit", "source_hash", "environment_hash", "command_hash", "baseline_source_hash", "failures"],
  "properties": {
    "approved_by": {"const": "user"},
    "approval_record": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suite", "test", "signature"],
        "properties": {
          "suite": {"type": "string", "minLength": 1, "not": {"const": "*"}},
          "test": {"type": "string", "minLength": 1, "not": {"const": "*"}},
          "signature": {"type": "string", "minLength": 1, "not": {"const": "*"}}
        }
      }
    }
  }
}
