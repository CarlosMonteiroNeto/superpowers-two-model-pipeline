{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superpowers.local/schemas/test-impact.schema.json",
  "title": "Evidence-bound test impact selection",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "scope_paths",
    "tests",
    "commands",
    "reasons",
    "reasons_detail",
    "gaps",
    "identity",
    "evidence",
    "selection_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["affected", "full_suite", "mixed"] },
    "scope_paths": { "$ref": "#/$defs/pathList" },
    "tests": { "$ref": "#/$defs/pathList" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["toolchain_id", "language", "full_suite", "tests", "argv", "cwd", "env"],
        "properties": {
          "toolchain_id": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "full_suite": { "type": "boolean" },
          "tests": { "$ref": "#/$defs/pathList" },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cwd": { "type": "string", "minLength": 1 },
          "env": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "reasons_detail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["toolchain_id", "path", "reason"],
        "properties": {
          "toolchain_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "gaps": { "$ref": "#/$defs/pathList" },
    "identity": {
      "type": "object",
      "required": ["base_commit", "head_commit", "base_tree_hash", "tree_hash", "config_hash", "environment_hash", "policy_version"],
      "properties": {
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "head_commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "base_tree_hash": { "type": "string", "pattern": "^(?:[0-9a-f]{64}|tree:sha256:[0-9a-f]{64}|commit:[0-9a-f]{7,64}\\+sha256:[0-9a-f]{64})$" },
        "tree_hash": { "type": "string", "pattern": "^(?:[0-9a-f]{64}|tree:sha256:[0-9a-f]{64}|commit:[0-9a-f]{7,64}\\+sha256:[0-9a-f]{64})$" },
        "config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "environment_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["diff_hash", "graph_hash", "toolchains_hash", "policy_hash"],
      "properties": {
        "diff_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "toolchains_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "selection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
