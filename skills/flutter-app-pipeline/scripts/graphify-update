#!/usr/bin/env bash
# Deterministic graph rebuild before the task's commit (ADR-0004): rebuild the
# project graph just before the commit (green-gate / coder-gate chain) so the
# regenerated graph enters the task's own commit; the graphify-subgraph read
# runs immediately after. Never per Coder iteration - that is wasted overhead;
# the graph is consumed at brief time and review time, not mid-edit.
#
# Usage: graphify-update [ROOT]    (default: current directory)
# Exit codes: 0 = ok (or disabled), 2 = usage; graphify's exit code on failure.
set -euo pipefail

GRAPHIFY_BIN="${GRAPHIFY_BIN:-graphify}"

if [ $# -gt 1 ]; then
  echo "usage: graphify-update [ROOT]" >&2
  exit 2
fi

root="${1:-$(pwd)}"

if [ "${GRAPHIFY_ENABLED:-1}" != "0" ]; then
  if command -v "$GRAPHIFY_BIN" >/dev/null 2>&1; then
    "$GRAPHIFY_BIN" update "$root"
  else
    echo "GRAPHIFY-UPDATE: $GRAPHIFY_BIN not found; skipping (graph stays stale)" >&2
  fi
fi

exit 0