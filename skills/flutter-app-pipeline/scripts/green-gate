#!/usr/bin/env bash
# Deterministic green approval: full suite + analyze + format check, then commit.
# The gate's verdict is an exit code, never an LLM judgment.
#
# Usage: green-gate [--no-commit] [-m MESSAGE] [-l LEDGER] [-w WS] [-t TASK] [-b BASE]
#   --no-commit   validate only (Phase 4 / final review); never commits
#   -m MESSAGE    commit message (default "green")
#   -l LEDGER     optional JSONL ledger; appends a `commit` entry when committing
#   -w WS         pipeline workspace (for review package + reviewer dispatch)
#   -t TASK       task number (for reviewer dispatch paths)
#   -b BASE       base commit for the review package (default: HEAD~1)
#
# On all-green + commit, when -w/-t are given: builds the review package
# (implementation-only diff) and dispatches the revisor headlessly (Item 3).
# --no-commit short-circuits before the commit and the reviewer dispatch.
#
# Exit codes: 0 = all gates passed (and committed unless --no-commit),
#             1 = tests failed, 2 = analyze found issues, 4 = scope violation.
# Reports are written to ${GREEN_GATE_REPORT:-green-gate-report.txt}(.analyze).
# There is no format gate: formatting drift is auto-applied by coder-gate
# before this gate (B7), so a drift check here could never fire (M8).
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

FLUTTER_BIN="${FLUTTER_BIN:-flutter}"
GIT_BIN="${GIT_BIN:-git}"
REPORT="${GREEN_GATE_REPORT:-green-gate-report.txt}"
# M6: the RTK-compression invariant - every LLM-invoked command line runs
# through scripts/cmd (full output to the report file, compressed view on
# stdout, verdict always the raw command's exit code).
CMD_BIN="${CMD_BIN:-$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/cmd}"

no_commit=0
message="green"
ledger=""
ws=""
task=""
base=""

while [ $# -gt 0 ]; do
  case "$1" in
    --no-commit) no_commit=1 ;;
    -m|--message) message=${2:-}; shift ;;
    -l|--ledger) ledger=${2:-}; shift ;;
    -w|--workspace) ws=${2:-}; shift ;;
    -t|--task) task=${2:-}; shift ;;
    -b|--base) base=${2:-}; shift ;;
    *) echo "unexpected argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# 1. full test suite
if ! "$CMD_BIN" --full-file "$REPORT" -- "$FLUTTER_BIN" test; then
  echo "GREEN-GATE: tests FAILED (see $REPORT)" >&2
  exit 1
fi

# 2. static analysis
if ! "$CMD_BIN" --full-file "$REPORT.analyze" -- "$FLUTTER_BIN" analyze; then
  echo "GREEN-GATE: analyze found issues (see $REPORT.analyze)" >&2
  exit 2
fi

echo "GREEN-GATE: all gates passed"

if [ "$no_commit" = "1" ]; then
  echo "GREEN-GATE: --no-commit, not committing"
  exit 0
fi

# C2 scope gate (defence in depth; coder-gate already gates before calling
# here): never commit out-of-scope files. keep-discard exempts newly authored
# tests (H3). Skipped when the workspace/task/plan is not available so a
# standalone invocation is unaffected. Exit 4 = scope violation.
KEEP_DISCARD="$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/keep-discard"
if [ -n "$ws" ] && [ -n "$task" ] && [ -f "$ws/plan.json" ] && [ -x "$KEEP_DISCARD" ]; then
  set +e
  kd_out=$("$KEEP_DISCARD" "$ws" "$task" 2>&1)
  kd_rc=$?
  set -e
  if [ "$kd_rc" -eq 1 ]; then
    echo "GREEN-GATE: scope violation - refusing to commit" >&2
    printf '%s\n' "$kd_out" >&2
    exit 4
  fi
fi

"$GIT_BIN" add -A
if "$GIT_BIN" commit -m "$message" >/dev/null 2>&1; then
  sha=$("$GIT_BIN" rev-parse --short HEAD)
  # The tree this gate just validated. `integrate` compares it against the
  # merged tree to skip the post-merge suite when the merge is provably
  # tree-equivalent to this commit (ADR-0013).
  tree=$("$GIT_BIN" rev-parse 'HEAD^{tree}')
  echo "GREEN-GATE: committed $sha"
  if [ -n "$ledger" ]; then
    # Resolve ledger-append from the two-model scripts dir (the canonical
    # location), falling back to a workspace copy for legacy layouts. The
    # ledger file's own directory never contains the script, so the old
    # dirname() resolution silently dropped the `commit` entry and made
    # route-next loop the round.
    task_field="${task:--}"
    LEDGER_APPEND="$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/ledger-append"
    [ -x "$LEDGER_APPEND" ] || LEDGER_APPEND="$(dirname "$ledger")/ledger-append"
    if [ -x "$LEDGER_APPEND" ]; then
      "$LEDGER_APPEND" "$ledger" commit "$task_field" "green $sha" "commits=$sha" "tree=$tree"
      # H1: advisory interface guard after the commit (flutter path).
      if [ -n "$ws" ] && [ -n "$task" ]; then
        IC="$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/interface-check"
        if [ -x "$IC" ]; then
          ic_rc=0
          "$IC" "$ws" "$task" "${base:-HEAD~1}" >/dev/null 2>&1 || ic_rc=$?
          if [ "$ic_rc" -eq 1 ]; then
            "$LEDGER_APPEND" "$ledger" interface_touched "$task" \
              "diff touches an interface another task consumes" || true
          fi
        fi
      fi
    fi
  fi
else
  echo "GREEN-GATE: nothing to commit" >&2
fi

# Post-commit Script-A chain (ADR-0004, ADR-0001):
# 1. Build the review package for D (base..head, range-named file).
# 2. Dispatch the revisor headlessly (Item 3): tests + syntax are already
#    green, so D reviews design/architecture only (Item 2).
if [ -n "$ws" ] && [ -n "$task" ]; then
  base=${base:-HEAD~1}
  pkg="$ws/task-$task-review-package.diff"
  # The review package is required evidence for the mandatory reviewer.
  # Remove any previous artifact so a failed reconstruction cannot dispatch a
  # reviewer against stale contents. The package script itself handles an
  # optional guidance-hook failure by retaining standard guidance.
  REVIEW_PACKAGE_BIN="${REVIEW_PACKAGE_BIN:-$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/review-package}"
  rm -f "$pkg"
  "$REVIEW_PACKAGE_BIN" "$ws" "$base" HEAD "$pkg" "$task"
  [ -s "$pkg" ] || {
    echo "GREEN-GATE: review package missing after construction - refusing reviewer dispatch" >&2
    exit 1
  }

  DISPATCH_BIN="${DISPATCH_BIN:-$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/dispatch}"
  "$DISPATCH_BIN" --agent two-model-reviewer --task "$task" \
    --prompt-file "$pkg" --log "$ws/task-$task-reviewer.log" || true
fi

exit 0
