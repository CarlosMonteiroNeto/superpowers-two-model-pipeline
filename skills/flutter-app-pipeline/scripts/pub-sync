#!/usr/bin/env bash
# Deterministic dependency download + lockfile resolution. No LLM.
#
# Usage: pub-sync [PACKAGE ...]
#   with packages -> `flutter pub add <pkg>` (downloads what Phase 2 decided)
#   without        -> `flutter pub get` (resolves + writes pubspec.lock)
# Then verifies future resolution via `flutter pub upgrade --dry-run`.
#
# Exit codes: 0 = resolved, lockfile consistent; 1 = version conflicts
# (report written to ${PUB_SYNC_REPORT:-pub-sync-report.txt}).
set -euo pipefail

FLUTTER_BIN="${FLUTTER_BIN:-flutter}"
REPORT="${PUB_SYNC_REPORT:-pub-sync-report.txt}"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# Manifest mutations share the same exclusive resource-lock implementation as
# the generic dependency protocol. Re-entry carries the lock only for this
# process tree; it does not add analysis, model calls, or graph work.
if [ "${PIPELINE_DEPENDENCY_LOCK_HELD:-0}" != "1" ]; then
  SHARED_SCRIPTS=$(cd "$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts" && pwd)
  REPOSITORY_ID=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  BRANCH=$(git branch --show-current 2>/dev/null || true)
  BRANCH="${BRANCH:-detached}"
  LOCK_PATH="$REPOSITORY_ID/.codex/dependency-manifest.lock"
  exec "${PYTHON:-python3}" "$SHARED_SCRIPTS/dependency_policy.py" \
    --lock "$LOCK_PATH" --repository-id "$REPOSITORY_ID" --branch "$BRANCH" \
    --run-id "pub-sync-$$" -- "$0" "$@"
fi

if [ $# -gt 0 ]; then
  "$FLUTTER_BIN" pub add "$@"
else
  "$FLUTTER_BIN" pub get
fi

if ! "$FLUTTER_BIN" pub upgrade --dry-run > "$REPORT" 2>&1; then
  echo "PUB-SYNC: version resolution conflicts (see $REPORT)" >&2
  exit 1
fi

echo "PUB-SYNC: dependencies resolved, lockfile consistent"
exit 0
