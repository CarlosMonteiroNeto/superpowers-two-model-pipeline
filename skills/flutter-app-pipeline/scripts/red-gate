#!/usr/bin/env bash
# Flutter red-gate is now a thin shim (H4): the language-agnostic
# two-model-sdd-pipeline/scripts/red-gate owns the logic - verify the brief,
# dispatch the operador variant for the ledger's lang, ledger an interrupted
# dispatch, then chain coder-gate. The Flutter file had drifted on exactly the
# error handling the generic one fixed; a second copy is how that happened, so
# exec the single implementation instead.
#
# Usage: red-gate WORKSPACE TASK [TEST_CMD]   (forwards to the generic gate)
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
exec "$SCRIPT_DIR/../../two-model-sdd-pipeline/scripts/red-gate" "$@"
