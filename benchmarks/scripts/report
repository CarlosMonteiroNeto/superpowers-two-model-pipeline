#!/usr/bin/env python3
"""CLI wrapper: emit the benchmark report for one run's workspace."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__))))

from bench_report import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
