# This file: keep LF so the rules are stable across checkouts.
.gitattributes text eol=lf

# Ensure shell scripts always have LF line endings
*.sh text eol=lf
skills/*/scripts/* text eol=lf
# Extensionless repo-root scripts (check-/install-/sync-superpowers) are bash
# too; without this attribute autocrlf checks them out CRLF and shellcheck
# fails the whole file with SC1017.
scripts/* text eol=lf
hooks/session-start text eol=lf

# Benchmark harness: extensionless bash scripts (run-benchmark, run-side) and
# the Dart fixture must stay LF, or shellcheck/bash break on a CRLF checkout.
benchmarks/run-benchmark text eol=lf
benchmarks/scripts/* text eol=lf
*.dart text eol=lf

# Ensure the polyglot wrapper keeps LF (it's parsed by both cmd and bash)
*.cmd text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary
