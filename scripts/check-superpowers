#!/usr/bin/env bash
# check-superpowers
#
# Inspection-only view of the vendored superpowers checkout. Delegates to
# sync-superpowers --check-only so both scripts share one inspected
# fast-forward-only contract and never diverge:
#
#   exit 0 = inspected (unchanged or behind; behind never updates here)
#   exit 1 = needs_user_merge (ahead, diverged, dirty, detached, remote mismatch)
#   exit 2 = invalid invocation / not installed
#   exit 3 = operational failure (failed inspection, fetch error)
#
# Usage: check-superpowers [VENDOR_DIR] [--json] [--check-only]
#   VENDOR_DIR defaults to ${SUPERPOWERS_DIR:-$HOME/.config/opencode/vendor/superpowers}.
#   --json prints a structured report (same shape as sync-superpowers).
#   --check-only is accepted for compatibility (this script never applies).
#   Set CHECK_SKIP_FETCH=1 to compare against the last fetched origin/main
#   without fetching.
#
# This script never mutates the checkout: no reset, clean, stash, rebase or
# merge of any kind. Git worktrees whose .git is a file are accepted.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SYNC_BIN="$SCRIPT_DIR/sync-superpowers"

VENDOR_DIR=""
JSON_FLAG=0
CHECK_ONLY_FLAG=0
APPLY_FLAG=0

usage() {
  echo "usage: check-superpowers [VENDOR_DIR] [--json] [--check-only]" >&2
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --json)
      JSON_FLAG=1
      shift
      ;;
    --check-only)
      CHECK_ONLY_FLAG=1
      shift
      ;;
    --apply)
      APPLY_FLAG=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      if [[ "$#" -eq 1 ]]; then
        if [[ -n "$VENDOR_DIR" ]]; then
          echo "CHECK-SUPERPOWERS: only one VENDOR_DIR is allowed" >&2
          exit 2
        fi
        VENDOR_DIR="$1"
        shift
      elif [[ "$#" -gt 1 ]]; then
        echo "CHECK-SUPERPOWERS: only one VENDOR_DIR is allowed" >&2
        exit 2
      fi
      ;;
    -*)
      echo "CHECK-SUPERPOWERS: unknown option: $1" >&2
      exit 2
      ;;
    *)
      if [[ -n "$VENDOR_DIR" ]]; then
        echo "CHECK-SUPERPOWERS: only one VENDOR_DIR is allowed" >&2
        exit 2
      fi
      VENDOR_DIR="$1"
      shift
      ;;
  esac
done

if [[ -z "$VENDOR_DIR" ]]; then
  VENDOR_DIR="${SUPERPOWERS_DIR:-$HOME/.config/opencode/vendor/superpowers}"
fi

# A node_modules/superpowers install is a different (npm) copy: the sync
# scripts cannot `git fetch` a tarball, and editing it changes nothing the
# plugin loads. Report it specifically instead of a misleading "not installed"
# so the user does not end up with two diverging trees.
NODE_MODULES_DIR="${SUPERPOWERS_NPM_DIR:-$HOME/.config/opencode/node_modules/superpowers}"
if ! git -C "$VENDOR_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  if [[ -d "$NODE_MODULES_DIR" ]]; then
    echo "CHECK-SUPERPOWERS: found an npm install at $NODE_MODULES_DIR, not a git checkout at $VENDOR_DIR" >&2
    echo "CHECK-SUPERPOWERS: the pipeline self-update needs a git checkout - run scripts/install-superpowers" >&2
    exit 2
  fi
fi

args=("$VENDOR_DIR" "--check-only")
if [[ "$JSON_FLAG" -eq 1 ]]; then
  args+=("--json")
fi
if [[ "$APPLY_FLAG" -eq 1 ]]; then
  args+=("--apply")
fi

exec bash "$SYNC_BIN" "${args[@]}"